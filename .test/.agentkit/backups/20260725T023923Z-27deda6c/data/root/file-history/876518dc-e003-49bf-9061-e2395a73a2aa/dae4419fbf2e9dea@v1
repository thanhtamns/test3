func TestExtractTenantFromJWT_ValidTenantID(t *testing.T) {
	// {"tenant_id":"my-tenant"} base64url-encoded
	token := "eyJhbGciOiJIUzI1NiJ9.eyJ0ZW5hbnRfaWQiOiJteS10ZW5hbnQifQ.sig"
	tid := extractTenantFromJWT(token)
	if tid != "my-tenant" {
		t.Fatalf("expected 'my-tenant', got '%s'", tid)
	}
}

func TestExtractTenantFromJWT_OrgIDFallback(t *testing.T) {
	// {"org_id":"org-123"} base64url-encoded
	token := "eyJhbGciOiJIUzI1NiJ9.eyJvcmdfaWQiOiJvcmctMTIzIn0.sig"
	tid := extractTenantFromJWT(token)
	if tid != "org-123" {
		t.Fatalf("expected 'org-123', got '%s'", tid)
	}
}

func TestExtractTenantFromJWT_TenantIDPriority(t *testing.T) {
	// {"tenant_id":"t1","org_id":"o1"} — tenant_id takes precedence
	token := "eyJhbGciOiJIUzI1NiJ9.eyJ0ZW5hbnRfaWQiOiJ0MSIsIm9yZ19pZCI6Im8xIn0.sig"
	tid := extractTenantFromJWT(token)
	if tid != "t1" {
		t.Fatalf("expected 't1', got '%s'", tid)
	}
}

func TestExtractTenantFromJWT_InvalidToken(t *testing.T) {
	cases := []string{
		"",
		"not-a-jwt",
		"one.two",
		"a.!!!invalid-base64!!!.c",
		"a.e30.c", // {} — no tenant_id or org_id
	}
	for _, tc := range cases {
		tid := extractTenantFromJWT(tc)
		if tid != "" {
			t.Errorf("token %q: expected empty, got '%s'", tc, tid)
		}
	}
}

func TestWithTenantAuth_BearerToken(t *testing.T) {
	var gotTenant string
	inner := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		gotTenant = tenantFromCtx(r)
		w.WriteHeader(200)
	})

	handler := withTenantAuth(inner)
	req := httptest.NewRequest("GET", "/test", nil)
	// {"tenant_id":"bearer-tenant"}
	req.Header.Set("Authorization", "Bearer eyJhbGciOiJIUzI1NiJ9.eyJ0ZW5hbnRfaWQiOiJiZWFyZXItdGVuYW50In0.sig")

	w := httptest.NewRecorder()
	handler.ServeHTTP(w, req)

	if gotTenant != "bearer-tenant" {
		t.Fatalf("expected 'bearer-tenant', got '%s'", gotTenant)
	}
}

