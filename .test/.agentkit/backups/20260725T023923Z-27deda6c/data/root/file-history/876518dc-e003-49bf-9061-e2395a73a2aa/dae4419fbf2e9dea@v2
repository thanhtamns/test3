func TestRateLimiter_AllowsBurst(t *testing.T) {
	rl := newRateLimiter()
	for i := 0; i < 100; i++ {
		if !rl.allow("tenant-1") {
			t.Fatalf("expected allow on request %d", i+1)
		}
	}
}

func TestRateLimiter_DeniesExcess(t *testing.T) {
	rl := newRateLimiter()
	for i := 0; i < 101; i++ {
		rl.allow("tenant-1")
	}
	if rl.allow("tenant-1") {
		t.Fatal("expected rate limit denial after exceeding capacity")
	}
}

func TestRateLimiter_TenantIsolation(t *testing.T) {
	rl := newRateLimiter()
	for i := 0; i < 101; i++ {
		rl.allow("tenant-1")
	}
	if !rl.allow("tenant-2") {
		t.Fatal("tenant-2 should not be rate limited")
	}
}

func TestCORS_PreflightResponse(t *testing.T) {
	store := newFakeStorage()
	router := newTestRouter(store)

	req := httptest.NewRequest("OPTIONS", "/v1/overview", nil)
	req.Header.Set("Origin", "http://localhost:3000")

	w := httptest.NewRecorder()
	router.ServeHTTP(w, req)

	if w.Code != http.StatusNoContent {
		t.Fatalf("expected 204, got %d", w.Code)
	}
	if w.Header().Get("Access-Control-Allow-Origin") != "http://localhost:3000" {
		t.Fatalf("missing CORS allow origin header")
	}
	if w.Header().Get("Access-Control-Allow-Methods") == "" {
		t.Fatal("missing CORS allow methods header")
	}
}

func TestCORS_DisallowedOrigin(t *testing.T) {
	store := newFakeStorage()
