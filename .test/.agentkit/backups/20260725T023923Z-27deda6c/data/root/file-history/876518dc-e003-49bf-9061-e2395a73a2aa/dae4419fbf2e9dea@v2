	os.Setenv("WORKOS_JWKS_URL", "https://example.com/.well-known/jwks.json")
	defer t_setAuthDisabled()

	inner := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		w.WriteHeader(200)
	})

	handler := withTenantAuth(inner)
	req := httptest.NewRequest("GET", "/test", nil)
	req.Header.Set("X-Tenant-ID", "should-not-work")

	w := httptest.NewRecorder()
	handler.ServeHTTP(w, req)

	if w.Code != http.StatusUnauthorized {
		t.Fatalf("expected 401 when JWKS URL is set (auth disabled should be ignored), got %d", w.Code)
	}
