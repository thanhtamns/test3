func newTestRouter(store Storage) http.Handler {
	logger := slog.New(slog.NewTextHandler(io.Discard, nil))
	return NewRouter(store, logger)
}

func makeBatch(events ...*pb.Event) *pb.EventBatch {
	return &pb.EventBatch{
		CliVersion: "0.1.0-test",
		MachineId:  "test-machine",
		Events:     events,
	}
}

func compressionEvent(id, cmd string, input, saved uint64) *pb.Event {
	return &pb.Event{
		Id:          id,
		TimestampMs: time.Now().UnixMilli(),
		SessionId:   "sess-1",
		ProjectDir:  "/home/user/project",
		Command:     cmd,
		Compression: &pb.CompressionEvent{
			InputTokens:  input,
			OutputTokens: input - saved,
			TokensSaved:  saved,
			FilterName:   "git-diff",
			LatencyMs:    1.2,
		},
	}
}

func dedupEvent(id, cmd string, saved uint64) *pb.Event {
	return &pb.Event{
		Id:          id,
		TimestampMs: time.Now().UnixMilli(),
		SessionId:   "sess-1",
		ProjectDir:  "/home/user/project",
		Command:     cmd,
		Dedup: &pb.DedupEvent{
			ContentHash: "abc123",
			CacheHit:    true,
			TokensSaved: saved,
			LatencyMs:   0.3,
		},
	}
}

func marshalGzip(batch *pb.EventBatch) ([]byte, error) {
	data, err := proto.Marshal(batch)
	if err != nil {
		return nil, err
	}
	var buf bytes.Buffer
	gz := gzip.NewWriter(&buf)
	if _, err := gz.Write(data); err != nil {
		return nil, err
	}
	if err := gz.Close(); err != nil {
		return nil, err
	}
	return buf.Bytes(), nil
}

func TestIngestEvents_GzipProtobuf(t *testing.T) {
	store := newFakeStorage()
	router := newTestRouter(store)

	batch := makeBatch(
		compressionEvent("e1", "git diff", 1000, 400),
		dedupEvent("e2", "cat README.md", 200),
	)

	body, err := marshalGzip(batch)
	if err != nil {
		t.Fatal(err)
	}

	req := httptest.NewRequest("POST", "/v1/events", bytes.NewReader(body))
	req.Header.Set("Content-Type", "application/x-protobuf")
	req.Header.Set("Content-Encoding", "gzip")
	req.Header.Set("X-Tenant-ID", "tenant-1")

	w := httptest.NewRecorder()
	router.ServeHTTP(w, req)

	if w.Code != http.StatusAccepted {
		t.Fatalf("expected 202, got %d: %s", w.Code, w.Body.String())
	}

	var resp map[string]any
	json.NewDecoder(w.Body).Decode(&resp)
	if accepted, _ := resp["accepted"].(float64); accepted != 2 {
		t.Fatalf("expected 2 accepted, got %v", resp["accepted"])
	}

	if store.eventCount() != 2 {
		t.Fatalf("expected 2 stored events, got %d", store.eventCount())
	}
}

