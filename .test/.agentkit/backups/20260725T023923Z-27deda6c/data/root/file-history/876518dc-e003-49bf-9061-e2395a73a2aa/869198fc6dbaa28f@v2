package api

import (
	"compress/gzip"
	"context"
	"encoding/json"
	"fmt"
	"io"
	"log/slog"
	"net/http"
	"time"

	"github.com/codeflow-dev/codeflow/cloud/internal/clickhouse"
	"google.golang.org/protobuf/proto"

	pb "github.com/codeflow-dev/codeflow/cloud/proto"
)

type EventPublisher interface {
	Publish(ctx context.Context, tenantID string, data []byte) error
}

type handler struct {
	store     Storage
	publisher EventPublisher
	hub       *wsHub
	logger    *slog.Logger
}

func (h *handler) handleIngestEvents(w http.ResponseWriter, r *http.Request) {
	tenantID := tenantFromCtx(r)

	var reader io.Reader = r.Body
	if r.Header.Get("Content-Encoding") == "gzip" {
		gz, err := gzip.NewReader(r.Body)
		if err != nil {
			http.Error(w, "invalid gzip", http.StatusBadRequest)
			return
		}
		defer gz.Close()
		reader = gz
	}

	body, err := io.ReadAll(io.LimitReader(reader, 10*1024*1024))
	if err != nil {
		http.Error(w, "read error", http.StatusBadRequest)
		return
	}

	var batch pb.EventBatch
	if err := proto.Unmarshal(body, &batch); err != nil {
		http.Error(w, fmt.Sprintf("invalid protobuf: %v", err), http.StatusBadRequest)
		return
	}

	if h.publisher != nil {
		protoData, err := proto.Marshal(&batch)
		if err != nil {
			http.Error(w, "marshal error", http.StatusInternalServerError)
			return
		}
		if err := h.publisher.Publish(r.Context(), tenantID, protoData); err != nil {
			h.logger.Error("nats publish failed", "error", err, "count", len(batch.Events))
			http.Error(w, "publish failed", http.StatusInternalServerError)
			return
		}
	} else {
		rows := batchToRows(tenantID, &batch)
		if err := h.store.InsertEvents(r.Context(), rows); err != nil {
			h.logger.Error("clickhouse insert failed", "error", err, "count", len(rows))
			http.Error(w, "insert failed", http.StatusInternalServerError)
			return
		}
	}

	h.logger.Info("events ingested",
		"tenant", tenantID,
		"count", len(batch.Events),
		"cli_version", batch.CliVersion,
		"via", func() string { if h.publisher != nil { return "nats" }; return "direct" }(),
	)

	if h.hub != nil {
		var saved uint64
		for _, ev := range batch.Events {
			if ev.Compression != nil {
				saved += ev.Compression.TokensSaved
			}
			if ev.Dedup != nil {
				saved += ev.Dedup.TokensSaved
			}
		}
		h.hub.Broadcast(tenantID, LiveMetrics{
			TokensSavedToday: saved,
			EventsToday:      uint64(len(batch.Events)),
			Timestamp:         time.Now().UnixMilli(),
		})
	}

	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(http.StatusAccepted)
	json.NewEncoder(w).Encode(map[string]any{
		"accepted": len(batch.Events),
	})
}

func batchToRows(tenantID string, batch *pb.EventBatch) []clickhouse.EventRow {
	rows := make([]clickhouse.EventRow, 0, len(batch.Events))
	for _, ev := range batch.Events {
		row := clickhouse.EventRow{
			EventID:    ev.Id,
			TenantID:   tenantID,
			Timestamp:  time.UnixMilli(ev.TimestampMs),
			SessionID:  ev.SessionId,
			ProjectDir: ev.ProjectDir,
			Command:    ev.Command,
			CLIVersion: batch.CliVersion,
			MachineID:  batch.MachineId,
		}
		var compressionSaved, dedupSaved uint64
		if ev.Compression != nil {
			row.InputBytes = ev.Compression.InputBytes
			row.OutputBytes = ev.Compression.OutputBytes
			row.InputTokens = ev.Compression.InputTokens
			row.OutputTokens = ev.Compression.OutputTokens
			row.FilterName = ev.Compression.FilterName
			row.CompressionLevel = ev.Compression.CompressionLevel
			compressionSaved = ev.Compression.TokensSaved
			row.LatencyMs = ev.Compression.LatencyMs
		}
		if ev.Dedup != nil {
			row.ContentHash = ev.Dedup.ContentHash
			row.CacheHit = ev.Dedup.CacheHit
			dedupSaved = ev.Dedup.TokensSaved
			if ev.Dedup.LatencyMs > row.LatencyMs {
				row.LatencyMs = ev.Dedup.LatencyMs
			}
		}
		row.TokensSaved = compressionSaved + dedupSaved
		switch {
		case compressionSaved > 0 && dedupSaved > 0:
			if dedupSaved >= compressionSaved {
				row.EventType = "dedup"
			} else {
				row.EventType = "compression"
			}
		case dedupSaved > 0:
			row.EventType = "dedup"
		case compressionSaved > 0:
			row.EventType = "compression"
		default:
			row.EventType = "unspecified"
		}
		rows = append(rows, row)
	}
	return rows
}

func (h *handler) handleOverview(w http.ResponseWriter, r *http.Request) {
	tenantID := tenantFromCtx(r)

	stats, err := h.store.GetOverview(r.Context(), tenantID)
	if err != nil {
		h.logger.Error("overview query failed", "error", err)
		http.Error(w, "query failed", http.StatusInternalServerError)
		return
	}

	w.Header().Set("Content-Type", "application/json")
	json.NewEncoder(w).Encode(stats)
}

