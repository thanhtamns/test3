use anyhow::Result;
use rusqlite::{params, Connection};
use serde::Serialize;
use std::path::Path;
use std::time::{SystemTime, UNIX_EPOCH};

const RETENTION_DAYS: i64 = 90;

pub struct TrackingDb {
    conn: Connection,
}

#[derive(Debug, Clone, Copy, Serialize)]
pub enum SavingsLayer {
    Compression,
    Dedup,
}

impl SavingsLayer {
    fn as_str(&self) -> &'static str {
        match self {
            SavingsLayer::Compression => "compression",
            SavingsLayer::Dedup => "dedup",
        }
    }
}

#[derive(Debug, Clone, Serialize)]
pub struct TrackingEvent {
    pub command: String,
    pub input_tokens: u64,
    pub output_tokens: u64,
    pub tokens_saved: u64,
    pub layer: SavingsLayer,
    pub project: String,
    pub session_id: String,
}

#[derive(Debug, Clone, Serialize)]
pub struct Stats {
    pub total_input_tokens: u64,
    pub total_output_tokens: u64,
    pub total_saved: u64,
    pub savings_pct: f64,
    pub event_count: u64,
    pub top_commands: Vec<CommandStats>,
    pub by_layer: LayerStats,
}

#[derive(Debug, Clone, Serialize)]
pub struct CommandStats {
    pub command: String,
    pub saved: u64,
    pub count: u64,
}

#[derive(Debug, Clone, Serialize)]
pub struct LayerStats {
    pub compression_saved: u64,
    pub dedup_saved: u64,
}

impl TrackingDb {
    pub fn open(db_path: &Path) -> Result<Self> {
        let conn = Connection::open(db_path)?;
        conn.execute_batch(
            "PRAGMA journal_mode=WAL;
             PRAGMA synchronous=NORMAL;
             PRAGMA busy_timeout=5000;"
        )?;
        conn.execute_batch(
            "CREATE TABLE IF NOT EXISTS tracking_events (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                timestamp INTEGER NOT NULL,
                command TEXT NOT NULL,
                input_tokens INTEGER NOT NULL,
                output_tokens INTEGER NOT NULL,
                tokens_saved INTEGER NOT NULL,
                layer TEXT NOT NULL,
                project TEXT NOT NULL,
                session_id TEXT NOT NULL
            );"
        )?;
        conn.execute_batch(
            "CREATE INDEX IF NOT EXISTS idx_tracking_timestamp
             ON tracking_events(timestamp);"
        )?;
        Ok(Self { conn })
    }

    pub fn record(&self, event: &TrackingEvent) -> Result<()> {
        let now = now_secs();
        self.conn.execute(
            "INSERT INTO tracking_events
             (timestamp, command, input_tokens, output_tokens, tokens_saved,
              layer, project, session_id)
             VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7, ?8)",
            params![
                now as i64,
                event.command,
                event.input_tokens as i64,
                event.output_tokens as i64,
                event.tokens_saved as i64,
                event.layer.as_str(),
                event.project,
                event.session_id,
            ],
        )?;
        Ok(())
    }

    pub fn stats(&self, days: Option<i64>) -> Result<Stats> {
        let days = days.unwrap_or(RETENTION_DAYS);
        let cutoff = now_secs() as i64 - (days * 86400);

        let (total_input, total_output, total_saved, count): (i64, i64, i64, i64) = self
            .conn
            .query_row(
                "SELECT COALESCE(SUM(input_tokens),0), COALESCE(SUM(output_tokens),0),
                        COALESCE(SUM(tokens_saved),0), COUNT(*)
                 FROM tracking_events WHERE timestamp >= ?1",
                params![cutoff],
                |row| Ok((row.get(0)?, row.get(1)?, row.get(2)?, row.get(3)?)),
            )?;

        let savings_pct = if total_input > 0 {
            (total_saved as f64 / total_input as f64) * 100.0
        } else {
            0.0
        };

        let mut top_stmt = self.conn.prepare(
            "SELECT command, SUM(tokens_saved) as saved, COUNT(*) as cnt
             FROM tracking_events WHERE timestamp >= ?1
             GROUP BY command ORDER BY saved DESC LIMIT 10",
        )?;
        let top_commands: Vec<CommandStats> = top_stmt
            .query_map(params![cutoff], |row| {
                Ok(CommandStats {
                    command: row.get(0)?,
                    saved: row.get::<_, i64>(1)? as u64,
                    count: row.get::<_, i64>(2)? as u64,
                })
            })?
            .filter_map(|r| r.ok())
            .collect();

        let (comp_saved, dedup_saved): (i64, i64) = self.conn.query_row(
            "SELECT
                COALESCE(SUM(CASE WHEN layer='compression' THEN tokens_saved ELSE 0 END),0),
                COALESCE(SUM(CASE WHEN layer='dedup' THEN tokens_saved ELSE 0 END),0)
             FROM tracking_events WHERE timestamp >= ?1",
            params![cutoff],
            |row| Ok((row.get(0)?, row.get(1)?)),
        )?;

        Ok(Stats {
            total_input_tokens: total_input as u64,
            total_output_tokens: total_output as u64,
            total_saved: total_saved as u64,
            savings_pct,
            event_count: count as u64,
            top_commands,
            by_layer: LayerStats {
                compression_saved: comp_saved as u64,
                dedup_saved: dedup_saved as u64,
            },
        })
    }

    pub fn cleanup(&self) -> Result<u64> {
        let cutoff = now_secs() as i64 - (RETENTION_DAYS * 86400);
        let changes = self.conn.execute(
            "DELETE FROM tracking_events WHERE timestamp < ?1",
            params![cutoff],
        )?;
        Ok(changes as u64)
    }
}

fn now_secs() -> u64 {
    SystemTime::now()
        .duration_since(UNIX_EPOCH)
        .unwrap_or_default()
        .as_secs()
}

#[cfg(test)]
mod tests {
    use super::*;
    use tempfile::TempDir;

    fn setup() -> (TrackingDb, TempDir) {
        let dir = TempDir::new().unwrap();
        let db_path = dir.path().join("tracking.db");
        let db = TrackingDb::open(&db_path).unwrap();
        (db, dir)
    }

    fn make_event(cmd: &str, input: u64, saved: u64, layer: SavingsLayer) -> TrackingEvent {
        TrackingEvent {
            command: cmd.to_string(),
            input_tokens: input,
            output_tokens: input - saved,
            tokens_saved: saved,
            layer,
            project: "/test".to_string(),
            session_id: "sess-1".to_string(),
        }
    }

    #[test]
    fn test_record_and_stats() {
        let (db, _dir) = setup();
        db.record(&make_event("git status", 1000, 800, SavingsLayer::Compression))
            .unwrap();
        db.record(&make_event("git diff", 2000, 1500, SavingsLayer::Compression))
            .unwrap();
        db.record(&make_event("cat foo.rs", 500, 500, SavingsLayer::Dedup))
            .unwrap();

        let stats = db.stats(Some(1)).unwrap();
        assert_eq!(stats.event_count, 3);
        assert_eq!(stats.total_input_tokens, 3500);
        assert_eq!(stats.total_saved, 2800);
        assert!(stats.savings_pct > 79.0);
        assert_eq!(stats.by_layer.compression_saved, 2300);
        assert_eq!(stats.by_layer.dedup_saved, 500);
    }

    #[test]
    fn test_top_commands() {
        let (db, _dir) = setup();
        for _ in 0..5 {
            db.record(&make_event("git status", 100, 80, SavingsLayer::Compression))
                .unwrap();
        }
        db.record(&make_event("npm test", 500, 400, SavingsLayer::Compression))
            .unwrap();

        let stats = db.stats(Some(1)).unwrap();
        assert_eq!(stats.top_commands[0].command, "npm test");
        assert_eq!(stats.top_commands[0].saved, 400);
        assert_eq!(stats.top_commands[1].command, "git status");
        assert_eq!(stats.top_commands[1].count, 5);
    }

    #[test]
    fn test_empty_stats() {
        let (db, _dir) = setup();
        let stats = db.stats(Some(1)).unwrap();
        assert_eq!(stats.event_count, 0);
        assert_eq!(stats.savings_pct, 0.0);
    }

    #[test]
    fn test_stats_json_serializable() {
        let (db, _dir) = setup();
        db.record(&make_event("git status", 100, 80, SavingsLayer::Compression))
            .unwrap();
        let stats = db.stats(Some(1)).unwrap();
        let json = serde_json::to_string(&stats).unwrap();
        assert!(json.contains("git status"));
    }
}
