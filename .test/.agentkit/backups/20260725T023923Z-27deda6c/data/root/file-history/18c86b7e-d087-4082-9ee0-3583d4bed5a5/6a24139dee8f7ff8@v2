use anyhow::Result;
use codeflow_core::tracking::TrackingDb;

use crate::paths;

pub fn show(json: bool, days: Option<i64>) -> Result<()> {
    let db_path = paths::db_path();
    if !db_path.exists() {
        if json {
            println!("{{}}");
        } else {
            println!("No data yet. Run some commands with CODEFLOW hooks installed.");
            println!("  codeflow init    Install hooks");
            println!("  codeflow wrap    Manually compress a command");
        }
        return Ok(());
    }

    let tracking = TrackingDb::open(&db_path)?;
    let stats = tracking.stats(days)?;

    if json {
        println!("{}", serde_json::to_string_pretty(&stats)?);
        return Ok(());
    }

    println!("╔══════════════════════════════════════════════════╗");
    println!("║           CODEFLOW Token Savings                ║");
    println!("╠══════════════════════════════════════════════════╣");
    println!("║                                                  ║");
    println!(
        "║  Total saved:    {:>10} tokens ({:.1}%)        ║",
        format_number(stats.total_saved),
        stats.savings_pct
    );
    println!(
        "║  Input tokens:   {:>10}                    ║",
        format_number(stats.total_input_tokens)
    );
    println!(
        "║  Output tokens:  {:>10}                    ║",
        format_number(stats.total_output_tokens)
    );
    println!(
        "║  Events:         {:>10}                    ║",
        format_number(stats.event_count)
    );
    println!("║                                                  ║");
    println!("╠══════════════════════════════════════════════════╣");
    println!("║  By Layer                                        ║");
    println!(
        "║    Compression:  {:>10} tokens              ║",
        format_number(stats.by_layer.compression_saved)
    );
    println!(
        "║    Dedup:        {:>10} tokens              ║",
        format_number(stats.by_layer.dedup_saved)
    );
    println!("║                                                  ║");

    if !stats.top_commands.is_empty() {
        println!("╠══════════════════════════════════════════════════╣");
        println!("║  Top Commands                                    ║");
        for cmd in stats.top_commands.iter().take(5) {
            println!(
                "║    {:<20} {:>8} saved  ({:>4}x)   ║",
                truncate(&cmd.command, 20),
                format_number(cmd.saved),
                cmd.count
            );
        }
        println!("║                                                  ║");
    }

    println!("╚══════════════════════════════════════════════════╝");

    Ok(())
}

fn format_number(n: u64) -> String {
    if n >= 1_000_000 {
        format!("{:.1}M", n as f64 / 1_000_000.0)
    } else if n >= 1_000 {
        format!("{:.1}K", n as f64 / 1_000.0)
    } else {
        n.to_string()
    }
}

fn truncate(s: &str, max: usize) -> String {
    if s.chars().count() > max {
        let truncated: String = s.chars().take(max - 1).collect();
        format!("{}…", truncated)
    } else {
        s.to_string()
    }
}
