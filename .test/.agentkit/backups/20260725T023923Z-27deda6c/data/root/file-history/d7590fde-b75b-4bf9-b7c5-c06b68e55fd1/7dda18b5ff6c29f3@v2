class TestCapitalDeploymentClassifier(unittest.TestCase):

    def test_tier_0_default_track_is_micro_deploy(self):
        result = cpc.classify({"capital_usd": 500})
        self.assertEqual(result["track"], "MICRO_DEPLOY")

    def test_tier_0_has_deployment_budget(self):
        result = cpc.classify({"capital_usd": 500})
        self.assertEqual(result["deployment_budget"], 500)

    def test_tier_0_has_asset_slots(self):
        result = cpc.classify({"capital_usd": 500})
        self.assertGreaterEqual(result["asset_slots"], 3)

    def test_tier_0_has_per_slot_budget(self):
        result = cpc.classify({"capital_usd": 500})
        expected = 500 // result["asset_slots"]
        self.assertAlmostEqual(result["per_slot_budget"], expected, delta=1)

    def test_tier_0_sleep_test_required(self):
        result = cpc.classify({"capital_usd": 500})
        self.assertTrue(result["constraints"].get("sleep_test_required"))

    def test_tier_0_max_founder_hours(self):
        result = cpc.classify({"capital_usd": 500})
        self.assertLessEqual(result["constraints"]["max_founder_hours_post_setup"], 5)

    def test_tier_0_no_product_dev_removed(self):
        result = cpc.classify({"capital_usd": 500})
        self.assertNotIn("no_product_dev", result["constraints"])

    def test_tier_0_no_cash_first(self):
        result = cpc.classify({"capital_usd": 500})
        self.assertNotIn("cash_first", result["constraints"])

    def test_tier_0_default_leverage_is_micro_deploy(self):
        result = cpc.classify({"capital_usd": 500})
        self.assertEqual(result["track"], "MICRO_DEPLOY")
        self.assertEqual(result["leverage_access_score"], 0)

    def test_asset_builder_subtrack_exists(self):
        self.assertIn("ASSET_BUILDER", cpc.TIER_0_SUBTRACKS)
        self.assertEqual(cpc.TIER_0_SUBTRACKS["ASSET_BUILDER"]["leverage_range"], (4, 6))

    def test_tier_2_unchanged(self):
        result = cpc.classify({"capital_usd": 10000})
        self.assertEqual(result["track"], "PRODUCT")
        self.assertNotIn("deployment_budget", result)

    def test_track_alias_cashflow_seed(self):
        self.assertIn("CASHFLOW_SEED", cpc.TRACK_ALIASES)
        self.assertEqual(cpc.TRACK_ALIASES["CASHFLOW_SEED"], "MICRO_DEPLOY")

    def test_track_alias_service_entry(self):
        self.assertIn("SERVICE_ENTRY", cpc.TRACK_ALIASES)
        self.assertEqual(cpc.TRACK_ALIASES["SERVICE_ENTRY"], "MICRO_DEPLOY")

    def test_track_alias_leverage_entry(self):
        self.assertIn("LEVERAGE_ENTRY", cpc.TRACK_ALIASES)
        self.assertEqual(cpc.TRACK_ALIASES["LEVERAGE_ENTRY"], "ASSET_BUILDER")

    def test_tier_0_primary_hypothesis_deploy(self):
        result = cpc.classify({"capital_usd": 500})
        self.assertEqual(result["primary_hypothesis"], "deploy_micro_assets")


