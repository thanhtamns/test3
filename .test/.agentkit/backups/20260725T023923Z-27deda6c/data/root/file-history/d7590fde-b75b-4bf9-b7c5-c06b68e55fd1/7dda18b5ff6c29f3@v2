class TestCapitalDeploymentScoring(unittest.TestCase):

    def test_full_capital_deployment_scores_20(self):
        text = (
            "ROI: 40%/mo\n"
            "deploy_cost: $200\n"
            "Sleep test used as filter — only sleep-passing models included\n"
            "Portfolio: 5 micro-assets with 30-day kill criteria\n"
            "founder hours post-setup: <2h/week"
        )
        result = qs.check_capital_deployment(text)
        self.assertEqual(result["score"], 20)
        self.assertEqual(result["max"], 20)

    def test_zero_signals_scores_zero(self):
        text = "A plain sentence with no relevant patterns at all."
        result = qs.check_capital_deployment(text)
        self.assertEqual(result["score"], 0)

    def test_roi_present_scores_5(self):
        text = "ROI: 25%/mo on deployed capital."
        result = qs.check_capital_deployment(text)
        self.assertGreaterEqual(result["score"], 5)

    def test_deploy_cost_scores_5(self):
        text = "deploy_cost: $150 for this micro-asset."
        result = qs.check_capital_deployment(text)
        self.assertGreaterEqual(result["score"], 5)

    def test_labor_penalty_still_fires(self):
        text = "Q5-LEVERAGE: LABOR\nNo staircase path."
        result = qs.check_capital_deployment(text)
        self.assertIn("PENALTY", result["detail"])

    def test_dimension_key_is_capital_deployment(self):
        result = qs.score_verdict("minimal")
        self.assertIn("capital_deployment", result["dimensions"])
        self.assertNotIn("leverage_classification", result["dimensions"])

    def test_max_is_180(self):
        result = qs.score_verdict("minimal")
        self.assertIn("180", result["grade_map"])


class TestDeployCandidateVerdict(unittest.TestCase):

    def test_deploy_candidate_in_valid_verdicts(self):
        self.assertIn("DEPLOY_CANDIDATE", qs.VALID_VERDICTS)

    def test_all_original_verdicts_still_present(self):
        for v in ["KILL", "SIDE_HUSTLE", "SIDE_HUSTLE_WITH_STAIRCASE",
                   "MOUNTAIN_CANDIDATE", "INSUFFICIENT_SIGNAL"]:
            self.assertIn(v, qs.VALID_VERDICTS)

    def test_exploration_verdicts_present(self):
        for v in ["EXPLORATION_COMPLETE", "EXPLORATION_ONGOING"]:
            self.assertIn(v, qs.VALID_VERDICTS)


