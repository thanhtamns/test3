"""
test_leverage_scoring.py — Tests for leverage classification in stage0 quality scorer.

Validates:
- check_leverage_classification() dimension (sleep test, leverage class, asset ID, labor penalty)
- Grade thresholds updated for max=180
- SIDE_HUSTLE_WITH_STAIRCASE in valid verdicts
- Audit schema leverage group structure

Usage:
    pytest tests/stage0/test_leverage_scoring.py -v
"""

from __future__ import annotations

import json
import sys
import unittest
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent.parent
SCRIPTS_DIR = REPO_ROOT / ".claude" / "skills" / "business" / "transaction-layer" / "nui-hunter" / "scripts"
AUDIT_SCHEMA_PATH = REPO_ROOT / ".claude" / "hooks" / "lib" / "audit-schemas" / "stage0.json"

sys.path.insert(0, str(SCRIPTS_DIR))

from importlib import import_module

qs = import_module("stage0-quality-score")


class TestLeverageClassification(unittest.TestCase):

    def test_sleep_test_present_scores_5(self):
        text = "Q4-SLEEP: YES\nRevenue continues when founder does zero work."
        result = qs.check_leverage_classification(text)
        self.assertGreaterEqual(result["score"], 5)
        self.assertIn("sleep test present", result["detail"])

    def test_leverage_class_present_scores_5(self):
        text = "Q5-LEVERAGE: CODE\nNaval hierarchy classification."
        result = qs.check_leverage_classification(text)
        self.assertGreaterEqual(result["score"], 5)
        self.assertIn("leverage classification found", result["detail"])

    def test_asset_identification_scores_5(self):
        text = "Asset at M12: SaaS codebase with 500 paying subscribers."
        result = qs.check_leverage_classification(text)
        self.assertGreaterEqual(result["score"], 5)
        self.assertIn("asset identification present", result["detail"])

    def test_full_leverage_section_scores_15(self):
        text = (
            "Q4-SLEEP: YES\n"
            "Q5-LEVERAGE: CODE\n"
            "Asset at M12: SaaS platform with recurring revenue."
        )
        result = qs.check_leverage_classification(text)
        self.assertEqual(result["score"], 15)
        self.assertEqual(result["max"], 15)

    def test_labor_without_staircase_penalized(self):
        text = "Q5-LEVERAGE: LABOR\nCommission-based sourcing agent."
        result = qs.check_leverage_classification(text)
        self.assertEqual(result["score"], 0)
        self.assertIn("PENALTY", result["detail"])

    def test_labor_with_staircase_no_penalty(self):
        text = "leverage: LABOR model with stair-step transition path to SaaS product."
        result = qs.check_leverage_classification(text)
        self.assertNotIn("PENALTY", result["detail"])

    def test_bare_labor_word_no_false_penalty(self):
        text = "This CODE model requires minimal LABOR investment."
        result = qs.check_leverage_classification(text)
        self.assertNotIn("PENALTY", result["detail"])

    def test_hybrid_not_penalized(self):
        text = "Q5-LEVERAGE: HYBRID\nLabor phase with code transition."
        result = qs.check_leverage_classification(text)
        self.assertNotIn("PENALTY", result["detail"])

    def test_old_verdict_no_leverage_scores_zero(self):
        text = "Standard verdict without any leverage section. Q1=yes Q2=yes Q3=yes."
        result = qs.check_leverage_classification(text)
        self.assertEqual(result["score"], 0)

    def test_max_is_15(self):
        text = "Q4-SLEEP: YES\nQ5-LEVERAGE: CODE\nAsset at M12: codebase"
        result = qs.check_leverage_classification(text)
        self.assertEqual(result["max"], 15)


