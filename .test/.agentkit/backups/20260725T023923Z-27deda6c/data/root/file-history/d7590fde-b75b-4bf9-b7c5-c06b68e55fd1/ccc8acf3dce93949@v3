class TestAuditSchemaLeverage(unittest.TestCase):

    @classmethod
    def setUpClass(cls):
        with open(AUDIT_SCHEMA_PATH, encoding="utf-8") as f:
            cls.schema = json.load(f)

    def test_leverage_group_exists(self):
        self.assertIn("leverage", self.schema["dimensions"])

    def test_leverage_weight_015(self):
        self.assertAlmostEqual(self.schema["dimensions"]["leverage"]["weight"], 0.15)

    def test_weights_sum_to_one(self):
        total = sum(d["weight"] for d in self.schema["dimensions"].values())
        self.assertAlmostEqual(total, 1.0, places=2)

    def test_sleep_test_is_critical(self):
        checks = self.schema["dimensions"]["leverage"]["checks"]
        sleep = next(c for c in checks if c["id"] == "s0_sleep_test")
        self.assertEqual(sleep["severity"], "critical")

    def test_four_leverage_checks(self):
        checks = self.schema["dimensions"]["leverage"]["checks"]
        self.assertEqual(len(checks), 4)
        ids = {c["id"] for c in checks}
        self.assertEqual(ids, {"s0_sleep_test", "s0_leverage_class", "s0_asset_at_m12", "s0_labor_staircase"})


