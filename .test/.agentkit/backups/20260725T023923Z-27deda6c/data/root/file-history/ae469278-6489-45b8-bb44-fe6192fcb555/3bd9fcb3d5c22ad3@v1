from dataclasses import dataclass, field
from typing import Dict, List, Optional, Tuple


@dataclass
class OperatorPattern:
    """A pattern from a specific operator's playbook."""
    operator: str
    pattern_name: str
    core_insight: str
    mechanism: str
    application: str
    anti_pattern: str  # What most people do wrong
    relevance_score: float = 0.0


@dataclass
class OperatorMasteryOutput:
    """Output from operator mastery analysis."""
    patterns_applied: List[OperatorPattern]
    deep_insight: str
    inversion_check: str  # What would Munger say about avoiding failure?
    second_order_effects: List[str]
    operator_action: str  # What would this operator DO, not say


