"use client";

import { Button } from "@/components/ui/button";

const ranges = [
  { label: "7d", days: 7 },
  { label: "30d", days: 30 },
  { label: "90d", days: 90 },
];

export function DateRangeSelector({
  value,
  onChange,
}: {
  value: number;
  onChange: (days: number) => void;
}) {
  return (
    <div className="flex gap-1">
      {ranges.map((r) => (
        <Button
          key={r.days}
          variant={value === r.days ? "default" : "outline"}
          size="sm"
          onClick={() => onChange(r.days)}
        >
          {r.label}
        </Button>
      ))}
    </div>
  );
}
