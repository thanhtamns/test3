package api

import (
	"context"

	"github.com/codeflow-dev/codeflow/cloud/internal/clickhouse"
)

type Storage interface {
	InsertEvents(ctx context.Context, rows []clickhouse.EventRow) error
	GetOverview(ctx context.Context, tenantID string) (*clickhouse.OverviewStats, error)
	GetProjects(ctx context.Context, tenantID string) ([]clickhouse.ProjectSummary, error)
	GetProjectStats(ctx context.Context, tenantID, projectDir string) (*clickhouse.ProjectStats, error)
	GetSavingsTrend(ctx context.Context, tenantID string, days int) ([]clickhouse.DailySavings, error)
}
