package api

import (
	"encoding/json"
	"net/http"
	"strconv"

	"github.com/codeflow-dev/codeflow/cloud/internal/clickhouse"
)

func (h *handler) handleWasteReport(w http.ResponseWriter, r *http.Request) {
	tenantID := tenantFromCtx(r)

	days := 30
	if d := r.URL.Query().Get("days"); d != "" {
		if parsed, err := strconv.Atoi(d); err == nil && parsed > 0 && parsed <= 90 {
			days = parsed
		}
	}

	report, err := h.store.GetWasteReport(r.Context(), tenantID, days)
	if err != nil {
		h.logger.Error("waste report query failed", "error", err)
		http.Error(w, "query failed", http.StatusInternalServerError)
		return
	}
	if report == nil {
		report = []clickhouse.WasteReport{}
	}

	w.Header().Set("Content-Type", "application/json")
	json.NewEncoder(w).Encode(report)
}

