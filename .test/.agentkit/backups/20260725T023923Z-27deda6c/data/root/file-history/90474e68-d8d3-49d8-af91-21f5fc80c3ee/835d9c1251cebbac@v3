const API_URL = process.env.NEXT_PUBLIC_API_URL || "http://localhost:8080";
const TENANT_ID = process.env.NEXT_PUBLIC_TENANT_ID || "demo-tenant";

export interface OverviewStats {
  total_input_tokens: number;
  total_output_tokens: number;
  total_saved: number;
  savings_pct: number;
  event_count: number;
  top_commands: CommandStat[];
}

export interface CommandStat {
  command: string;
  saved: number;
  count: number;
}

export interface ProjectSummary {
  project_dir: string;
  total_saved: number;
  total_input: number;
  event_count: number;
  savings_pct: number;
  last_event_at: string;
}

export interface ProjectDailyStat {
  day: string;
  total_saved: number;
  total_input: number;
  event_count: number;
}

export interface ProjectStats {
  project_dir: string;
  summary: ProjectSummary;
  daily: ProjectDailyStat[];
  top_filters: CommandStat[];
}

export interface DailySavings {
  day: string;
  total_saved: number;
  total_input: number;
  event_count: number;
  compression_saved: number;
  dedup_saved: number;
}

async function apiFetch<T>(path: string): Promise<T> {
  const res = await fetch(`${API_URL}${path}`, {
    cache: "no-store",
    headers: {
      "X-Tenant-ID": TENANT_ID,
    },
  });
  if (!res.ok) {
    throw new Error(`API error: ${res.status}`);
  }
  return res.json();
}

export function fetchOverview(): Promise<OverviewStats> {
  return apiFetch("/v1/overview");
}

export function fetchProjects(): Promise<ProjectSummary[]> {
  return apiFetch("/v1/projects");
}

export function fetchProjectStats(projectDir: string): Promise<ProjectStats> {
  const normalized = projectDir.replaceAll("\\", "/");
  const encoded = normalized.replaceAll("/", "|");
  return apiFetch(`/v1/projects/${encodeURIComponent(encoded)}/stats`);
}

export function fetchSavingsTrend(days: number = 30): Promise<DailySavings[]> {
  return apiFetch(`/v1/savings/trend?days=${days}`);
}

export function formatTokens(n: number): string {
  if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(1)}M`;
  if (n >= 1_000) return `${(n / 1_000).toFixed(1)}K`;
  return n.toString();
}

export function estimateCost(tokens: number): string {
  const costPer1k = 0.003;
  const cost = (tokens / 1000) * costPer1k;
  if (cost < 0.01) return "<$0.01";
  return `$${cost.toFixed(2)}`;
}

export interface WasteReport {
  pattern_type: string;
  command: string;
  total_wasted: number;
  occurrences: number;
  session_count: number;
  suggestion: string;
}

export interface ProjectWasteScore {
  project_dir: string;
  total_wasted: number;
  total_input: number;
  waste_pct: number;
  pattern_count: number;
}

export function fetchWasteReport(days: number = 30): Promise<WasteReport[]> {
  return apiFetch(`/v1/waste?days=${days}`);
}

export function fetchProjectWasteScores(
  days: number = 30
): Promise<ProjectWasteScore[]> {
  return apiFetch(`/v1/waste/projects?days=${days}`);
}

export function shortProjectName(projectDir: string): string {
  const parts = projectDir.split(/[/\\]/).filter(Boolean);
  return parts.length > 0 ? parts[parts.length - 1] : projectDir;
}
