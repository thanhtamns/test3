func seedEvents(t *testing.T, router http.Handler, tenantID string, events ...*pb.Event) {
	t.Helper()
	batch := makeBatch(events...)
	data, _ := proto.Marshal(batch)

	req := httptest.NewRequest("POST", "/v1/events", bytes.NewReader(data))
	req.Header.Set("Content-Type", "application/x-protobuf")
	req.Header.Set("X-Tenant-ID", tenantID)

	w := httptest.NewRecorder()
	router.ServeHTTP(w, req)
	if w.Code != http.StatusAccepted {
		t.Fatalf("seed failed: %d %s", w.Code, w.Body.String())
	}
}

func TestOverview_Empty(t *testing.T) {
	store := newFakeStorage()
	router := newTestRouter(store)

	req := httptest.NewRequest("GET", "/v1/overview", nil)
	req.Header.Set("X-Tenant-ID", "tenant-1")

