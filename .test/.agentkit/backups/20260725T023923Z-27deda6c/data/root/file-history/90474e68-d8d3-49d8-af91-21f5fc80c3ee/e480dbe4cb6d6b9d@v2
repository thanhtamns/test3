func TestOverview_WithEvents(t *testing.T) {
	store := newFakeStorage()
	router := newTestRouter(store)

	seedEvents(t, router, "tenant-1",
		compressionEvent("e1", "git diff", 1000, 400),
		compressionEvent("e2", "cargo test", 2000, 800),
		dedupEvent("e3", "cat file", 300),
	)

	req := httptest.NewRequest("GET", "/v1/overview", nil)
	req.Header.Set("X-Tenant-ID", "tenant-1")

	w := httptest.NewRecorder()
	router.ServeHTTP(w, req)

	if w.Code != http.StatusOK {
		t.Fatalf("expected 200, got %d: %s", w.Code, w.Body.String())
	}

	var stats clickhouse.OverviewStats
	json.NewDecoder(w.Body).Decode(&stats)

	if stats.EventCount != 3 {
		t.Fatalf("expected 3 events, got %d", stats.EventCount)
	}
	if stats.TotalSaved != 1500 {
		t.Fatalf("expected 1500 saved, got %d", stats.TotalSaved)
	}
}

