func TestListProjects(t *testing.T) {
	store := newFakeStorage()
	router := newTestRouter(store)

	seedEvents(t, router, "tenant-1",
		compressionEvent("e1", "git diff", 1000, 400),
		compressionEvent("e2", "cargo test", 500, 100),
	)

	req := httptest.NewRequest("GET", "/v1/projects", nil)
	req.Header.Set("X-Tenant-ID", "tenant-1")

	w := httptest.NewRecorder()
	router.ServeHTTP(w, req)

	if w.Code != http.StatusOK {
		t.Fatalf("expected 200, got %d", w.Code)
	}

	var projects []clickhouse.ProjectSummary
	json.NewDecoder(w.Body).Decode(&projects)

	if len(projects) != 1 {
		t.Fatalf("expected 1 project, got %d", len(projects))
	}
	if projects[0].ProjectDir != "/home/user/project" {
		t.Fatalf("unexpected project dir: %s", projects[0].ProjectDir)
	}
	if projects[0].TotalSaved != 500 {
		t.Fatalf("expected 500 saved, got %d", projects[0].TotalSaved)
	}
}

func TestProjectStats(t *testing.T) {
	store := newFakeStorage()
	router := newTestRouter(store)

	seedEvents(t, router, "tenant-1",
		compressionEvent("e1", "git diff", 1000, 400),
	)

	// Project dir encoded: /home/user/project → |home|user|project
	req := httptest.NewRequest("GET", "/v1/projects/|home|user|project/stats", nil)
	req.Header.Set("X-Tenant-ID", "tenant-1")

	w := httptest.NewRecorder()
	router.ServeHTTP(w, req)

	if w.Code != http.StatusOK {
		t.Fatalf("expected 200, got %d: %s", w.Code, w.Body.String())
	}

	var ps clickhouse.ProjectStats
	json.NewDecoder(w.Body).Decode(&ps)

	if ps.Summary.TotalSaved != 400 {
		t.Fatalf("expected 400 saved, got %d", ps.Summary.TotalSaved)
	}
	if ps.Summary.EventCount != 1 {
		t.Fatalf("expected 1 event, got %d", ps.Summary.EventCount)
	}
}

func TestSavingsTrend_Default30Days(t *testing.T) {
	store := newFakeStorage()
	router := newTestRouter(store)

	seedEvents(t, router, "tenant-1",
		compressionEvent("e1", "git diff", 1000, 400),
		dedupEvent("e2", "cat file", 200),
	)

	req := httptest.NewRequest("GET", "/v1/savings/trend", nil)
	req.Header.Set("X-Tenant-ID", "tenant-1")

	w := httptest.NewRecorder()
	router.ServeHTTP(w, req)

	if w.Code != http.StatusOK {
		t.Fatalf("expected 200, got %d: %s", w.Code, w.Body.String())
	}

	var trend []clickhouse.DailySavings
	if err := json.NewDecoder(w.Body).Decode(&trend); err != nil {
		t.Fatalf("decode trend: %v", err)
	}
	if len(trend) != 1 {
		t.Fatalf("expected 1 day in trend, got %d", len(trend))
	}
	if trend[0].TotalSaved != 600 {
		t.Fatalf("expected 600 total saved, got %d", trend[0].TotalSaved)
	}
	if trend[0].Compression != 400 {
		t.Fatalf("expected 400 compression saved, got %d", trend[0].Compression)
	}
	if trend[0].Dedup != 200 {
		t.Fatalf("expected 200 dedup saved, got %d", trend[0].Dedup)
	}
}

