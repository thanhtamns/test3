class TestIndustryResolution:
    def test_explicit_industries(self):
        engine = ForcedFlowEngine(lambda q: "", lambda p: "{}", max_calls=30)
        inds = engine._resolve_industries(["fintech", "healthtech"], None)
        assert inds == ["fintech", "healthtech"]

    def test_founder_industries(self):
        founder = FounderProfile(industries=["coffee export"])
        engine = ForcedFlowEngine(lambda q: "", lambda p: "{}", max_calls=30)
        inds = engine._resolve_industries(None, founder)
        assert "coffee export" in inds

    def test_defaults_when_empty(self):
        engine = ForcedFlowEngine(lambda q: "", lambda p: "{}", max_calls=30)
        inds = engine._resolve_industries(None, None)
        assert len(inds) > 0

    def test_search_failure_handled(self):
        def failing(q):
            raise ConnectionError("down")
        engine = ForcedFlowEngine(failing, lambda p: "{}", max_calls=30)
        flows = engine.scan(geographies=["US"], industries=["tech"])
        assert flows == []


