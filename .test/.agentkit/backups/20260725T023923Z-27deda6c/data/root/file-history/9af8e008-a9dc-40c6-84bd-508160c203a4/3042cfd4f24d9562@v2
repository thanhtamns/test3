class TestBudgetEnforcement:
    def test_stops_at_budget(self):
        call_count = 0
        def counting_research(q):
            nonlocal call_count
            call_count += 1
            return "some regulation text"

        llm = _mock_llm({
            "": {"regulation": "Test Rule", "jurisdiction": "US",
                 "effective_date": "2026-12-01", "who_must_comply": "all",
                 "entity_count_estimate": 1000, "compliance_cost_per_entity": 5000,
                 "penalty": "fine", "summary": "test"},
            "compliance provider": {"providers": [], "gap": "none"},
        })
        engine = ForcedFlowEngine(counting_research, llm, max_calls=5)
        engine.scan(geographies=["US", "EU", "VN", "global"],
                    industries=["tech", "finance", "health"])
        assert engine.budget.calls_used <= 5


