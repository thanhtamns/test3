"""Tests for Brain 2: Forced Flow Engine."""

import json
import pytest
from ..forced_flow_engine import ForcedFlowEngine, DEFAULT_GEOGRAPHIES, DEFAULT_INDUSTRIES
from ..models import ForcedFlow, FounderProfile


def _mock_research(responses: dict):
    def fn(query: str) -> str:
        for key, val in responses.items():
            if key.lower() in query.lower():
                return val
        return ""
    return fn


def _mock_llm(mappings: dict):
    def fn(prompt: str) -> str:
        for key, val in mappings.items():
            if key.lower() in prompt.lower():
                return json.dumps(val)
        return json.dumps({"regulation": None})
    return fn


class TestMandateExtraction:
    def test_finds_regulation(self):
        research = _mock_research({
            "regulation": "EU AI Act Article 6 high-risk systems conformity assessment effective 2026-08-01"
        })
        llm = _mock_llm({
            "eu ai act": {
                "regulation": "EU AI Act Art.6",
                "jurisdiction": "EU",
                "effective_date": "2026-08-01",
                "who_must_comply": "AI deployers",
                "entity_count_estimate": 15000,
                "compliance_cost_per_entity": 50000,
                "penalty": "up to 35M EUR",
                "summary": "High-risk AI conformity assessment",
            },
            "compliance provider": {"providers": ["Deloitte", "PwC"], "gap": "no SME-focused providers"},
        })
        engine = ForcedFlowEngine(research, llm, max_calls=30)
        flows = engine.scan(geographies=["EU"], industries=["technology"])

        assert len(flows) >= 1
        f = flows[0]
        assert f.regulation == "EU AI Act Art.6"
        assert f.jurisdiction == "EU"
        assert f.entity_count == 15000
        assert f.total_forced_spend == pytest.approx(750_000_000)

    def test_no_regulation_found(self):
        research = _mock_research({"regulation": "no relevant regulatory text found"})
        llm = _mock_llm({"": {"regulation": None}})
        engine = ForcedFlowEngine(research, llm, max_calls=30)
        flows = engine.scan(geographies=["US"], industries=["technology"])
        assert len(flows) == 0


class TestUrgencyCalculation:
    def test_urgency_near_deadline(self):
        f = ForcedFlow(regulation="test", jurisdiction="EU",
                       effective_date="2026-08-01", who_must_comply="all",
                       deadline_urgency=30)
        score = f.urgency_score()
        assert score > 0.9

    def test_urgency_far_deadline(self):
        f = ForcedFlow(regulation="test", jurisdiction="EU",
                       effective_date="2028-01-01", who_must_comply="all",
                       deadline_urgency=350)
        score = f.urgency_score()
        assert score < 0.1

    def test_urgency_zero_days(self):
        f = ForcedFlow(regulation="test", jurisdiction="EU",
                       effective_date="2026-01-01", who_must_comply="all",
                       deadline_urgency=0)
        assert f.urgency_score() == 0.0


