        debate = PersonaDebate("test query", "custom", tr_output, technique_results=MOCK_TECHNIQUE_RESULTS)
        summary = debate._compress_technique_summary()
        assert "GO" in summary
        assert "GO=10" in summary

    def test_technique_summary_fallback(self):
        tr_output = {"dimension_scores": {}, "overall_score": 0.5}
        debate = PersonaDebate("test query", "custom", tr_output, technique_results=None)
        summary = debate._compress_technique_summary()
        assert "no technique data" in summary


