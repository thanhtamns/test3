class TestStrategicInsightLocalVerdict:
    def test_local_verdict_in_to_dict(self):
        insight = StrategicInsight(causal_chain="test")
        insight.local_verdict = {"verdict": "KILL", "score": 0.2, "confidence": 0.8}
        d = insight.to_dict()
        assert "local_verdict" in d
        assert d["local_verdict"]["verdict"] == "KILL"

    def test_local_verdict_absent_when_empty(self):
        insight = StrategicInsight(causal_chain="test")
        d = insight.to_dict()
        assert "local_verdict" not in d
