class TestTechniqueCompression:
    def test_compress_produces_consensus_line(self):
        compressed = StrategicReasoner._compress_technique_results(MOCK_TECHNIQUE_RESULTS)
        assert "GO" in compressed
        assert "GO=10" in compressed
        assert "KILL=2" in compressed

    def test_compress_includes_contrarian_signals(self):
        compressed = StrategicReasoner._compress_technique_results(MOCK_TECHNIQUE_RESULTS)
        assert "CONTRARIAN T03" in compressed

    def test_compress_includes_staircase_override(self):
        compressed = StrategicReasoner._compress_technique_results(MOCK_TECHNIQUE_RESULTS)
        assert "Staircase override" in compressed

    def test_compress_handles_empty(self):
        assert StrategicReasoner._compress_technique_results({}) == ""
        assert StrategicReasoner._compress_technique_results(None) == ""

    def test_compress_handles_error(self):
        assert StrategicReasoner._compress_technique_results({"error": "failed"}) == ""


class TestOutputFormatterTechnique:
    def _make_result(self, technique_results=None, strategic_insight=None):
        result = MagicMock()
        result.technique_results = technique_results
        result.strategic_insight = strategic_insight or {}
        result.overall_score = 0.65
        result.facts_used = 15
        result.facts_by_zone = {"K": 5, "T": 7, "?": 3}
        result.query = "test query"
        result.query_type = "custom"
        result.dimension_scores = {}
        result.gaps = []
        result.path = []
        result.llm_calls_made = 5
        return result

    def test_technique_section_renders(self):
        result = self._make_result(technique_results=MOCK_TECHNIQUE_RESULTS)
        formatter = OutputFormatter()
        output = formatter.format(result)
        assert "Multi-Dimensional Analysis" in output
        assert "GO" in output
        assert "T03_adversarial_debate" in output

    def test_technique_section_absent_when_empty(self):
        result = self._make_result(technique_results=None)
        formatter = OutputFormatter()
        output = formatter.format(result)
        assert "Multi-Dimensional Analysis" not in output

    def test_technique_section_absent_on_error(self):
        result = self._make_result(technique_results={"error": "test", "status": "failed"})
        formatter = OutputFormatter()
        output = formatter.format(result)
        assert "Multi-Dimensional Analysis" not in output

    def test_local_verdict_in_output(self):
        si = {"local_verdict": {"verdict": "WEAK_PASS", "score": 0.45, "confidence": 0.7}}
        result = self._make_result(technique_results=MOCK_TECHNIQUE_RESULTS, strategic_insight=si)
        formatter = OutputFormatter()
        output = formatter.format(result)
        assert "Local evidence verdict" in output
        assert "WEAK_PASS" in output


class TestPersonaDebateTechnique:
