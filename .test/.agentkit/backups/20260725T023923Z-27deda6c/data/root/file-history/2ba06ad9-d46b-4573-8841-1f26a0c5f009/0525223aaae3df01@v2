name: CI

on:
  push:
    branches: [main, master]
  pull_request:

jobs:
  cli:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: dtolnay/rust-toolchain@stable
        with:
          components: clippy

      - name: Install protoc
        uses: arduino/setup-protoc@v3
        with:
          version: "27.x"

      - name: Check
        working-directory: cli
        run: cargo check --locked

      - name: Clippy
        working-directory: cli
        run: cargo clippy --locked -- -D warnings

      - name: Test
        working-directory: cli
        run: cargo test --locked

  cloud:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-go@v5
        with:
          go-version: "1.25"

      - name: Build
        working-directory: cloud
        run: go build ./...

      - name: Vet
        working-directory: cloud
        run: go vet ./...

      - name: Test
        working-directory: cloud
        run: go test ./... -count=1

  dashboard:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: "22"

      - name: Install
        working-directory: dashboard
        run: npm ci

      - name: Lint
        working-directory: dashboard
        run: npx next lint

      - name: Type check
        working-directory: dashboard
        run: npx tsc --noEmit

      - name: Build
        working-directory: dashboard
        run: npx next build
        env:
          CODEFLOW_AUTH_DISABLED: "true"
          NEXT_PUBLIC_CODEFLOW_AUTH_DISABLED: "true"
