//! `rtk serve` — local HTTP server for the live codeflow dashboard (Phase 6).
//!
//! Usage:
//!   rtk serve             — start on port 3141
//!   rtk serve --port <N>  — custom port
//!
//! Single-threaded blocking server. Ctrl+C to stop.
//! On each GET / request the HTML dashboard is regenerated from current DB state.

use anyhow::{Context, Result};
use colored::Colorize;
use std::io::{BufRead, BufReader, Write};
use std::net::{TcpListener, TcpStream};

use crate::core::exporter::{export_html, load_export_data};

// ── Public args struct ────────────────────────────────────────────────────────

pub struct ServeArgs {
    pub port: u16,
}

impl Default for ServeArgs {
    fn default() -> Self {
        Self { port: 3141 }
    }
}

// ── Entry point ───────────────────────────────────────────────────────────────

pub fn run(args: &ServeArgs) -> Result<i32> {
    let addr = format!("127.0.0.1:{}", args.port);
    let listener = TcpListener::bind(&addr)
        .with_context(|| format!("failed to bind to {}", addr))?;

    println!("{}", "RTK Codeflow — Live Dashboard".bold());
    println!("{}", "─".repeat(50));
    println!(
        "  {}  {}",
        "Dashboard available at".dimmed(),
        format!("http://localhost:{}", args.port).cyan().bold()
    );
    println!("  {}", "Press Ctrl+C to stop.".dimmed());
    println!();

    for stream in listener.incoming() {
        match stream {
            Ok(s) => {
                if let Err(e) = handle_connection(s) {
                    eprintln!("[rtk serve] connection error: {:#}", e);
                }
            }
            Err(e) => {
                eprintln!("[rtk serve] accept error: {:#}", e);
            }
        }
    }

    Ok(0)
}

// ── HTTP request handler ──────────────────────────────────────────────────────

fn handle_connection(mut stream: TcpStream) -> Result<()> {
    stream
        .set_read_timeout(Some(std::time::Duration::from_secs(5)))
        .context("set read timeout")?;
    let buf_reader = BufReader::new(stream.try_clone().context("clone stream")?);

    // Read request line + headers (consume until blank line)
    let mut request_line = String::new();
    let mut lines = buf_reader.lines();
    if let Some(Ok(line)) = lines.next() {
        request_line = line;
    }
    // Drain headers
    for line in lines {
        match line {
            Ok(l) if l.is_empty() => break,
            Ok(_) => {}
            Err(_) => break,
        }
    }

    // Route: only serve GET /
    let path = parse_path(&request_line);
    let (status, content_type, body) = match path.as_deref() {
        Some("/") | Some("") => {
            let html = generate_dashboard().unwrap_or_else(|e| {
                format!(
                    "<!DOCTYPE html><html><body><pre>Error generating dashboard:\n{:#}</pre></body></html>",
                    e
                )
            });
            ("200 OK", "text/html; charset=utf-8", html)
        }
        Some("/health") => ("200 OK", "text/plain", "ok".to_string()),
        _ => (
            "404 Not Found",
            "text/plain",
            "Not found. Navigate to /".to_string(),
        ),
    };

    let response = format!(
        "HTTP/1.1 {}\r\nContent-Type: {}\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{}",
        status,
        content_type,
        body.len(),
        body
    );

    stream
        .write_all(response.as_bytes())
        .context("write response")?;

    Ok(())
}

fn parse_path(request_line: &str) -> Option<String> {
    // "GET /path HTTP/1.1"
    let mut parts = request_line.splitn(3, ' ');
    parts.next(); // method
    parts.next().map(|p| p.to_string())
}

fn generate_dashboard() -> Result<String> {
    let (records, costs, stats) =
        load_export_data(None, None).context("load export data")?;
    export_html(&records, &costs, &stats).context("render HTML")
}

// ── Tests ─────────────────────────────────────────────────────────────────────

#[cfg(test)]
mod tests {
    use super::*;

    // 1. Default port is 3141
    #[test]
    fn default_port_is_3141() {
        let args = ServeArgs::default();
        assert_eq!(args.port, 3141);
    }

    // 2. ServeArgs can be constructed with custom port
    #[test]
    fn custom_port_is_stored() {
        let args = ServeArgs { port: 8080 };
        assert_eq!(args.port, 8080);
    }

    // 3. parse_path extracts path from GET request line
    #[test]
    fn parse_path_extracts_root() {
        let path = parse_path("GET / HTTP/1.1");
        assert_eq!(path.as_deref(), Some("/"));
    }

    // 4. parse_path handles health endpoint
    #[test]
    fn parse_path_extracts_health() {
        let path = parse_path("GET /health HTTP/1.1");
        assert_eq!(path.as_deref(), Some("/health"));
    }

    // 5. parse_path handles unknown paths
    #[test]
    fn parse_path_unknown_route() {
        let path = parse_path("GET /unknown HTTP/1.1");
        assert_eq!(path.as_deref(), Some("/unknown"));
    }

    // 6. parse_path returns None for empty string
    #[test]
    fn parse_path_empty_request_line() {
        let path = parse_path("");
        assert!(path.is_none());
    }

    // 7. generate_dashboard succeeds with empty DBs
    #[test]
    fn generate_dashboard_empty_dbs_succeeds() {
        let tmp = tempfile::tempdir().unwrap();
        std::env::set_var(
            "RTK_PROVENANCE_DB",
            tmp.path().join("provenance.db").to_str().unwrap(),
        );
        std::env::set_var(
            "RTK_COST_DB",
            tmp.path().join("cost.db").to_str().unwrap(),
        );

        let result = generate_dashboard();

        std::env::remove_var("RTK_PROVENANCE_DB");
        std::env::remove_var("RTK_COST_DB");

        assert!(result.is_ok());
        let html = result.unwrap();
        assert!(html.contains("<!DOCTYPE html>"));
    }

    // 8. TcpListener can bind to an available port
    #[test]
    fn tcp_listener_binds_to_available_port() {
        // Bind to port 0 to get OS-assigned port — proves TcpListener works
        let listener = TcpListener::bind("127.0.0.1:0");
        assert!(listener.is_ok(), "should be able to bind a TCP listener");
    }

    // 9. ServeArgs addr format is correct
    #[test]
    fn addr_format_is_localhost_port() {
        let args = ServeArgs { port: 9999 };
        let addr = format!("127.0.0.1:{}", args.port);
        assert_eq!(addr, "127.0.0.1:9999");
    }
}
