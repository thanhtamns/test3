</html>"#,
        generated_at = chrono::Utc::now().format("%Y-%m-%d %H:%M UTC"),
        date_from = stats.date_range.0,
        date_to = stats.date_range.1,
        total_files = stats.total_files,
        total_cost_usd = stats.total_cost_usd,
        ai_pct = stats.ai_pct,
        top_model = html_escape(&stats.top_model),
        recent_rows = recent_rows,
        top_cost_rows = top_cost_rows,
        data_json = data_json,
    );

    Ok(html)
}

// ── Data builders ─────────────────────────────────────────────────────────────

fn build_data_json(
    provenance: &[ProvenanceRecord],
    costs: &[ModelCostSummary],
    stats: &ExportStats,
) -> Result<String> {
    // Aggregate cost by day from provenance timestamps
    let mut day_map: std::collections::BTreeMap<String, f64> = std::collections::BTreeMap::new();
    // We don't have per-record cost, so we spread total cost evenly across days for the line chart.
    // This is a best-effort approximation; accurate per-day cost requires joining cost_records.
    for r in provenance {
        let day = r.timestamp.get(..10).unwrap_or("unknown").to_string();
        day_map.entry(day).or_insert(0.0);
    }
    // If we have cost summaries but no day breakdown, add total cost to the most recent day.
    if !costs.is_empty() && !day_map.is_empty() {
        let last_day = day_map.keys().last().cloned().unwrap_or_default();
        *day_map.entry(last_day).or_insert(0.0) += stats.total_cost_usd;
    }

    let cost_by_day: Vec<serde_json::Value> = day_map
        .into_iter()
        .map(|(date, cost)| serde_json::json!({"date": date, "cost": cost}))
        .collect();

    let payload = serde_json::json!({
        "stats": stats,
        "cost_by_model": costs,
        "cost_by_day": cost_by_day,
    });

    serde_json::to_string(&payload).map_err(|e| anyhow::anyhow!("JSON serialize: {}", e))
}

fn build_provenance_rows(provenance: &[ProvenanceRecord], limit: usize) -> String {
    let recent: Vec<_> = provenance.iter().rev().take(limit).collect();
    if recent.is_empty() {
        return r#"      <tr><td colspan="5" class="empty">No provenance records in this range.</td></tr>"#
            .to_string();
    }
    recent
        .iter()
        .map(|r| {
            let badge_class = match r.contributor_type {
                crate::core::provenance::ContributorType::Ai => "badge-ai",
                crate::core::provenance::ContributorType::Human => "badge-human",
                _ => "badge-mixed",
            };
            format!(
                "      <tr><td>{}</td><td>{}</td><td><span class=\"badge {}\">{}</span></td><td>{}</td><td>{}</td></tr>",
                html_escape(&r.file_path),
                html_escape(&r.model_id),
                badge_class,
                r.contributor_type.as_str(),
                html_escape(&r.developer_id),
                html_escape(r.timestamp.get(..19).unwrap_or(&r.timestamp)),
            )
        })
        .collect::<Vec<_>>()
        .join("\n")
}

fn build_top_cost_rows(
    _provenance: &[ProvenanceRecord],
    costs: &[ModelCostSummary],
    limit: usize,
) -> String {
    let top: Vec<_> = costs.iter().take(limit).collect();
    if top.is_empty() {
        return r#"      <tr><td colspan="3" class="empty">No cost data available.</td></tr>"#
            .to_string();
    }
    top.iter()
        .map(|c| {
            format!(
                "      <tr><td>{}</td><td>${:.6}</td><td>{}</td></tr>",
                html_escape(&c.model_id),
                c.total_usd,
                c.total_tokens,
            )
        })
        .collect::<Vec<_>>()
        .join("\n")
}

fn html_escape(s: &str) -> String {
    s.replace('&', "&amp;")
        .replace('<', "&lt;")
        .replace('>', "&gt;")
        .replace('"', "&quot;")
}

// ── Tests ─────────────────────────────────────────────────────────────────────

#[cfg(test)]
mod tests {
    use super::*;
    use crate::core::provenance::{ContributorType, ProvenanceRecord};

    fn make_record(file: &str) -> ProvenanceRecord {
        ProvenanceRecord {
            id: Some(1),
            model_id: "claude-opus-4".to_string(),
            model_version: "".to_string(),
            prompt_hash: "ph".to_string(),
            code_hash: "ch".to_string(),
            file_path: file.to_string(),
            start_line: 1,
            end_line: 10,
            contributor_type: ContributorType::Ai,
            attestation_sig: "sig".to_string(),
            timestamp: "2025-02-01T12:00:00Z".to_string(),
            developer_id: "alice".to_string(),
            session_id: "s1".to_string(),
        }
    }

    fn make_cost(model: &str, usd: f64) -> ModelCostSummary {
        ModelCostSummary {
            model_id: model.to_string(),
            total_usd: usd,
            total_tokens: 500,
        }
    }

    fn make_stats() -> ExportStats {
        ExportStats {
            total_files: 1,
            total_cost_usd: 0.25,
            ai_pct: 100.0,
            top_model: "claude-opus-4".to_string(),
            date_range: ("2025-01-01T00:00:00Z".to_string(), "2025-03-01T00:00:00Z".to_string()),
        }
    }

    #[test]
    fn render_produces_valid_html_doctype() {
        let html = render(&[make_record("src/main.rs")], &[make_cost("claude-opus-4", 0.25)], &make_stats()).unwrap();
        assert!(html.starts_with("<!DOCTYPE html>"));
    }

    #[test]
    fn render_includes_chartjs_cdn() {
        let html = render(&[], &[], &make_stats()).unwrap();
        assert!(html.contains("cdn.jsdelivr.net/npm/chart.js"));
    }

    #[test]
    fn render_injects_data_variable() {
        let html = render(&[], &[], &make_stats()).unwrap();
        assert!(html.contains("const DATA ="));
    }

    #[test]
    fn render_escapes_html_in_file_paths() {
        let mut r = make_record("<script>alert(1)</script>.rs");
        r.contributor_type = ContributorType::Ai;
        let html = render(&[r], &[], &make_stats()).unwrap();
        assert!(!html.contains("<script>alert(1)</script>.rs"));
        assert!(html.contains("&lt;script&gt;"));
    }

    #[test]
    fn render_empty_data_has_empty_message() {
        let html = render(&[], &[], &make_stats()).unwrap();
        assert!(html.contains("No provenance records in this range"));
        assert!(html.contains("No cost data available"));
    }
}
