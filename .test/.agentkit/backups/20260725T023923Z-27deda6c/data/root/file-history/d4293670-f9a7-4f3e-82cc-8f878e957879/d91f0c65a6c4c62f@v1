    costs: &[ModelCostSummary],
    stats: &ExportStats,
) -> Result<String> {
    let data_json = build_data_json(provenance, costs, stats)?;
    let recent_rows = build_provenance_rows(provenance, 20);
    let top_cost_rows = build_top_cost_rows(provenance, costs, 10);

