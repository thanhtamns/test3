//! Self-contained HTML dashboard template for codeflow Phase 6.
//!
//! Renders a single HTML file with Chart.js (CDN) charts and embedded JSON data.

use anyhow::Result;

use crate::core::exporter::{ExportStats, ModelCostSummary};
use crate::core::provenance::ProvenanceRecord;

/// Render the full dashboard HTML string.
