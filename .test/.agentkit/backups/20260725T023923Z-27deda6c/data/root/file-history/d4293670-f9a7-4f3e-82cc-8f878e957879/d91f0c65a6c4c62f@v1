  .chart-card h2 {{ font-size: 0.95rem; color: #cbd5e1; margin-bottom: 16px; font-weight: 600; }}
  .chart-container {{ position: relative; height: 220px; }}
  .ai-bar-wrap {{ background: #0f172a; border-radius: 8px; height: 32px; margin-top: 8px; overflow: hidden; }}
  .ai-bar-fill {{ height: 100%; background: linear-gradient(90deg, #38bdf8, #818cf8); border-radius: 8px; transition: width 0.4s; display: flex; align-items: center; padding-left: 8px; font-size: 0.8rem; font-weight: 700; color: #fff; white-space: nowrap; }}
