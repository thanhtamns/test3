describe('Fix-cost classification', () => {
  test('gaps include fix_cost field', () => {
    const text = [
      '# Investment Analysis: Quick Opportunity',
      '',
      'This looks promising with good ROI potential.',
      'Market growing fast. Technology ready.',
      'We can capture value quickly.',
    ].join('\n') + '\n' + 'Padding text. '.repeat(60);

    const r = audit(text);
    const allGaps = [...r.gaps.critical, ...r.gaps.major, ...r.gaps.minor];
    // Every gap should have fix_cost
    for (const gap of allGaps) {
      expect(['auto', 'medium', 'large']).toContain(gap.fix_cost);
    }
  });

  test('invest schema has large fix_cost on failure_arch and competitors', () => {
    const text = [
      '# Investment Analysis: SaaS Tool',
      '',
      '## Thesis',
      'Opportunity exists because market mechanism drives growth.',
      '',
      '## Risk Assessment',
      'Some risk exists in the approach.',
      '',
      '## Verdict',
      'Recommend proceeding with caution.',
      'Next step: validate with customers.',
      '',
      'Revenue projection: year 1 target.',
      'Moat: defensibility through network effect and switching cost.',
    ].join('\n') + '\n' + 'Additional analysis. '.repeat(40);

    const r = audit(text);
    expect(r.type).toBe('invest');
    // Should have failure_arch and competitors as gaps with large fix_cost
    const allGaps = [...r.gaps.critical, ...r.gaps.major];
    const largeGaps = allGaps.filter(g => g.fix_cost === 'large');
    const largeIds = largeGaps.map(g => g.id);
    expect(largeIds).toContain('inv_failure_arch');
    expect(largeIds).toContain('inv_competitors');
  });
});

// ═══════════════════════════════════════════════════════════════
// CONVERGENCE E2E
// ═══════════════════════════════════════════════════════════════

describe('Convergence system E2E', () => {
  test('same gap on 2nd call is marked unfillable and passes', () => {
    reset();
    // Use default schema (simpler, guaranteed to trigger)
    // Text with TODO that can't be fixed by re-auditing
    const text = 'Here is a detailed implementation plan for the system.\n\n' +
      'The architecture uses microservices. TODO: define service boundaries.\n\n' +
      'We need to handle authentication and authorization properly.\n' +
      'Additional context about the system design and requirements.\n' +
      'The deployment strategy involves Docker containers.\n' +
      'More explanation text here for padding. '.repeat(20);

    const r1 = audit(text);
    expect(r1.passed).toBe(false);
    expect(r1.iteration).toBe(1);
    expect(r1.gaps.critical.some(g => g.id === 'default_no_todo')).toBe(true);

    // Same output again (simulating Claude couldn't fix it)
    const r2 = audit(text);
    expect(r2.passed).toBe(true);
    expect(r2.converged).toBe(true);
    expect(r2.reason).toMatch(/unfillable|stagnating/);
  });
});
