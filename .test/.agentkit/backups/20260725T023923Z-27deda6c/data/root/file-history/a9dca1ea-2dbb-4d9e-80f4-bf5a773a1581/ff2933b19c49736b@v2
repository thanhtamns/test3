def _seed_errors(errors_path, knob_id, n=5):
    errors_path.parent.mkdir(parents=True, exist_ok=True)
    with open(errors_path, "a", encoding="utf-8") as f:
        for i in range(n):
            f.write(json.dumps({
                "case_id": f"T-{i:03d}", "step": "6_mountain_test",
                "step_name": "Mountain Test", "error_type": "direction_mismatch",
                "severity": 0.7, "knobs_implicated": [knob_id],
                "detail": "test", "predicted_verdict": "MOUNTAIN_CANDIDATE",
                "actual_outcome": "KILL", "timestamp": f"2026-05-16T15:{i:02d}:00Z",
            }) + "\n")


def _seed_outcomes(outcomes_path, n=5):
    outcomes_path.parent.mkdir(parents=True, exist_ok=True)
    with open(outcomes_path, "w", encoding="utf-8") as f:
        for i in range(n):
            f.write(json.dumps({
                "case_id": f"O-{i:03d}", "outcome": "KILL",
                "timestamp": f"2026-05-16T16:{i:02d}:00Z",
            }) + "\n")


class TestSessionCheck:
    def test_idle_no_outcomes(self, orchestrator):
        result = orchestrator.run_session_check()
        assert result.mode == "session_check"
        assert result.outcomes_since_last_edit == 0

    def test_not_enough_outcomes(self, orchestrator, env):
        _seed_outcomes(env["outcomes_path"], n=3)
        result = orchestrator.run_session_check()
        assert result.meta_edit_action == "idle"

    def test_triggers_at_threshold(self, orchestrator, env):
        _seed_outcomes(env["outcomes_path"], n=5)
        _seed_errors(env["errors_path"], "mountain_threshold_monthly", n=5)
        result = orchestrator.run_session_check()
        assert result.meta_edit_action == "edit_applied"

    def test_graceful_on_error(self, orchestrator, monkeypatch):
        monkeypatch.setattr(orchestrator.controller, "should_run",
                            lambda x: (_ for _ in ()).throw(RuntimeError("boom")))
        result = orchestrator.run_session_check()
        assert len(result.errors) > 0


class TestAfterOutcome:
    def test_runs_attribution(self, orchestrator, env):
        trace = TraceLogger(case_id="ATTR-001", traces_dir=env["traces_dir"])
        trace.log_step("3.5_wave1", "Wave 1",
                       knobs_used=["mountain_threshold_monthly"],
                       signal={"direction": "GO", "confidence": 0.8})
        trace.log_step("6_mountain_test", "Mountain",
                       knobs_used=["mountain_threshold_monthly"],
                       signal={"direction": "GO", "confidence": 0.75})
        trace.log_step("7_verdict_synthesis", "Synthesis",
                       knobs_used=["confidence_gate_minimum"],
                       signal={"direction": "GO", "confidence": 0.78})
        trace.log_step("3.5_wave2", "Wave 2",
                       knobs_used=["mountain_threshold_monthly"],
                       signal={"direction": "GO", "confidence": 0.7})
        trace.log_verdict_composition("MOUNTAIN_CANDIDATE", final_confidence=0.78)
        trace.save()

        result = orchestrator.run_after_outcome("ATTR-001", "KILL", "MOUNTAIN_CANDIDATE")
        assert result.attribution_errors > 0

    def test_no_trace_still_works(self, orchestrator):
        result = orchestrator.run_after_outcome("MISSING-001", "KILL", "GO")
        assert result.attribution_errors == 0
        assert len(result.errors) == 0


class TestStatus:
    def test_status_returns_dict(self, orchestrator):
        status = orchestrator.get_status()
        assert "controller_state" in status
        assert "outcomes_since_last_edit" in status
        assert "error_summary" in status

    def test_status_after_edit(self, orchestrator, env):
        _seed_outcomes(env["outcomes_path"], n=5)
        _seed_errors(env["errors_path"], "mountain_threshold_monthly", n=5)
        orchestrator.run_session_check()

        status = orchestrator.get_status()
        assert status["controller_state"] == "segment_running"
        assert status["active_segment"] is not None


class TestOrchestrationResult:
