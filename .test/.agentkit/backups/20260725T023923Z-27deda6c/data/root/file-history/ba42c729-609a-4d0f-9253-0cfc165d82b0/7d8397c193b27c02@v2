use anyhow::Result;
use prost::Message;
use rusqlite::{params, Connection};
use std::path::Path;
use std::time::{SystemTime, UNIX_EPOCH};

use crate::proto;

pub struct EventBuffer {
    conn: Connection,
}

impl EventBuffer {
    pub fn open(db_path: &Path) -> Result<Self> {
        let conn = Connection::open(db_path)?;
        conn.execute_batch(
            "PRAGMA journal_mode=WAL;
             PRAGMA synchronous=NORMAL;
             PRAGMA busy_timeout=5000;"
        )?;
        conn.execute_batch(
            "CREATE TABLE IF NOT EXISTS event_buffer (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                created_at INTEGER NOT NULL,
                payload BLOB NOT NULL,
                consumed INTEGER NOT NULL DEFAULT 0
            );"
        )?;
        conn.execute_batch(
            "CREATE INDEX IF NOT EXISTS idx_event_buffer_consumed
             ON event_buffer(consumed, id);"
        )?;
        Ok(Self { conn })
    }

    pub fn append(&self, event: &proto::Event) -> Result<i64> {
        let mut buf = Vec::with_capacity(event.encoded_len());
        event.encode(&mut buf)?;
        let now = now_ms();
        self.conn.execute(
            "INSERT INTO event_buffer (created_at, payload) VALUES (?1, ?2)",
            params![now as i64, buf],
        )?;
        Ok(self.conn.last_insert_rowid())
    }

    pub fn consume_batch(&self, limit: usize) -> Result<Vec<(i64, proto::Event)>> {
        let mut stmt = self.conn.prepare(
            "SELECT id, payload FROM event_buffer
             WHERE consumed = 0 ORDER BY id ASC LIMIT ?1",
        )?;
        let rows = stmt.query_map(params![limit as i64], |row| {
            let id: i64 = row.get(0)?;
            let payload: Vec<u8> = row.get(1)?;
            Ok((id, payload))
        })?;

        let mut events = Vec::new();
        for row in rows {
            let (id, payload) = row?;
            let event = proto::Event::decode(payload.as_slice())?;
            events.push((id, event));
        }
        Ok(events)
    }

    pub fn mark_consumed(&self, ids: &[i64]) -> Result<u64> {
        if ids.is_empty() {
            return Ok(0);
        }
        let placeholders: Vec<String> = ids.iter().map(|_| "?".to_string()).collect();
        let sql = format!(
            "UPDATE event_buffer SET consumed = 1 WHERE id IN ({})",
            placeholders.join(",")
        );
        let params: Vec<Box<dyn rusqlite::types::ToSql>> =
            ids.iter().map(|id| Box::new(*id) as Box<dyn rusqlite::types::ToSql>).collect();
        let refs: Vec<&dyn rusqlite::types::ToSql> = params.iter().map(|p| p.as_ref()).collect();
        let changes = self.conn.execute(&sql, refs.as_slice())?;
        Ok(changes as u64)
    }

    pub fn purge_consumed(&self) -> Result<u64> {
        let changes = self
            .conn
            .execute("DELETE FROM event_buffer WHERE consumed = 1", [])?;
        Ok(changes as u64)
    }

    pub fn pending_count(&self) -> Result<usize> {
        let count: i64 = self.conn.query_row(
            "SELECT COUNT(*) FROM event_buffer WHERE consumed = 0",
            [],
            |row| row.get(0),
        )?;
        Ok(count as usize)
    }
}

fn now_ms() -> u64 {
    SystemTime::now()
        .duration_since(UNIX_EPOCH)
        .unwrap_or_default()
        .as_millis() as u64
}

#[cfg(test)]
mod tests {
    use super::*;
    use tempfile::TempDir;

    fn make_event(command: &str) -> proto::Event {
        proto::Event {
            id: uuid::Uuid::new_v4().to_string(),
            timestamp_ms: now_ms() as i64,
            session_id: "test-session".to_string(),
            project_dir: "/test".to_string(),
            command: command.to_string(),
            event_type: proto::EventType::Compression as i32,
            compression: Some(proto::CompressionEvent {
                input_bytes: 1000,
                output_bytes: 400,
                input_tokens: 250,
                output_tokens: 100,
                tokens_saved: 150,
                filter_name: "git-status".to_string(),
                compression_level: "default".to_string(),
                latency_ms: 1.5,
            }),
            dedup: None,
            provenance: None,
            cost: None,
            governance: None,
            quality: None,
        }
    }

    fn setup() -> (EventBuffer, TempDir) {
        let dir = TempDir::new().unwrap();
        let db_path = dir.path().join("events.db");
        let buf = EventBuffer::open(&db_path).unwrap();
        (buf, dir)
    }

    #[test]
    fn test_append_and_consume() {
        let (buf, _dir) = setup();
        buf.append(&make_event("git status")).unwrap();
        buf.append(&make_event("npm test")).unwrap();

        assert_eq!(buf.pending_count().unwrap(), 2);

        let batch = buf.consume_batch(10).unwrap();
        assert_eq!(batch.len(), 2);
        assert_eq!(batch[0].1.command, "git status");
        assert_eq!(batch[1].1.command, "npm test");
    }

    #[test]
    fn test_mark_consumed() {
        let (buf, _dir) = setup();
        let id1 = buf.append(&make_event("cmd1")).unwrap();
        let id2 = buf.append(&make_event("cmd2")).unwrap();

        buf.mark_consumed(&[id1]).unwrap();
        assert_eq!(buf.pending_count().unwrap(), 1);

        let batch = buf.consume_batch(10).unwrap();
        assert_eq!(batch.len(), 1);
        assert_eq!(batch[0].0, id2);
    }

    #[test]
    fn test_purge_consumed() {
        let (buf, _dir) = setup();
        let id = buf.append(&make_event("cmd")).unwrap();
        buf.mark_consumed(&[id]).unwrap();
        let purged = buf.purge_consumed().unwrap();
        assert_eq!(purged, 1);
        assert_eq!(buf.pending_count().unwrap(), 0);
    }

    #[test]
    fn test_consume_batch_limit() {
        let (buf, _dir) = setup();
        for i in 0..10 {
            buf.append(&make_event(&format!("cmd{}", i))).unwrap();
        }
        let batch = buf.consume_batch(3).unwrap();
        assert_eq!(batch.len(), 3);
    }

    #[test]
    fn test_protobuf_roundtrip() {
        let (buf, _dir) = setup();
        let original = make_event("roundtrip");
        buf.append(&original).unwrap();
        let batch = buf.consume_batch(1).unwrap();
        let decoded = &batch[0].1;
        assert_eq!(decoded.command, "roundtrip");
        assert_eq!(
            decoded.compression.as_ref().unwrap().tokens_saved,
            150
        );
    }
}
