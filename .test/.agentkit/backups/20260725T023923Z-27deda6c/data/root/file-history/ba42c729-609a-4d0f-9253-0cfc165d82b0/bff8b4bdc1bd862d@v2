syntax = "proto3";

package codeflow.events.v1;

// Versioning contract: proto3 additive-only.
// Never remove or rename fields. Ingest accepts v1+ with defaults.

message EventBatch {
  string cli_version = 1;
  string machine_id = 2;
  repeated Event events = 3;
}

message Event {
  string id = 1;
  int64 timestamp_ms = 2;
  string session_id = 3;
  string project_dir = 4;
  string command = 5;
  EventType event_type = 6;
  CompressionEvent compression = 7;
  DedupEvent dedup = 8;
  ProvenanceEvent provenance = 9;
  CostEvent cost = 10;
  GovernanceEvent governance = 11;
  QualityEvent quality = 12;
}

enum EventType {
  EVENT_TYPE_UNSPECIFIED = 0;
  EVENT_TYPE_COMPRESSION = 1;
  EVENT_TYPE_DEDUP = 2;
  EVENT_TYPE_PROVENANCE = 3;
  EVENT_TYPE_COST = 4;
  EVENT_TYPE_GOVERNANCE = 5;
  EVENT_TYPE_QUALITY = 6;
}

message CompressionEvent {
  uint64 input_bytes = 1;
  uint64 output_bytes = 2;
  uint64 input_tokens = 3;
  uint64 output_tokens = 4;
  uint64 tokens_saved = 5;
  string filter_name = 6;
  string compression_level = 7;
  double latency_ms = 8;
}

message DedupEvent {
  string content_hash = 1;
  bool cache_hit = 2;
  uint64 tokens_saved = 3;
  string file_path = 4;
  double latency_ms = 5;
}

enum ContributorType {
  CONTRIBUTOR_TYPE_UNKNOWN = 0;
  CONTRIBUTOR_TYPE_HUMAN = 1;
  CONTRIBUTOR_TYPE_AI = 2;
  CONTRIBUTOR_TYPE_MIXED = 3;
}

message ProvenanceEvent {
  string file_path = 1;
  string code_hash = 2;
  string model_id = 3;
  string model_version = 4;
  ContributorType contributor_type = 5;
  uint32 start_line = 6;
  uint32 end_line = 7;
  string attestation_sig = 8;
  string developer_id = 9;
  string prompt_hash = 10;
}

message CostEvent {
  string model_id = 1;
  double cost_usd = 2;
  uint64 input_tokens = 3;
  uint64 output_tokens = 4;
  string pr_ref = 5;
  string feature_tag = 6;
  string source = 7;
}

message GovernanceEvent {
  string policy_id = 1;
  string action = 2;
  string reason = 3;
  double budget_remaining = 4;
  string developer_id = 5;
}

message QualityEvent {
  string check_type = 1;
  string severity = 2;
  string file_path = 3;
  string finding = 4;
  bool blocked = 5;
  string package_name = 6;
  string registry = 7;
}
