pub fn session_id() -> String {
    std::env::var("CLAUDE_SESSION_ID")
        .or_else(|_| std::env::var("CODEFLOW_SESSION_ID"))
        .unwrap_or_else(|_| {
            #[cfg(unix)]
            let ppid = unsafe { libc::getppid() } as u32;
            #[cfg(not(unix))]
            let ppid = std::process::id();
            format!("local-{}", ppid)
        })
}

pub fn estimate_tokens(byte_len: usize) -> usize {
    byte_len.div_ceil(4)
}

pub fn get_file_mtime_ns(path: &str) -> Option<i64> {
    let meta = std::fs::metadata(path).ok()?;
    let modified = meta.modified().ok()?;
    let duration = modified
        .duration_since(std::time::UNIX_EPOCH)
        .ok()?;
    Some(duration.as_nanos() as i64)
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_estimate_tokens_empty() {
        assert_eq!(estimate_tokens(0), 0);
    }

    #[test]
    fn test_estimate_tokens_small() {
        assert_eq!(estimate_tokens(5), 2); // (5+3)/4 = 2
    }

    #[test]
    fn test_estimate_tokens_exact_boundary() {
        assert_eq!(estimate_tokens(4), 1);
        assert_eq!(estimate_tokens(8), 2);
    }

    #[test]
    fn test_estimate_tokens_one_byte() {
        assert_eq!(estimate_tokens(1), 1); // (1+3)/4 = 1
    }

    #[test]
    fn test_session_id_returns_nonempty() {
        let sid = session_id();
        assert!(!sid.is_empty());
    }

    #[test]
    fn test_get_file_mtime_ns_nonexistent() {
        assert!(get_file_mtime_ns("/nonexistent/path/xyz").is_none());
    }

    #[test]
    fn test_get_file_mtime_ns_real_file() {
        let dir = tempfile::tempdir().unwrap();
        let path = dir.path().join("test.txt");
        std::fs::write(&path, "hello").unwrap();
        let mtime = get_file_mtime_ns(path.to_str().unwrap());
        assert!(mtime.is_some());
        assert!(mtime.unwrap() > 0);
    }
}
