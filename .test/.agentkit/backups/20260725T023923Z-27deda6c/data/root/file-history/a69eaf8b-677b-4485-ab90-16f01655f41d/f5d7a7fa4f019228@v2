MOCK_TR_OUTPUT = {
    "overall_score": 0.65,
    "dimension_scores": {
        "base_rates": {"score": 0.5, "zone_counts": {"K": 2, "T": 1, "?": 0}},
        "unit_economics": {"score": 0.7, "zone_counts": {"K": 3, "T": 1, "?": 0}},
    },
    "facts": [
        {"fact": "VN deal market is $500M", "confidence": 0.8, "zone_tag": "K"},
    ],
    "strategic_insight": {"verdict": "GO", "key_insight": "First mover advantage"},
}

QUERY = "Should I enter the VN import deal market?"

_MODULE = "..persona_debate"


def _make_debate(query_type: str = "custom") -> PersonaDebate:
    return PersonaDebate(QUERY, query_type, MOCK_TR_OUTPUT)


def _fake_persona_md(name: str) -> str:
    lines = [f"# {name.title()} Persona"] + [f"Line {i}" for i in range(100)]
    return "\n".join(lines)


def _make_mock_personas_dir(names: list[str]) -> MagicMock:
    """Build a mock PERSONAS_DIR whose glob() returns fake Path mocks per name."""
    fake_paths: dict[str, MagicMock] = {}
    for name in names:
        p = MagicMock(spec=Path)
        p.parent = MagicMock()
        p.parent.name = "investors"
        p.read_text.return_value = _fake_persona_md(name)
        fake_paths[name] = p

    mock_dir = MagicMock()

    def fake_glob(pattern):
        for name, p in fake_paths.items():
            if name in pattern:
                return [p]
        return []

    mock_dir.glob.side_effect = fake_glob
    return mock_dir


# --- select_personas ---

def test_select_personas_returns_3_for_known_type():
    debate = _make_debate("deal_analysis")
    names = PERSONA_SELECTION["deal_analysis"]
    mock_dir = _make_mock_personas_dir(names)
    with patch.object(_pd_module, "PERSONAS_DIR", mock_dir):
        personas = debate.select_personas(n=3)
    assert len(personas) == 3
    assert all(isinstance(p, PersonaConfig) for p in personas)


def test_select_personas_falls_back_to_custom():
    debate = _make_debate("unknown_type_xyz")
    custom_names = PERSONA_SELECTION["custom"]
    mock_dir = _make_mock_personas_dir(custom_names)
    with patch.object(_pd_module, "PERSONAS_DIR", mock_dir):
        personas = debate.select_personas()
    assert len(personas) == len(custom_names)
    returned_names = {p.name for p in personas}
    assert returned_names == set(custom_names)


def test_select_personas_skips_missing_files():
    debate = _make_debate("custom")
    mock_dir = MagicMock()
    mock_dir.glob.return_value = []
    mock_mmo = MagicMock()
    mock_mmo.exists.return_value = False
    with patch.object(_pd_module, "PERSONAS_DIR", mock_dir), \
         patch.object(_pd_module, "_MMO_PERSONAS_DIR", mock_mmo):
        personas = debate.select_personas()
    assert personas == []


def test_select_personas_respects_n_limit():
    debate = _make_debate("deal_analysis")
    names = PERSONA_SELECTION["deal_analysis"]
    mock_dir = _make_mock_personas_dir(names)
    with patch.object(_pd_module, "PERSONAS_DIR", mock_dir):
        personas = debate.select_personas(n=2)
    assert len(personas) <= 2


