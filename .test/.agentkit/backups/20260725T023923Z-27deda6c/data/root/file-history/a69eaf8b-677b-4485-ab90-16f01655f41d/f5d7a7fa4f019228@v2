# --- CLI ---

def test_cli_select_stage():
    repo_root = Path(__file__).resolve().parents[5]
    venv_python = repo_root / ".claude" / "skills" / ".venv" / "Scripts" / "python.exe"
    script = Path(__file__).resolve().parents[1] / "persona_debate.py"

    with tempfile.NamedTemporaryFile(
        mode="w", suffix=".json", delete=False, encoding="utf-8"
    ) as f:
        json.dump(MOCK_TR_OUTPUT, f)
        tr_path = f.name

    result = subprocess.run(
        [
            str(venv_python),
            str(script),
            "--query", QUERY,
            "--query-type", "custom",
            "--thinkrunner", tr_path,
            "--stage", "select",
        ],
        capture_output=True,
        text=True,
        cwd=str(repo_root),
        env={**__import__("os").environ, "PYTHONIOENCODING": "utf-8"},
    )
    assert result.returncode == 0, f"CLI failed: {result.stderr}"
    output = json.loads(result.stdout)
    assert isinstance(output, list)


