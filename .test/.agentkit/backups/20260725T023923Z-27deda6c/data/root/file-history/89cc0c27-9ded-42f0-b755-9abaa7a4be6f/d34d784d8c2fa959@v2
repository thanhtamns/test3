use anyhow::Result;
use std::io::{Read, Write};
use std::net::TcpListener;

use codeflow_core::{dashboard_template, exporter};

pub fn serve(port: u16) -> Result<()> {
    let db_path = super::paths::db_path();
    let addr = format!("127.0.0.1:{}", port);
    let listener = TcpListener::bind(&addr)?;

    println!("  CODEFLOW Dashboard Server\n");
    println!("  http://localhost:{}\n", port);
    println!("  Press Ctrl+C to stop.\n");

    for stream in listener.incoming() {
        let mut stream = match stream {
            Ok(s) => s,
            Err(_) => continue,
        };

        let mut buf = [0u8; 4096];
        let n = stream.read(&mut buf).unwrap_or(0);
        let request = String::from_utf8_lossy(&buf[..n]);

        let first_line = request.lines().next().unwrap_or("");
        let path = first_line.split_whitespace().nth(1).unwrap_or("/");

        let (status, content_type, body) = match path {
            "/" | "/index.html" => {
                match exporter::collect(&db_path, 90) {
                    Ok(data) => {
                        let html = dashboard_template::render_html(&data);
                        ("200 OK", "text/html", html)
                    }
                    Err(e) => ("500 Internal Server Error", "text/plain", format!("Error: {}", e)),
                }
            }
            "/api/data" => {
                match exporter::collect(&db_path, 90) {
                    Ok(data) => {
                        let json = exporter::to_json(&data).unwrap_or_default();
                        ("200 OK", "application/json", json)
                    }
                    Err(e) => ("500 Internal Server Error", "application/json",
                        format!("{{\"error\":\"{}\"}}", e)),
                }
            }
            _ => ("404 Not Found", "text/plain", "Not found".to_string()),
        };

        let response = format!(
            "HTTP/1.1 {}\r\nContent-Type: {}\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{}",
            status,
            content_type,
            body.len(),
            body
        );
        let _ = stream.write_all(response.as_bytes());
    }

    Ok(())
}
