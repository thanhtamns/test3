use std::collections::HashSet;

use crate::provenance::ProvenanceRecord;
use crate::quality_gate::GateResult;

pub fn generate(records: &[ProvenanceRecord], gate_results: &[GateResult]) -> String {
    let unique_devs: HashSet<&str> = records.iter().map(|r| r.developer_id.as_str()).collect();
    let unique_models: HashSet<&str> = records.iter().map(|r| r.model_id.as_str()).collect();
    let unique_files: HashSet<&str> = records.iter().map(|r| r.file_path.as_str()).collect();

    let total_gates = gate_results.len();
    let blocked_count = gate_results.iter().filter(|g| g.blocked).count();
    let pass_rate = if total_gates > 0 {
        ((total_gates - blocked_count) as f64 / total_gates as f64) * 100.0
    } else {
        100.0
    };

    let total_findings: usize = gate_results.iter().map(|g| g.findings.len()).sum();

    let model_list = if unique_models.is_empty() {
        "None".to_string()
    } else {
        let mut models: Vec<&str> = unique_models.into_iter().collect();
        models.sort();
        models.join(", ")
    };

    let dev_list = if unique_devs.is_empty() {
        "None".to_string()
    } else {
        let mut devs: Vec<&str> = unique_devs.into_iter().collect();
        devs.sort();
        devs.join(", ")
    };

    format!(
        "# SOC 2 Type II Evidence — AI Code Governance\n\
         \n\
         Generated by codeflow CLI\n\
         \n\
         ## CC6.1 — Logical Access Controls\n\
         \n\
         | Metric | Value |\n\
         |--------|-------|\n\
         | Total AI-generated code changes | {} |\n\
         | Unique files modified | {} |\n\
         | Unique developers | {} |\n\
         | Developer IDs | {} |\n\
         | Models used | {} |\n\
         \n\
         All AI-generated code changes are cryptographically attested with ed25519 signatures \
         binding prompt hash, model ID, code hash, timestamp, and developer ID.\n\
         \n\
         ## CC8.1 — Change Management\n\
         \n\
         | Metric | Value |\n\
         |--------|-------|\n\
         | Quality gate runs | {} |\n\
         | Quality gate pass rate | {:.1}% |\n\
         | Blocked changes | {} |\n\
         | Total findings | {} |\n\
         \n\
         Quality gates include: security scanning (secret detection, SQL injection, XSS), \
         dependency validation (hallucinated package detection), and license compliance \
         (copyleft detection).\n",
        records.len(),
        unique_files.len(),
        dev_list.matches(", ").count() + if dev_list == "None" { 0 } else { 1 },
        dev_list,
        model_list,
        total_gates,
        pass_rate,
        blocked_count,
        total_findings,
    )
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::provenance::ContributorType;
    use crate::quality_gate::{GateFinding, FindingKind, Severity};

    fn sample_records() -> Vec<ProvenanceRecord> {
        vec![
            ProvenanceRecord {
                id: None,
                session_id: "s1".into(),
                timestamp_ms: 1000,
                file_path: "src/main.rs".into(),
                code_hash: "h1".into(),
                model_id: "claude-sonnet-4-20250514".into(),
                model_version: "v1".into(),
                contributor_type: ContributorType::Ai,
                start_line: 1,
                end_line: 50,
                attestation_sig: "sig1".into(),
                developer_id: "alice".into(),
                prompt_hash: "p1".into(),
                project_dir: "/p".into(),
            },
            ProvenanceRecord {
                id: None,
                session_id: "s1".into(),
                timestamp_ms: 2000,
                file_path: "src/lib.rs".into(),
                code_hash: "h2".into(),
                model_id: "claude-haiku-3-5-20241022".into(),
                model_version: "v2".into(),
                contributor_type: ContributorType::Ai,
                start_line: 1,
                end_line: 30,
                attestation_sig: "sig2".into(),
                developer_id: "bob".into(),
                prompt_hash: "p2".into(),
                project_dir: "/p".into(),
            },
        ]
    }

    fn sample_gate_results() -> Vec<GateResult> {
        vec![
            GateResult {
                findings: vec![],
                blocked: false,
                exit_code: 0,
                files_scanned: 5,
            },
            GateResult {
                findings: vec![GateFinding {
                    file: "bad.py".into(),
                    line: 1,
                    severity: Severity::High,
                    kind: FindingKind::Security("secret".into()),
                    message: "secret detected".into(),
                }],
                blocked: true,
                exit_code: 1,
                files_scanned: 3,
            },
        ]
    }

    #[test]
    fn test_soc2_evidence_sections() {
        let md = generate(&sample_records(), &sample_gate_results());
        assert!(md.contains("## CC6.1 — Logical Access Controls"));
        assert!(md.contains("## CC8.1 — Change Management"));
        assert!(md.contains("SOC 2 Type II Evidence"));
    }

    #[test]
    fn test_soc2_includes_statistics() {
        let md = generate(&sample_records(), &sample_gate_results());
        assert!(md.contains("| Total AI-generated code changes | 2 |"));
        assert!(md.contains("| Unique files modified | 2 |"));
        assert!(md.contains("claude-sonnet-4-20250514"));
        assert!(md.contains("claude-haiku-3-5-20241022"));
        assert!(md.contains("| Quality gate pass rate | 50.0% |"));
        assert!(md.contains("| Blocked changes | 1 |"));
    }

    #[test]
    fn test_soc2_empty_records() {
        let md = generate(&[], &[]);
        assert!(md.contains("## CC6.1"));
        assert!(md.contains("| Total AI-generated code changes | 0 |"));
        assert!(md.contains("| Quality gate pass rate | 100.0% |"));
    }

    #[test]
    fn test_soc2_models_listed() {
        let md = generate(&sample_records(), &[]);
        assert!(md.contains("claude-haiku-3-5-20241022"));
        assert!(md.contains("claude-sonnet-4-20250514"));
    }
}
