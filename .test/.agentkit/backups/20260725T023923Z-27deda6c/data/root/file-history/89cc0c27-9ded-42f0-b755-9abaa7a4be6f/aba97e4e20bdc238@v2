func (c *Client) InsertProvenanceEvents(ctx context.Context, rows []ProvenanceRow) error {
	if len(rows) == 0 {
		return nil
	}
	batch, err := c.conn.PrepareBatch(ctx, `INSERT INTO codeflow.provenance_events (
		tenant_id, timestamp, session_id, project_dir, machine_id,
		file_path, code_hash, model_id, model_version, contributor_type,
		start_line, end_line, attestation_sig, developer_id, prompt_hash, cli_version
	)`)
	if err != nil {
		return fmt.Errorf("prepare provenance batch: %w", err)
	}
	for _, r := range rows {
		if err := batch.Append(
			r.TenantID, r.Timestamp, r.SessionID, r.ProjectDir, r.MachineID,
			r.FilePath, r.CodeHash, r.ModelID, r.ModelVersion, r.ContributorType,
			r.StartLine, r.EndLine, r.AttestationSig, r.DeveloperID, r.PromptHash, r.CLIVersion,
		); err != nil {
			return fmt.Errorf("append provenance row: %w", err)
		}
	}
	return batch.Send()
}

