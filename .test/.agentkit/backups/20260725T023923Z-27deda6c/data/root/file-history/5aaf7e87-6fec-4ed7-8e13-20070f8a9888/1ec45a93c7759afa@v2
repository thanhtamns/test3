"""Pure-math Elo engine for Idea Tournament. No LLM calls, no I/O, no dependencies."""

from __future__ import annotations

import copy

from .models import DebateResult, OpportunityHypothesis


def expected_score(ra: float, rb: float) -> float:
    """Expected score for player A given ratings ra, rb. ea + eb == 1.0."""
    return 1.0 / (1.0 + 10.0 ** ((rb - ra) / 400.0))


def elo_update(
    ra: float, rb: float, winner: str, k: float = 32.0,
) -> tuple[float, float]:
    """Return (new_ra, new_rb) after a match. winner: 'A', 'B', or 'DRAW'."""
    ea = expected_score(ra, rb)
    eb = 1.0 - ea
    if winner == "A":
        sa, sb = 1.0, 0.0
    elif winner == "B":
        sa, sb = 0.0, 1.0
    else:
        sa, sb = 0.5, 0.5
    return ra + k * (sa - ea), rb + k * (sb - eb)


def compute_rankings(
    hypotheses: list[OpportunityHypothesis],
    debates: list[DebateResult],
) -> list[OpportunityHypothesis]:
    """Process all debate results, update Elo ratings, return sorted descending. Does not mutate inputs."""
    by_id = {h.id: copy.copy(h) for h in hypotheses}

    for d in debates:
        ha = by_id.get(d.hypothesis_a_id)
        hb = by_id.get(d.hypothesis_b_id)
        if ha is None or hb is None:
            continue
        new_a, new_b = elo_update(ha.elo_rating, hb.elo_rating, d.winner)
        ha.elo_rating = new_a
        hb.elo_rating = new_b
        ha.matches_played += 1
        hb.matches_played += 1
        if d.winner == "A":
            ha.wins += 1
        elif d.winner == "B":
            hb.wins += 1
        if d.key_argument:
            winner_h = ha if d.winner == "A" else hb if d.winner == "B" else None
            if winner_h:
                winner_h.debate_highlights.append(d.key_argument)

    return sorted(by_id.values(), key=lambda h: h.elo_rating, reverse=True)
