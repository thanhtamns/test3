class TestClaimParserJSON:
    def test_parse_valid_json(self, parser):
        result = parser.parse_agent_output(SAMPLE_JSON_OUTPUT)
        assert result.parse_mode == "json"
        assert result.agent == "failure-archaeologist"
        assert result.domain == "micro_saas"
        assert len(result.claims) == 2

    def test_parse_json_claims_fields(self, parser):
        result = parser.parse_agent_output(SAMPLE_JSON_OUTPUT)
        c = result.claims[0]
        assert c.fact == "30% of micro-SaaS never reach $1K MRR"
        assert c.value == 0.30
        assert c.dimension == "failure_rates"
        assert c.confidence == 0.85
        assert c.zone_tag == "K"

    def test_parse_json_mechanisms(self, parser):
        result = parser.parse_agent_output(SAMPLE_JSON_OUTPUT)
        assert len(result.mechanisms) == 1
        assert result.mechanisms[0].cause == "no_existing_audience"
        assert result.mechanisms[0].strength == 0.7

    def test_parse_json_contradictions(self, parser):
        result = parser.parse_agent_output(SAMPLE_JSON_OUTPUT)
        assert len(result.contradictions) == 1
        assert result.contradictions[0].resolution_needed is True

    def test_parse_json_gaps(self, parser):
        result = parser.parse_agent_output(SAMPLE_JSON_OUTPUT)
        assert "no data on Vietnamese micro-SaaS" in result.gaps

    def test_parse_json_metadata(self, parser):
        result = parser.parse_agent_output(SAMPLE_JSON_OUTPUT)
        assert result.sources_checked == 8
        assert result.sources_with_data == 5

    def test_agent_domain_override(self, parser):
        result = parser.parse_agent_output(SAMPLE_JSON_OUTPUT, agent="custom-agent", domain="custom_domain")
        assert result.agent == "custom-agent"
        assert result.domain == "custom_domain"

    def test_parse_json_embedded_in_prose(self, parser):
        text = "Here is my analysis:\n" + SAMPLE_JSON_OUTPUT + "\nEnd of analysis."
        result = parser.parse_agent_output(text)
        assert result.parse_mode == "json"
        assert len(result.claims) == 2


class TestClaimParserValidation:
    def test_reject_empty_facts(self, parser):
        claims = [ParsedClaim(fact=""), ParsedClaim(fact="ok fact here")]
        valid = parser.validate_claims(claims)
        assert len(valid) == 1

    def test_reject_short_facts(self, parser):
        claims = [ParsedClaim(fact="hi"), ParsedClaim(fact="This is a real fact")]
        valid = parser.validate_claims(claims)
        assert len(valid) == 1

    def test_fix_invalid_dimension(self, parser):
        claims = [ParsedClaim(fact="50% failure rate in first year", dimension="invalid_dim")]
        valid = parser.validate_claims(claims)
        assert valid[0].dimension in [
            "failure_rates", "unit_economics", "competitive_landscape",
            "moat_patterns", "founder_paths", "timing_windows",
            "regulatory_risks", "compounding_mechanisms",
        ]

    def test_zone_tag_confidence_alignment(self, parser):
        claims = [
            ParsedClaim(fact="High confidence fact here", confidence=0.9, zone_tag="T"),
            ParsedClaim(fact="Medium confidence fact here", confidence=0.6, zone_tag="K"),
            ParsedClaim(fact="Low confidence fact here very uncertain", confidence=0.3, zone_tag="K"),
        ]
        valid = parser.validate_claims(claims)
        assert valid[0].zone_tag == "K"
        assert valid[1].zone_tag == "T"
        assert valid[2].zone_tag == "?"

    def test_clamp_confidence(self, parser):
        claims = [ParsedClaim(fact="Over-confident claim here", confidence=1.5)]
        valid = parser.validate_claims(claims)
        assert valid[0].confidence == 1.0

    def test_invalid_zone_tag_reset(self, parser):
        claims = [ParsedClaim(fact="Bad zone tag claim here", zone_tag="X", confidence=0.6)]
        valid = parser.validate_claims(claims)
        assert valid[0].zone_tag == "T"


class TestClaimParserDedup:
    def test_dedup_exact_match(self, parser):
        claims = [
            ParsedClaim(fact="Totally unique claim about quantum computing startups"),
            ParsedClaim(fact="Totally unique claim about quantum computing startups"),
        ]
        unique = parser.deduplicate_claims(claims)
        assert len(unique) == 1

    def test_dedup_against_db(self, tmp_db):
        p = ClaimParser(db_path=tmp_db)
        claims = [ParsedClaim(fact="30% of micro-SaaS never reach $1K MRR")]
        unique = p.deduplicate_claims(claims, threshold=0.85)
        assert len(unique) == 0

    def test_dedup_keeps_unique(self, tmp_db):
        p = ClaimParser(db_path=tmp_db)
        claims = [ParsedClaim(fact="Completely novel fact about quantum computing startups")]
        unique = p.deduplicate_claims(claims)
        assert len(unique) == 1

    def test_dedup_no_db(self, parser_no_db):
        claims = [ParsedClaim(fact="Some new claim about markets")]
        unique = parser_no_db.deduplicate_claims(claims)
        assert len(unique) == 1


class TestAgentOutputAdapter:
    def test_extract_percentage_claims(self, adapter):
        text = "About 30% of startups fail in year one. Also 65% of founders report burnout."
        claims = adapter.extract_claims_from_prose(text)
        assert len(claims) >= 2
        assert all(c.from_prose for c in claims)

    def test_extract_dollar_claims(self, adapter):
        text = "$2.5M total addressable market. Seed rounds average $500K in 2024."
        claims = adapter.extract_claims_from_prose(text)
        assert len(claims) >= 2
        dollar_claims = [c for c in claims if c.dimension == "unit_economics"]
        assert len(dollar_claims) >= 1

    def test_dollar_multiplier_k(self, adapter):
        text = "$50K average revenue per customer annually."
        claims = adapter.extract_claims_from_prose(text)
        assert any(c.value == 50_000 for c in claims)

    def test_dollar_multiplier_b(self, adapter):
        text = "$1.2B market size for AI tools globally."
        claims = adapter.extract_claims_from_prose(text)
        assert any(c.value == 1_200_000_000 for c in claims)

    def test_prose_confidence_penalty(self, adapter):
        text = "42% of bootstrapped SaaS founders are solo operators."
        claims = adapter.extract_claims_from_prose(text)
        assert all(c.confidence == 0.5 for c in claims)

    def test_extract_nearby_url(self, adapter):
        text = "Source: https://example.com/data — 30% of businesses fail quickly."
        claims = adapter.extract_claims_from_prose(text)
        url_claims = [c for c in claims if c.source_url]
        assert len(url_claims) >= 1

    def test_extract_nearby_date(self, adapter):
        text = "In 2024-06, about 30% of SaaS companies reported declining growth."
        claims = adapter.extract_claims_from_prose(text)
        dated = [c for c in claims if c.source_date]
        assert len(dated) >= 1

    def test_extract_gaps(self, adapter):
        text = "No data on Vietnamese market specifically. No information about regulatory costs."
        output = adapter.extract_structured_output(text)
        assert len(output.gaps) >= 1

    def test_extract_contradictions(self, adapter):
        text = "SaaS margins are very high. However, AI SaaS has infrastructure costs eating 40%."
        output = adapter.extract_structured_output(text)
        assert len(output.contradictions) >= 1

    def test_extract_mechanisms(self, adapter):
        text = "Many startups lack distribution because of no existing audience, which leads to slow initial traction."
        output = adapter.extract_structured_output(text)
        assert len(output.mechanisms) >= 1

    def test_full_prose_extraction(self, adapter):
        output = adapter.extract_structured_output(SAMPLE_PROSE_OUTPUT)
        assert len(output.claims) >= 3
        assert len(output.gaps) >= 1
        assert output.parse_mode == "prose"

    def test_dedup_within_prose(self, adapter):
        text = "30% of startups fail. About 30% of startups fail in the first year."
        claims = adapter.extract_claims_from_prose(text)
        facts = [c.fact.lower() for c in claims]
        assert len(facts) == len(set(facts))


