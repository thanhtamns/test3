def create_client(name: str) -> BaseLLMClient:
    """Factory function to create LLM client by name."""
    config = LLM_CONFIGS.get(name)
    if not config:
        raise ValueError(f"Unknown LLM: {name}")

    clients = {
        "claude": ClaudeClient,
        "gpt": GPTClient,
        "gemini": GeminiClient,
        "ollama_local": OllamaClient,
    }
    return clients[name](config)


def calculate_consensus(
    claude_entries: list,
    gpt_entries: list,
    gemini_entries: list
) -> tuple[list[dict], float]:
    """
    Calculate consensus across 3 models.
    Returns entries that appear in at least 2 models with consensus score.
    """
    # Normalize entries for comparison
    def normalize(entry: dict) -> str:
        statement = entry.get("statement", entry.get("content", {}).get("statement", ""))
        return statement.lower().strip()[:100]

    claude_normalized = {normalize(e): e for e in claude_entries}
    gpt_normalized = {normalize(e): e for e in gpt_entries}
    gemini_normalized = {normalize(e): e for e in gemini_entries}

    all_keys = set(claude_normalized) | set(gpt_normalized) | set(gemini_normalized)
    consensus_entries = []

    for key in all_keys:
        if not key:
            continue

        votes = []
        if key in claude_normalized:
            votes.append(("claude", claude_normalized[key]))
        if key in gpt_normalized:
            votes.append(("gpt", gpt_normalized[key]))
        if key in gemini_normalized:
            votes.append(("gemini", gemini_normalized[key]))

        if len(votes) >= 2:  # 2-of-3 consensus
            # Use highest-weight model's entry as base
            votes.sort(key=lambda x: MODEL_WEIGHTS[x[0]], reverse=True)
            entry = votes[0][1].copy()

            # Calculate weighted consensus score
            score = sum(MODEL_WEIGHTS[v[0]] for v in votes)
            entry["model_consensus"] = round(score, 2)
            entry["claude_agreed"] = key in claude_normalized
            entry["gpt_agreed"] = key in gpt_normalized
            entry["gemini_agreed"] = key in gemini_normalized

            consensus_entries.append(entry)

    avg_consensus = (
        sum(e["model_consensus"] for e in consensus_entries) / len(consensus_entries)
        if consensus_entries else 0
    )

    return consensus_entries, round(avg_consensus, 2)
