#!/usr/bin/env python3
"""
lfi_health_check.py — Quick health dashboard for Local-First Intelligence stack.
Usage: python .claude/scripts/lfi_health_check.py
"""

import json
import sqlite3
import sys
from datetime import datetime, timezone, timedelta
from pathlib import Path

sys.stdout.reconfigure(encoding="utf-8")

ROOT = Path(__file__).resolve().parents[2]
LIB = ROOT / ".claude" / "lib"
sys.path.insert(0, str(LIB))

VECTORS_DB = ROOT / ".claude" / "data" / "knowledge-distillation" / "decision-vectors.db"
KILL_SIGNALS = ROOT / ".claude" / "data" / "knowledge-distillation" / "kill-signals.json"
PROVENANCE_DB = ROOT / ".claude" / "data" / "provenance" / "facts.db"
TRACES_PATH = ROOT / ".claude" / "data" / "reasoning" / "chain_traces.jsonl"
ACCURACY_PATH = ROOT / ".claude" / "data" / "governance" / "domain-accuracy.json"


def count_vectors() -> int:
    if not VECTORS_DB.exists():
        return 0
    with sqlite3.connect(str(VECTORS_DB)) as conn:
        try:
            return conn.execute("SELECT COUNT(*) FROM decision_vectors").fetchone()[0]
        except sqlite3.OperationalError:
            return 0


def count_kill_signals() -> int:
    if not KILL_SIGNALS.exists():
        return 0
    try:
        return len(json.loads(KILL_SIGNALS.read_text(encoding="utf-8")))
    except (json.JSONDecodeError, OSError):
        return 0


def count_provenance() -> int:
    if not PROVENANCE_DB.exists():
        return 0
    with sqlite3.connect(str(PROVENANCE_DB)) as conn:
        try:
            return conn.execute("SELECT COUNT(*) FROM fact_provenance").fetchone()[0]
        except sqlite3.OperationalError:
            return 0


def stale_facts_count() -> int:
    if not PROVENANCE_DB.exists():
        return 0
    cutoff = (datetime.now(timezone.utc) + timedelta(days=7)).isoformat()
    with sqlite3.connect(str(PROVENANCE_DB)) as conn:
        try:
            return conn.execute(
                "SELECT COUNT(*) FROM fact_provenance WHERE expires_at IS NOT NULL AND expires_at < ?",
                (cutoff,),
            ).fetchone()[0]
        except sqlite3.OperationalError:
            return 0


def trace_stats() -> dict:
    if not TRACES_PATH.exists():
        return {"total": 0, "verdicts": {}, "needs_llm_pct": 0}
    lines = TRACES_PATH.read_text(encoding="utf-8").strip().split("\n")
    verdicts: dict[str, int] = {}
    for line in lines:
        if not line.strip():
            continue
        try:
            r = json.loads(line)
            v = r.get("verdict", "UNKNOWN")
            verdicts[v] = verdicts.get(v, 0) + 1
        except json.JSONDecodeError:
            continue
    total = sum(verdicts.values())
    needs_llm = verdicts.get("NEEDS_LLM", 0)
    return {
        "total": total,
        "verdicts": verdicts,
        "needs_llm_pct": (needs_llm / total * 100) if total > 0 else 0,
    }


def governance_report() -> dict:
    if not ACCURACY_PATH.exists():
        return {}
    try:
        state = json.loads(ACCURACY_PATH.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError):
        return {}

    from intelligence.governance import AccuracyTracker, AutonomyGovernor
    tracker = AccuracyTracker(ACCURACY_PATH)
    governor = AutonomyGovernor(tracker)
    return governor.report()


def main():
    print("=== LFI Health Check ===")
    print()

    vectors = count_vectors()
    signals = count_kill_signals()
    facts = count_provenance()
    print(f"Knowledge DB: {vectors} vectors, {signals} kill signals, {facts} provenance facts")

    stale = stale_facts_count()
    if stale > 0:
        print(f"Staleness: {stale} facts expiring within 7 days")
    print()

    ts = trace_stats()
    print(f"Reasoning: {ts['total']} chain traces")
    if ts["verdicts"]:
        parts = [f"{k}={v}" for k, v in sorted(ts["verdicts"].items())]
        print(f"  Verdicts: {', '.join(parts)}")
        print(f"  LLM dependency: {ts['needs_llm_pct']:.0f}% (target: <10%)")
    print()

    gov = governance_report()
    if gov:
        print("Autonomy Governance:")
        for domain, info in gov.items():
            level = info.get("level", "?")
            acc = info.get("accuracy", 0)
            verdicts = info.get("verdicts", 0)
            print(f"  {domain}: {level} ({acc:.0%} accuracy, {verdicts} verdicts)")
    else:
        print("Autonomy: No domains tracked yet")

    print()
    print("=== End Health Check ===")


if __name__ == "__main__":
    main()
