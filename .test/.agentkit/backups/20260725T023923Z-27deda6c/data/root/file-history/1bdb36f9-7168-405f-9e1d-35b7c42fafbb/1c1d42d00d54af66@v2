"""
AccuracyTracker — per-domain rolling accuracy tracking.
Persists state to JSON. Supports windowed accuracy queries.
"""

import json
from dataclasses import dataclass
from datetime import datetime, timezone
from pathlib import Path
from typing import Optional

ROOT = Path(__file__).resolve().parents[4]
DEFAULT_STATE_PATH = ROOT / ".claude" / "data" / "governance" / "domain-accuracy.json"


@dataclass
class AccuracyResult:
    accuracy: float
    sample_size: int
    sufficient: bool
    correct_count: int = 0

    def to_dict(self) -> dict:
        return {
            "accuracy": round(self.accuracy, 3),
            "sample_size": self.sample_size,
            "sufficient": self.sufficient,
            "correct_count": self.correct_count,
        }


class AccuracyTracker:
    MIN_SUFFICIENT = 30

    def __init__(self, state_path: Optional[Path] = None):
        self.state_path = state_path or DEFAULT_STATE_PATH
        self.state: dict = self._load()

    def record(self, domain: str, predicted: str, actual: str) -> None:
        correct = self._outcomes_match(predicted, actual)
        if domain not in self.state:
            self.state[domain] = {"verdicts": [], "total": 0, "correct": 0}

        self.state[domain]["verdicts"].append({
            "timestamp": datetime.now(timezone.utc).isoformat(),
            "predicted": predicted,
            "actual": actual,
            "correct": correct,
        })
        self.state[domain]["total"] += 1
        if correct:
            self.state[domain]["correct"] += 1
        self._save()

    def accuracy(self, domain: str, window: int = 30) -> AccuracyResult:
        data = self.state.get(domain, {})
        verdicts = data.get("verdicts", [])[-window:]
        if not verdicts:
            return AccuracyResult(accuracy=0.0, sample_size=0, sufficient=False)

        correct = sum(1 for v in verdicts if v["correct"])
        return AccuracyResult(
            accuracy=correct / len(verdicts),
            sample_size=len(verdicts),
            sufficient=len(verdicts) >= self.MIN_SUFFICIENT,
            correct_count=correct,
        )

    def domains(self) -> list[str]:
        return list(self.state.keys())

    def _outcomes_match(self, predicted: str, actual: str) -> bool:
        positive = {"success", "go", "pass", "mountain", "weak_pass"}
        negative = {"failure", "kill", "no_go", "skip"}
        p = predicted.lower().replace("-", "_").replace(" ", "_")
        a = actual.lower().replace("-", "_").replace(" ", "_")
        if p in positive and a in positive:
            return True
        if p in negative and a in negative:
            return True
        return p == a

    def _load(self) -> dict:
        if self.state_path.exists():
            try:
                return json.loads(self.state_path.read_text(encoding="utf-8"))
            except (json.JSONDecodeError, OSError):
                pass
        return {}

    def _save(self) -> None:
        self.state_path.parent.mkdir(parents=True, exist_ok=True)
        self.state_path.write_text(
            json.dumps(self.state, indent=2, ensure_ascii=False), encoding="utf-8"
        )
