class TestOutcomeTrigger:
    """Test OutcomeTrigger for learning from real outcomes."""

    def test_positive_outcomes_match(self, outcome_trigger):
        """Test that positive outcomes match correctly."""
        assert outcome_trigger._outcomes_match("success", "go") is True
        assert outcome_trigger._outcomes_match("mountain", "pass") is True
        assert outcome_trigger._outcomes_match("go", "success") is True

    def test_negative_outcomes_match(self, outcome_trigger):
        """Test that negative outcomes match correctly."""
        assert outcome_trigger._outcomes_match("kill", "failure") is True
        assert outcome_trigger._outcomes_match("skip", "no_go") is True
        assert outcome_trigger._outcomes_match("no-go", "kill") is True

    def test_outcomes_case_insensitive(self, outcome_trigger):
        """Test that outcome matching is case-insensitive."""
        assert outcome_trigger._outcomes_match("SUCCESS", "Go") is True
        assert outcome_trigger._outcomes_match("KILL", "no-go") is True

    def test_mismatched_outcomes(self, outcome_trigger):
        """Test that mismatched outcomes return False."""
        assert outcome_trigger._outcomes_match("success", "failure") is False
        assert outcome_trigger._outcomes_match("go", "kill") is False

    def test_correct_outcome_with_trace(self, outcome_trigger, temp_db_dir):
        """Test correct outcome with trace file present."""
        # Create trace file
        trace_path = temp_db_dir / "chain_traces.jsonl"
        trace_data = {
            "query": "case_123",
            "chain_detail": [
                {
                    "question": "Will this work?",
                    "answer": "Yes",
                    "status": "RESOLVED",
                    "confidence": 0.9,
                }
            ],
        }
        trace_path.write_text(json.dumps(trace_data) + "\n", encoding="utf-8")

        result = outcome_trigger.on_outcome(
            case_id="case_123",
            actual_outcome="success",
            predicted_verdict="go",
        )

        assert result.correct is True
        assert result.weight_updates == 1

    def test_correct_outcome_no_trace(self, outcome_trigger):
        """Test correct outcome when trace not available."""
        result = outcome_trigger.on_outcome(
            case_id="case_missing",
            actual_outcome="success",
            predicted_verdict="go",
        )

        assert result.correct is True
        assert result.weight_updates == 0  # no trace, no reinforcement

    def test_wrong_atoms_detection(self, outcome_trigger):
        """Test detection of wrong atoms in trace."""
        trace = {
            "query": "case_456",
            "chain_detail": [
                {
                    "question": "High CAC?",
                    "answer": "No",
                    "status": "RESOLVED",
                    "confidence": 0.3,  # low confidence → wrong
                },
                {
                    "question": "Good retention?",
                    "answer": "Yes",
                    "status": "RESOLVED",
                    "confidence": 0.8,
                },
            ],
        }

        wrong = outcome_trigger._find_wrong_atoms(trace, actual_outcome="failure")

        assert len(wrong) > 0
        assert any(a["confidence"] < 0.5 for a in wrong)

    def test_wrong_atoms_high_risk_detection(self, outcome_trigger):
        """Test detection of high-risk atoms that led to failure."""
        trace = {
            "query": "case_789",
            "chain_detail": [
                {
                    "question": "Any liquidity issues?",
                    "answer": "No issues",
                    "status": "RESOLVED",
                    "confidence": 0.8,  # high confidence but answer wrong
                }
            ],
        }

        wrong = outcome_trigger._find_wrong_atoms(trace, actual_outcome="kill")

        assert len(wrong) > 0  # should detect: "No issues" but actual_outcome=kill

    def test_incorrect_outcome_with_llm(self, outcome_trigger, distiller, temp_db_dir):
        """Test incorrect outcome triggers corrections."""
        trace_path = temp_db_dir / "chain_traces.jsonl"
        trace_data = {
            "query": "case_wrong",
            "query_type": "saas_subscription",
            "chain_detail": [
                {
                    "question": "Any retention issues?",
                    "answer": "No retention issues",
                    "status": "RESOLVED",
                    "confidence": 0.7,  # medium confidence with "No" → wrong_atom when fails
                }
            ],
        }
        trace_path.write_text(json.dumps(trace_data) + "\n", encoding="utf-8")

        def mock_llm(query: str):
            return [
                {
                    "industry": "saas",
                    "business_model": "subscription",
                    "outcome": "failure",
                    "reason": "margins compressed",
                }
            ]

        trigger = OutcomeTrigger(
            distiller=distiller,
            llm_query_fn=mock_llm,
            trace_path=trace_path,
        )

        result = trigger.on_outcome(
            case_id="case_wrong",
            actual_outcome="kill",
            predicted_verdict="go",
        )

        assert result.correct is False
        assert result.wrong_atoms > 0
        assert result.corrections_distilled > 0

    def test_incorrect_outcome_no_trace_no_correction(self, outcome_trigger):
        """Test incorrect outcome without trace returns empty."""
        result = outcome_trigger.on_outcome(
            case_id="case_notrace",
            actual_outcome="kill",
            predicted_verdict="go",
        )

        assert result.correct is False
        assert result.wrong_atoms == 0
        assert result.corrections_distilled == 0

    def test_outcome_evolution_to_dict(self):
        """Test OutcomeEvolution serialization."""
        result = OutcomeEvolution(
            case_id="case_123",
            correct=True,
            wrong_atoms=0,
            corrections_distilled=0,
            weight_updates=1,
        )

        d = result.to_dict()

        assert d["case_id"] == "case_123"
        assert d["correct"] is True
        assert d["weight_updates"] == 1


