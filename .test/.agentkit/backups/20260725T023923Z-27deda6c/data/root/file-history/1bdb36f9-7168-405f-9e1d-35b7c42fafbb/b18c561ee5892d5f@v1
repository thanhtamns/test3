class TestEvolutionIntegration:
    """Integration tests across triggers."""

    def test_session_outcome_continuous_loop(self, distiller, temp_db_dir):
        """Test loop: session fills gaps → outcome learns → continuous refreshes."""
        coverage = MagicMock(spec=CoverageTracker)
        coverage.check.return_value = CoverageResult(
            score=0.4, vector_count=2, signal_count=1, freshness_penalty=0.2,
            domain="saas_test", details={}
        )

        gaps = [
            Gap(
                gap_type="competitor",
                domain="saas_test",
                specifics="No competitors",
                priority=1,
                suggested_query="List competitors",
            )
        ]
        detector = MagicMock()
        detector.identify_gaps.return_value = gaps

        def session_llm(query: str):
            return [{"industry": "saas", "business_model": "subscription", "outcome": "success"}]

        # Step 1: Session trigger fills gaps
        session = SessionTrigger(
            coverage_tracker=coverage,
            gap_detector=detector,
            distiller=distiller,
            llm_query_fn=session_llm,
        )
        session_result = session.on_query({"industry": "saas", "business_model": "subscription"})

        assert session_result.new_vectors > 0

        # Step 2: Outcome trigger learns from result
        trace_path = temp_db_dir / "chain_traces.jsonl"
        trace_path.write_text(
            json.dumps({
                "query": "case_test",
                "chain_detail": [{"question": "Success?", "answer": "Yes", "status": "RESOLVED", "confidence": 0.8}]
            }) + "\n",
            encoding="utf-8"
        )

        outcome = OutcomeTrigger(
            distiller=distiller,
            trace_path=trace_path,
        )
        outcome_result = outcome.on_outcome(
            case_id="case_test",
            actual_outcome="success",
            predicted_verdict="go",
        )

        assert outcome_result.correct is True

        # Step 3: Continuous trigger would refresh (no mock needed)
        stale_monitor = MagicMock()
        stale_monitor.scan.return_value = []

        continuous = ContinuousTrigger(
            coverage_tracker=coverage,
            staleness_monitor=stale_monitor,
            distiller=distiller,
            llm_query_fn=lambda q: [{"industry": "saas"}],
        )
        continuous_result = continuous.run_daily()

        # All should complete without error
        assert session_result.gaps_filled >= 0
        assert outcome_result.correct is not None
        assert continuous_result.budget_spent >= 0


