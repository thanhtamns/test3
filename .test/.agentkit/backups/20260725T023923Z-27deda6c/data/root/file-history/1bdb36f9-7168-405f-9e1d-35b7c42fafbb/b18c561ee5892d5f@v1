class TestDistillationBridge:
    """Test DistillationBridge core functionality."""

    def test_distill_single_fact(self, distiller):
        """Test converting single fact to distilled vector."""
        facts = [
            {
                "industry": "saas",
                "business_model": "subscription",
                "outcome": "success",
                "churn_rate": 0.05,
            }
        ]

        vectors = distiller.distill(facts, domain="saas_subscription")

        assert len(vectors) == 1
        assert vectors[0].industry == "saas"
        assert vectors[0].business_model == "subscription"
        assert vectors[0].outcome == "success"
        assert vectors[0].features["churn_rate"] == 0.05

    def test_distill_multiple_facts(self, distiller):
        """Test distilling multiple facts at once."""
        facts = [
            {
                "industry": "saas",
                "business_model": "subscription",
                "outcome": "success",
                "churn_rate": 0.05,
            },
            {
                "industry": "marketplace",
                "business_model": "two_sided",
                "outcome": "failure",
                "reason": "liquidity",
            },
        ]

        vectors = distiller.distill(facts, domain="mixed")

        assert len(vectors) == 2
        assert vectors[0].industry == "saas"
        assert vectors[1].industry == "marketplace"

    def test_distill_deduplication(self, distiller):
        """Test that duplicates are not stored (>10 existing vectors)."""
        # Insert 11 existing vectors to trigger dedup
        distiller.vectors_db.parent.mkdir(parents=True, exist_ok=True)
        with sqlite3.connect(str(distiller.vectors_db)) as conn:
            conn.execute("""
                CREATE TABLE IF NOT EXISTS decision_vectors (
                    id TEXT PRIMARY KEY,
                    industry TEXT,
                    business_model TEXT,
                    features_json TEXT,
                    outcome TEXT,
                    source TEXT,
                    created_at TEXT
                )
            """)
            for i in range(11):
                conn.execute(
                    "INSERT INTO decision_vectors VALUES (?, ?, ?, ?, ?, ?, ?)",
                    (
                        f"v{i}",
                        "saas",
                        "subscription",
                        "{}",
                        "success",
                        "test",
                        datetime.now(timezone.utc).isoformat(),
                    ),
                )
            conn.commit()

        # Try to add duplicate
        facts = [
            {
                "industry": "saas",
                "business_model": "subscription",
                "outcome": "success",
                "churn_rate": 0.05,
            }
        ]

        vectors = distiller.distill(facts, domain="saas_subscription")

        # Should not add because duplicate threshold reached
        assert len(vectors) == 0

    def test_distill_correction(self, distiller):
        """Test distilling corrections from wrong predictions."""
        correction = {
            "industry": "saas",
            "business_model": "subscription",
            "outcome": "failure",
            "reason": "high CAC",
            "corrected_answer": "high customer acquisition cost kills subscription models",
        }

        vector = distiller.distill_correction(
            correction,
            original_answer="low churn indicates success",
            domain="saas_subscription",
        )

        assert vector is not None
        assert vector.source == "correction"
        assert vector.outcome == "failure"

    def test_update_kill_signals_new(self, distiller):
        """Test adding new kill signals."""
        signals = [
            {"name": "high_churn", "threshold": 0.2, "domain": "saas"},
            {"name": "low_margin", "threshold": 0.15, "domain": "saas"},
        ]

        added = distiller.update_kill_signals(signals)

        assert added == 2

        # Verify saved to file
        saved = json.loads(distiller.kill_signals_path.read_text(encoding="utf-8"))
        assert len(saved) == 2
        assert saved[0]["name"] == "high_churn"

    def test_update_kill_signals_dedup(self, distiller):
        """Test that duplicate kill signals are not added."""
        signals_1 = [{"name": "high_churn", "threshold": 0.2}]
        signals_2 = [
            {"name": "high_churn", "threshold": 0.25},  # same name
            {"name": "low_margin", "threshold": 0.15},  # new
        ]

        distiller.update_kill_signals(signals_1)
        added = distiller.update_kill_signals(signals_2)

        assert added == 1  # only low_margin is new

        saved = json.loads(distiller.kill_signals_path.read_text(encoding="utf-8"))
        assert len(saved) == 2

    def test_provenance_logging(self, distiller):
        """Test that provenance is logged for corrections."""
        correction = {
            "industry": "saas",
            "business_model": "subscription",
            "outcome": "failure",
        }

        distiller.distill_correction(
            correction,
            original_answer="success expected",
            domain="saas_subscription",
        )

        # Verify provenance DB created and logged
        with sqlite3.connect(str(distiller.provenance_db)) as conn:
            rows = conn.execute(
                "SELECT fact_text, domain, verified FROM fact_provenance"
            ).fetchall()

        assert len(rows) > 0
        assert rows[0][2] == 1  # verified flag set

    def test_vector_storage_creates_table(self, distiller):
        """Test that vector storage creates DB table if missing."""
        facts = [
            {
                "industry": "saas",
                "business_model": "subscription",
                "outcome": "success",
            }
        ]

        distiller.distill(facts, domain="saas_subscription")

        # Verify table exists and has data
        with sqlite3.connect(str(distiller.vectors_db)) as conn:
            rows = conn.execute(
                "SELECT COUNT(*) FROM decision_vectors"
            ).fetchone()

        assert rows[0] == 1


