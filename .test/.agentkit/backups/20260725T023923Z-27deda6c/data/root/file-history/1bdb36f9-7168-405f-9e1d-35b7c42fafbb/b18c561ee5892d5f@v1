class TestSessionTrigger:
    """Test SessionTrigger for on-query knowledge evolution."""

    def test_high_coverage_skips_evolution(self, mock_coverage_tracker, session_trigger):
        """Test that high coverage skips LLM calls."""
        mock_coverage_tracker.check.return_value = CoverageResult(
            score=0.9,  # HIGH
            vector_count=20,
            signal_count=5,
            freshness_penalty=0.0,
            domain="saas_subscription",
            details={},
        )

        result = session_trigger.on_query({"industry": "saas", "business_model": "subscription"})

        assert result.skipped_reason.startswith("Coverage sufficient")
        assert result.gaps_found == 0
        assert result.gaps_filled == 0

    def test_low_coverage_detects_gaps(self, session_trigger):
        """Test gap detection on low coverage."""
        query_features = {"industry": "saas", "business_model": "subscription"}

        result = session_trigger.on_query(query_features)

        assert result.gaps_found == 2  # from mock gap detector
        assert result.gaps_filled == 2  # all filled by mock LLM

    def test_gap_filling_creates_vectors(self, session_trigger):
        """Test that filled gaps create new vectors."""
        query_features = {"industry": "saas", "business_model": "subscription"}

        result = session_trigger.on_query(query_features)

        assert result.new_vectors > 0
        assert "saas_subscription" in result.domains_improved

    def test_llm_call_limit_enforced(self, mock_coverage_tracker, mock_gap_detector, distiller):
        """Test that max 3 LLM calls per session enforced."""
        call_count = [0]

        def limited_llm_query(query: str):
            call_count[0] += 1
            return [{"industry": "test", "outcome": "success"}]

        # Create gap list with 5 items (all high priority)
        gaps = [
            Gap(
                gap_type=f"type_{i}",
                domain="test_domain",
                specifics=f"Gap {i}",
                priority=i,  # sorted ascending, so first 3 picked
                suggested_query=f"Query {i}",
            )
            for i in range(5)
        ]

        detector = MagicMock()
        detector.identify_gaps.return_value = gaps

        trigger = SessionTrigger(
            coverage_tracker=mock_coverage_tracker,
            gap_detector=detector,
            distiller=distiller,
            llm_query_fn=limited_llm_query,
        )

        result = trigger.on_query({"industry": "test", "business_model": "test"})

        assert call_count[0] <= SessionTrigger.MAX_LLM_CALLS
        assert call_count[0] == 3

    def test_check_only_mode(self, session_trigger):
        """Test check_only returns gaps without LLM calls."""
        query_features = {"industry": "saas", "business_model": "subscription"}

        gaps = session_trigger.check_only(query_features)

        assert isinstance(gaps, list)
        assert len(gaps) > 0
        assert all(isinstance(g, Gap) for g in gaps)

    def test_check_only_high_coverage_returns_empty(self, mock_coverage_tracker, session_trigger):
        """Test check_only returns [] on high coverage."""
        mock_coverage_tracker.check.return_value = CoverageResult(
            score=0.9,
            vector_count=20,
            signal_count=5,
            freshness_penalty=0.0,
            domain="saas_subscription",
            details={},
        )

        gaps = session_trigger.check_only({"industry": "saas", "business_model": "subscription"})

        assert gaps == []

    def test_llm_exception_handling(self, mock_coverage_tracker, mock_gap_detector, distiller):
        """Test that LLM exceptions don't crash trigger."""
        def failing_llm(query: str):
            raise RuntimeError("LLM service down")

        trigger = SessionTrigger(
            coverage_tracker=mock_coverage_tracker,
            gap_detector=mock_gap_detector,
            distiller=distiller,
            llm_query_fn=failing_llm,
        )

        # Should not raise, just skip
        result = trigger.on_query({"industry": "saas", "business_model": "subscription"})

        assert result.gaps_filled == 0

    def test_no_llm_function_returns_skipped(self, mock_coverage_tracker, mock_gap_detector, distiller):
        """Test that missing LLM function is reported."""
        trigger = SessionTrigger(
            coverage_tracker=mock_coverage_tracker,
            gap_detector=mock_gap_detector,
            distiller=distiller,
            llm_query_fn=None,
        )

        result = trigger.on_query({"industry": "saas", "business_model": "subscription"})

        assert "No LLM query function" in result.skipped_reason

    def test_session_evolution_to_dict(self):
        """Test SessionEvolution serialization."""
        result = SessionEvolution(
            gaps_found=3,
            gaps_filled=2,
            new_vectors=5,
            domains_improved=["saas", "marketplace"],
            skipped_reason="",
        )

        d = result.to_dict()

        assert d["gaps_found"] == 3
        assert d["gaps_filled"] == 2
        assert d["new_vectors"] == 5
        assert "saas" in d["domains_improved"]


