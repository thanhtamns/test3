use std::process::Command;

fn codeflow_bin() -> String {
    let mut path = std::path::PathBuf::from(env!("CARGO_BIN_EXE_codeflow"));
    if !path.exists() {
        path = std::path::PathBuf::from("target/debug/codeflow");
    }
    path.to_string_lossy().to_string()
}

#[test]
fn test_version_output() {
    let output = Command::new(codeflow_bin())
        .arg("update")
        .output()
        .expect("failed to run codeflow");
    let stdout = String::from_utf8_lossy(&output.stdout);
    assert!(stdout.contains("codeflow 0.1.0"), "expected version in output: {}", stdout);
    assert!(stdout.contains("target:"), "expected target info: {}", stdout);
}

#[test]
fn test_cache_info_no_db() {
    let output = Command::new(codeflow_bin())
        .args(["cache", "info"])
        .env("HOME", std::env::temp_dir())
        .env("USERPROFILE", std::env::temp_dir())
        .env("LOCALAPPDATA", std::env::temp_dir().join("nonexistent"))
        .output()
        .expect("failed to run codeflow");
    let stdout = String::from_utf8_lossy(&output.stdout);
    assert!(
        stdout.contains("No cache") || stdout.contains("Cache entries"),
        "unexpected output: {}", stdout
    );
}

