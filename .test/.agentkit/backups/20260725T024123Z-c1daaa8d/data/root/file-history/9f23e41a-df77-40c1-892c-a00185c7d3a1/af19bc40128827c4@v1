#[test]
fn test_hook_pre_tool_use_passthrough() {
    let input = r#"{"tool_name":"Read","tool_input":{"file_path":"/tmp/foo"}}"#;
    let output = Command::new(codeflow_bin())
        .args(["hook", "pre-tool-use"])
        .env("CODEFLOW_SESSION_ID", "test")
        .stdin(std::process::Stdio::piped())
        .stdout(std::process::Stdio::piped())
        .stderr(std::process::Stdio::piped())
        .spawn()
        .and_then(|mut child| {
            use std::io::Write;
            child.stdin.take().unwrap().write_all(input.as_bytes()).unwrap();
            child.wait_with_output()
        })
        .expect("failed to run hook");

    let stdout = String::from_utf8_lossy(&output.stdout);
    assert_eq!(stdout.trim(), "{}", "non-Bash tool should passthrough: {}", stdout);
}

#[test]
fn test_hook_pre_tool_use_rewrites_bash() {
    let input = r#"{"tool_name":"Bash","tool_input":{"command":"git status"}}"#;
    let output = Command::new(codeflow_bin())
        .args(["hook", "pre-tool-use"])
        .env("CODEFLOW_SESSION_ID", "test")
        .stdin(std::process::Stdio::piped())
        .stdout(std::process::Stdio::piped())
        .stderr(std::process::Stdio::piped())
        .spawn()
        .and_then(|mut child| {
            use std::io::Write;
            child.stdin.take().unwrap().write_all(input.as_bytes()).unwrap();
            child.wait_with_output()
        })
        .expect("failed to run hook");

    let stdout = String::from_utf8_lossy(&output.stdout);
    assert!(stdout.contains("codeflow"), "expected rewrite with codeflow binary: {}", stdout);
    assert!(stdout.contains("wrap"), "expected 'wrap' subcommand in rewrite: {}", stdout);
    assert!(stdout.contains("git status"), "expected original command preserved: {}", stdout);
}

#[test]
fn test_hook_invalid_json_degrades() {
    let input = "not json at all";
    let output = Command::new(codeflow_bin())
        .args(["hook", "pre-tool-use"])
        .stdin(std::process::Stdio::piped())
        .stdout(std::process::Stdio::piped())
        .stderr(std::process::Stdio::piped())
        .spawn()
        .and_then(|mut child| {
            use std::io::Write;
            child.stdin.take().unwrap().write_all(input.as_bytes()).unwrap();
            child.wait_with_output()
        })
        .expect("failed to run hook");

    let stdout = String::from_utf8_lossy(&output.stdout);
    let stderr = String::from_utf8_lossy(&output.stderr);
    assert_eq!(stdout.trim(), "{}", "invalid JSON should passthrough: {}", stdout);
    assert!(stderr.contains("health-check"), "expected health-check warning: {}", stderr);
}

