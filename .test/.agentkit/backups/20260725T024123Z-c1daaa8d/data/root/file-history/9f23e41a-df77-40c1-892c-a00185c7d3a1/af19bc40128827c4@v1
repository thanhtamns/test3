#[test]
fn test_wrap_echo() {
    let output = Command::new(codeflow_bin())
        .args(["wrap", "echo", "hello world"])
        .env("CODEFLOW_SESSION_ID", "integration-test")
        .env("HOME", std::env::temp_dir().join("codeflow-wrap-test"))
        .env("USERPROFILE", std::env::temp_dir().join("codeflow-wrap-test"))
        .env("LOCALAPPDATA", std::env::temp_dir().join("codeflow-wrap-test"))
        .output()
        .expect("failed to run wrap");

    let stdout = String::from_utf8_lossy(&output.stdout);
    assert!(stdout.contains("hello world"), "wrap should pass through echo output: {}", stdout);
    assert!(output.status.success(), "wrap echo should succeed");
}
