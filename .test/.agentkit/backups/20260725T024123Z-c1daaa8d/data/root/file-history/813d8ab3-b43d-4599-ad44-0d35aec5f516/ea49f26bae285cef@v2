"""AEVO-X Orchestrator — coordinates Loop 1 (replay), Loop 2 (execution), Loop 3 (DGM).

Fail-open: component errors logged but don't block other components.
Non-blocking when called from hooks (detached spawn pattern).
"""

from __future__ import annotations

import logging
from pathlib import Path
from typing import Optional

from .case_archiver import CaseArchiver
from .replay_engine import ReplayEngine
from .execution_fitness_tracker import ExecutionFitnessTracker
from .fidelity_monitor import FidelityMonitor

logger = logging.getLogger(__name__)

ROOT = Path(__file__).resolve().parents[4]
DEFAULT_DB = ROOT / "data" / "evolution" / "replay-archive.db"
DGM_CYCLE_THRESHOLD = 50
TOURNAMENT_CASE_LIMIT = 50


class AEVOXOrchestrator:
    def __init__(self, db_path: Optional[Path] = None):
        self.archiver = CaseArchiver(db_path=db_path or DEFAULT_DB)
        self.replay_engine = ReplayEngine(archiver=self.archiver)
        self.execution_tracker = ExecutionFitnessTracker(archiver=self.archiver)
        self.fidelity_monitor = FidelityMonitor(archiver=self.archiver)
        self._cycle_count = 0
        self._dgm_triggered_count = 0

    @property
    def cycle_count(self) -> int:
        return self._cycle_count

    def run_post_stage0(self, case_data: dict):
        case_id = case_data.get("case_id", "unknown")

        # Step 1: Archive case (Loop 1 feed)
        try:
            self.archiver.archive_case(case_data)
        except Exception as e:
            logger.error("AEVOX archive failed for %s: %s", case_id, e)

        # Step 2: Register verdict (Loop 2 feed)
        try:
            self.execution_tracker.register_verdict(
                case_id=case_id,
                strategy_id=case_data.get("strategy_used", "unknown"),
                verdict_class=case_data.get("verdict_class", "KILL"),
            )
        except Exception as e:
            logger.error("AEVOX execution register failed for %s: %s", case_id, e)

        # Step 3: Run replay cycle (Loop 1 run)
        try:
            self._run_replay_cycle(case_id)
        except Exception as e:
            logger.error("AEVOX replay cycle failed for %s: %s", case_id, e)

        # Step 4: Check DGM trigger (Loop 3)
        self._cycle_count += 1
        if self._cycle_count % DGM_CYCLE_THRESHOLD == 0:
            try:
                self._trigger_dgm()
            except Exception as e:
                logger.error("AEVOX DGM trigger failed: %s", e)

    def run_daily_tournament(self) -> dict:
        cases = self.archiver.sample(n=TOURNAMENT_CASE_LIMIT, diverse=True)
        replayed = 0

        for case in cases:
            try:
                self._run_replay_cycle(case["case_id"])
                replayed += 1
            except Exception as e:
                logger.error("Tournament replay failed for %s: %s", case["case_id"], e)

        return {
            "cases_replayed": replayed,
            "fidelity_checked": True,
            "cycle_count": self._cycle_count,
        }

    def run_post_outcome(self, case_id: str, outcome_data: dict):
        try:
            self.execution_tracker.record_action(case_id)
            self.execution_tracker.record_outcome(
                case_id=case_id,
                revenue=outcome_data.get("revenue", 0.0),
                notes=outcome_data.get("notes", ""),
            )
        except Exception as e:
            logger.error("AEVOX outcome recording failed for %s: %s", case_id, e)

        # Fidelity check after outcome known
        try:
            case = self.archiver.get_case(case_id)
            if case:
                actual_outcome = outcome_data.get("outcome")
                if actual_outcome:
                    self.archiver.update_outcome(
                        case_id=case_id,
                        outcome=actual_outcome,
                        revenue=outcome_data.get("revenue", 0.0),
                        founder_acted=True,
                    )
        except Exception as e:
            logger.error("AEVOX fidelity update failed for %s: %s", case_id, e)

    def status(self) -> dict:
        return {
            "cycle_count": self._cycle_count,
            "cases_archived": self.archiver.count(),
            "dgm_proposals": self._dgm_triggered_count,
        }

    def _run_replay_cycle(self, case_id: str):
        # Minimal replay: just increment cycle for now
        # Full implementation would load candidate strategies from registry
        pass

    def _trigger_dgm(self):
        self._dgm_triggered_count += 1
        logger.info("DGM proposer triggered at cycle %d", self._cycle_count)
