    if agent_outputs is None:
        agent_outputs = {
            "niche-archaeologist": {
                "confidence": 0.8,
                "dimension_scores": {"revenue_potential": 8.0, "moat_strength": 6.0, "execution_feasibility": 7.0, "timing": 9.0},
            },
            "market-reality-checker": {
                "confidence": 0.7,
                "dimension_scores": {"revenue_potential": 7.0, "moat_strength": 5.0, "execution_feasibility": 8.0, "timing": 7.0},
            },
            "failure-archaeologist": {
                "confidence": 0.6,
                "dimension_scores": {"revenue_potential": 6.0, "moat_strength": 7.0, "execution_feasibility": 6.0, "timing": 6.0},
            },
            "risk-mapper": {
                "confidence": 0.75,
