"""Tests for AEVO-X Replay Engine — deterministic batch replay from case archive."""

import json
import time

import pytest

from ..case_archiver import CaseArchiver
from ..replay_engine import ReplayEngine, ReplayVerdict

from ...mechanism.strategy_evolution.schema import Strategy


@pytest.fixture
def archiver(tmp_path):
    return CaseArchiver(db_path=tmp_path / "test-archive.db")


@pytest.fixture
def engine(archiver):
    return ReplayEngine(archiver=archiver)


def _make_strategy(
    name="test_strategy",
    wave1=None,
    wave2=None,
    rubric=None,
    scoring_formula="weighted_sum",
    confidence_aggregation="weighted_average",
):
    wave1 = wave1 or ["niche-archaeologist", "market-reality-checker", "failure-archaeologist", "risk-mapper"]
    wave2 = wave2 or ["competitive-intelligence", "pricing-psychology"]
    rubric = rubric or {"revenue_potential": 0.3, "moat_strength": 0.3, "execution_feasibility": 0.2, "timing": 0.2}
    return Strategy.create(
        name=name,
        wave1_agents=wave1,
        wave2_agents=wave2,
        gate_sequence=["mountain_test", "verdict"],
        mountain_rubric=rubric,
        scoring_formula=scoring_formula,
        confidence_aggregation=confidence_aggregation,
    )


