class TestStrategyAggregation:
    def test_get_strategy_fitness_aggregates_all_cases(self, tracker):
        for i in range(5):
            tracker.register_verdict(f"case_{i}", "strat_x", "MOUNTAIN_CANDIDATE")
            tracker.record_action(f"case_{i}")
            tracker.record_outcome(f"case_{i}", revenue=float(i * 100))
        fitness = tracker.get_strategy_fitness("strat_x", default_brier=0.3)
        assert 0.0 < fitness <= 1.0
