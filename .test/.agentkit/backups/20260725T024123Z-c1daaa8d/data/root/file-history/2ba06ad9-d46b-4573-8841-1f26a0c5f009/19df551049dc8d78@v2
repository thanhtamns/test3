import { NextResponse } from "next/server";
import type { NextRequest } from "next/server";
import { authkitMiddleware } from "@workos-inc/authkit-nextjs";

const workosMiddleware = authkitMiddleware({
  middlewareAuth: {
    enabled: true,
    unauthenticatedPaths: ["/auth/callback"],
  },
});

export default function middleware(request: NextRequest, event: Parameters<typeof workosMiddleware>[1]) {
  if (process.env.CODEFLOW_AUTH_DISABLED === "true") {
    return NextResponse.next();
  }
  return workosMiddleware(request, event);
}

export const config = {
  matcher: [
    "/((?!_next/static|_next/image|favicon.ico|.*\\.(?:svg|png|jpg|jpeg|gif|webp)$).*)",
  ],
};
