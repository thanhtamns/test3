"""
OutputFormatter — renders SynthesisResult as narrative intelligence brief.
Zone-tagged prose, not tables. Zero LLM calls.
"""


class OutputFormatter:
    def format(self, result, strategic_insight=None, founder_context=None) -> str:
        si = strategic_insight or result.strategic_insight
        parts = [
            self._header(result, si),
            self._mechanism(result, si),
            self._deep_reasoning(result),
            self._technique_intelligence(result),
            self._landscape(result),
            self._critical_gaps(result),
            self._strategic_path(result, si),
        ]
        if si and (si.get("asymmetric_play") or si.get("kill_conditions") or si.get("proceed_conditions")):
            parts.append(self._asymmetric_edge(si))
        parts.append(self._meta(result))
        return "\n\n".join(p for p in parts if p)

    # ── Header ────────────────────────────────────────────────────────────────

    def _header(self, result, si) -> str:
        score = result.overall_score
        verdict_label = (
            "strong signal" if score >= 0.75
            else "moderate signal" if score >= 0.5
            else "weak signal" if score >= 0.3
            else "insufficient data"
        )
        k = result.facts_by_zone.get("K", 0)
        t = result.facts_by_zone.get("T", 0)
        unk = result.facts_by_zone.get("?", 0)
        total = max(result.facts_used, 1)
        zone_narrative = (
            f"{k} verified [K], {t} inferred [T], {unk} uncertain [?]"
            if (k + t + unk) > 0
            else "no zone data"
        )
        verdict_line = f"**Verdict:** {score:.0%} {verdict_label} | {zone_narrative}"
        if si and si.get("verdict"):
            verdict_line += f" | {si['verdict']}"
        return f"# Intelligence Brief: {result.query}\n\n{verdict_line}"

    # ── Mechanism ─────────────────────────────────────────────────────────────

    def _mechanism(self, result, si) -> str:
        lines = ["## Mechanism"]
        if si and si.get("causal_chain"):
            chain = si["causal_chain"]
            if isinstance(chain, list):
                lines.append(" → ".join(str(c) for c in chain) + ".")
            else:
                lines.append(str(chain))
        else:
            # Synthesize from dimensions: highest and lowest scored tell the story
            sorted_dims = sorted(result.dimension_scores.items(), key=lambda x: x[1].score)
            if sorted_dims:
                weak = sorted_dims[0]
                strong = sorted_dims[-1]
                weak_name, weak_ds = weak
                strong_name, strong_ds = strong
                lines.append(
                    f"The strongest evidence sits in **{strong_name}** [{strong_ds.zone_tag}] "
                    f"({strong_ds.fact_count} facts, {strong_ds.avg_confidence:.0%} avg confidence). "
                    f"The critical unknown is **{weak_name}** [{weak_ds.zone_tag}] — "
                    f"only {weak_ds.fact_count} facts at {weak_ds.avg_confidence:.0%} confidence, "
                    f"which is the primary bottleneck to a clear verdict."
                )
            else:
                lines.append("Insufficient dimension data to synthesize mechanism.")
        return "\n\n".join(lines)

    # ── Deep Reasoning ─────────────────────────────────────────────────────────

    def _deep_reasoning(self, result) -> str:
        dr = getattr(result, "deep_reasoning", None)
        if not dr or not isinstance(dr, dict) or dr.get("error") or dr.get("status") == "skipped":
            return ""
        lines = ["## Deep Reasoning"]

        chains = dr.get("causal_chains", [])
        if chains:
            lines.append("**Causal Mechanisms:**")
            for c in chains[:3]:
                chain_text = c.get("chain", "")
                bottleneck = c.get("bottleneck", "")
                conf = c.get("confidence", "low")
                lines.append(f"- {chain_text} | Bottleneck: {bottleneck} [{conf}]")

        vulns = dr.get("vulnerabilities", [])
        if vulns:
            critical = [v for v in vulns if v.get("cascade_risk") == "total_collapse"]
            if critical:
                lines.append(f"\n**Critical Vulnerabilities ({len(critical)} chain-breaking):**")
                for v in critical[:3]:
                    lines.append(
                        f"- {v.get('link', '?')}: {v.get('failure_mode', '?')} "
                        f"[{v.get('type', '?')}]"
                    )

        insights = dr.get("emergent_insights", [])
        if insights:
            lines.append("\n**Cross-Dimensional Insights:**")
            for i in insights[:3]:
                lines.append(f"- {i}")

        scenarios = dr.get("scenarios", [])
        if scenarios:
            lines.append("\n**Scenario Map:**")
            for s in scenarios[:3]:
                name = s.get("name", "?")
                trigger = s.get("trigger", "?")
                prob = s.get("probability", "?")
                action = s.get("founder_action", "")
                lines.append(f"- **{name}** ({prob}): trigger={trigger}")
                if action:
                    lines.append(f"  → Founder action: {action}")

        pos = dr.get("position_map", {})
        if pos and pos.get("best_position"):
            lines.append(f"\n**Strategic Position:** {pos['best_position']}")
            if pos.get("why"):
                lines.append(f"Why: {pos['why']}")
            if pos.get("compound_mechanism"):
                lines.append(f"Compounds via: {pos['compound_mechanism']}")
            if pos.get("is_job_not_position"):
                lines.append("⚠ WARNING: This is a JOB, not a POSITION — no compound asset.")

        return "\n".join(lines)

    # ── Technique Intelligence ─────────────────────────────────────────────────

    def _technique_intelligence(self, result) -> str:
        tr = getattr(result, "technique_results", None)
        if not tr or not isinstance(tr, dict) or tr.get("error") or tr.get("status") == "failed":
            return ""
        consensus = tr.get("consensus", "UNKNOWN")
        go = tr.get("techniques_agreeing_go", 0)
        kill = tr.get("techniques_agreeing_kill", 0)
        lines = [
            "## Multi-Dimensional Analysis",
            f"15 techniques reached **{consensus}** consensus ({go} GO, {kill} KILL).",
        ]
        KEY_TECHNIQUES = [
            "T00_gold_rush_law", "T03_adversarial_debate", "T05_moat_tester",
            "T09_durability", "T08_staircase",
        ]
        results = tr.get("results", {})
        sig_lines = []
        for tid in KEY_TECHNIQUES:
            tres = results.get(tid)
            if tres and isinstance(tres, dict):
                v = tres.get("verdict", "?")
                chain = tres.get("reasoning_chain", [])
                reason = chain[0][:120] if chain else "no reasoning"
                sig_lines.append(f"- **{tid}**: {v} — {reason}")
        if sig_lines:
            lines.append("\n**Key signals:**")
            lines.extend(sig_lines)
        contrarians = []
        for tid, tres in results.items():
            if not isinstance(tres, dict):
                continue
            v = tres.get("verdict", "")
            if consensus == "GO" and v in ("KILL", "NEEDS_DATA"):
                contrarians.append(f"{tid}: {v}")
            elif consensus == "KILL" and v == "GO":
                contrarians.append(f"{tid}: GO")
        if contrarians:
            lines.append(f"\n**Contrarian voices:** {'; '.join(contrarians[:5])}")
        blocks = []
        if tr.get("fragile_block"):
            blocks.append("FRAGILE revenue (durability concern)")
        if tr.get("staircase_override"):
            blocks.append("Staircase override active (capital gap solved)")
        if blocks:
            lines.append(f"\n**Blocking signals:** {'; '.join(blocks)}")
        si = getattr(result, "strategic_insight", None)
        if isinstance(si, dict) and si.get("local_verdict"):
            lv = si["local_verdict"]
            lines.append(
                f"\n**Local evidence verdict:** {lv.get('verdict', '?')} "
                f"(score={lv.get('score', 0):.2f}, conf={lv.get('confidence', 0):.2f})"
            )
        return "\n".join(lines)

    # ── Landscape ─────────────────────────────────────────────────────────────

    def _landscape(self, result) -> str:
        if not result.dimension_scores:
            return ""
        lines = ["## Landscape"]
        # Sort by ascending score: most critical gaps first
        sorted_dims = sorted(result.dimension_scores.items(), key=lambda x: x[1].score)
        prev_name = None
        for dim_name, ds in sorted_dims:
            status = (
                "well-covered" if ds.score >= 0.7
                else "partially mapped" if ds.score >= 0.4
                else "largely unknown"
            )
            sentence = (
                f"**{dim_name}** [{ds.zone_tag}] is {status} ({ds.score:.0%}, "
                f"{ds.fact_count} facts at {ds.avg_confidence:.0%} confidence)."
            )
            if ds.contradictions > 0:
                sentence += (
                    f" There {'is' if ds.contradictions == 1 else 'are'} "
                    f"{ds.contradictions} contradiction{'s' if ds.contradictions > 1 else ''} "
                    f"in this dimension — treat its signals as contested."
                )
            # Connect to previous dimension where logical (simple linkage hint)
            if prev_name and ds.score < 0.4:
                sentence += f" This gap is likely downstream of weak {prev_name} data."
            lines.append(sentence)
            prev_name = dim_name
        return "\n\n".join(lines)

    # ── Critical Gaps ─────────────────────────────────────────────────────────

    def _critical_gaps(self, result) -> str:
        if not result.gaps:
            return ""
        lines = ["## Critical Gaps"]
        for gap in result.gaps:
            risk_level = "high" if gap.priority >= 0.7 else "medium" if gap.priority >= 0.4 else "low"
            para = (
                f"**{gap.dimension}** ({risk_level} priority, coverage {gap.score:.0%}): "
                f"{gap.suggested_action} "
                f"Without this, any decision rests on incomplete ground — "
                f"the risk is {'material' if risk_level == 'high' else 'moderate'}."
            )
            lines.append(para)
        return "\n\n".join(lines)

    # ── Strategic Path ────────────────────────────────────────────────────────

    def _strategic_path(self, result, si) -> str:
        if not result.path and not (si and si.get("asymmetric_play")):
            return ""
        lines = ["## Strategic Path"]
        compound = si.get("compound_trap") if si else None
        if compound:
            lines.append(f"The compound asset being built here: **{compound}**")
        if result.path:
            narrative_parts = []
            for step in result.path:
                deps = ""
                if step.dependencies:
                    deps = f" (requires: {', '.join(step.dependencies)})"
                narrative_parts.append(
                    f"**Move {step.step_number}** — {step.action} [{step.zone_tag}] "
                    f"({step.confidence:.0%} confidence). {step.rationale}{deps}."
                )
            lines.append(" ".join(narrative_parts) if len(narrative_parts) == 1
                         else "\n\n".join(narrative_parts))
        return "\n\n".join(lines)

    # ── Asymmetric Edge ───────────────────────────────────────────────────────

    def _asymmetric_edge(self, si) -> str:
        lines = ["## Asymmetric Edge"]
        if si.get("asymmetric_play"):
            lines.append(f"**The play others miss:** {si['asymmetric_play']}")
        if si.get("proceed_conditions"):
            conds = si["proceed_conditions"]
            if isinstance(conds, list):
                lines.append("**Proceed when:** " + "; ".join(str(c) for c in conds) + ".")
            else:
                lines.append(f"**Proceed when:** {conds}")
        if si.get("kill_conditions"):
            conds = si["kill_conditions"]
            if isinstance(conds, list):
                lines.append("**Kill if:** " + "; ".join(str(c) for c in conds) + ".")
            else:
                lines.append(f"**Kill if:** {conds}")
        return "\n\n".join(lines)

    # ── Meta footer ───────────────────────────────────────────────────────────

    def _meta(self, result) -> str:
        k = result.facts_by_zone.get("K", 0)
        t = result.facts_by_zone.get("T", 0)
        unk = result.facts_by_zone.get("?", 0)
        zone_str = f"K={k} T={t} ?={unk}"
        return (
            f"---\n"
            f"*{result.query_type} | {len(result.dimension_scores)} dimensions | "
            f"{result.facts_used} facts [{zone_str}] | {result.llm_calls_made} reasoning calls*"
        )
