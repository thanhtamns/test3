use crate::exporter::ExportData;

pub fn render_html(data: &ExportData) -> String {
    let json_data = serde_json::to_string(data).unwrap_or_default();

    format!(
        r#"<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CODEFLOW Dashboard</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
<style>
  * {{ margin: 0; padding: 0; box-sizing: border-box; }}
  body {{ font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #0f172a; color: #e2e8f0; padding: 2rem; }}
  h1 {{ font-size: 1.5rem; margin-bottom: 1.5rem; color: #38bdf8; }}
  .grid {{ display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; margin-bottom: 2rem; }}
  .card {{ background: #1e293b; border-radius: 12px; padding: 1.5rem; }}
  .card h2 {{ font-size: 1rem; color: #94a3b8; margin-bottom: 1rem; }}
  .stat {{ font-size: 2rem; font-weight: 700; color: #f1f5f9; }}
  .stat-label {{ font-size: 0.875rem; color: #64748b; }}
  .charts {{ display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }}
  .chart-card {{ background: #1e293b; border-radius: 12px; padding: 1.5rem; }}
  canvas {{ max-height: 300px; }}
  footer {{ margin-top: 2rem; text-align: center; color: #475569; font-size: 0.75rem; }}
</style>
</head>
<body>
<h1>CODEFLOW — AI Code Supply Chain Dashboard</h1>
<div class="grid">
  <div class="card">
    <h2>Provenance Records</h2>
    <div class="stat" id="total-records">0</div>
    <div class="stat-label">AI-tracked code changes</div>
  </div>
  <div class="card">
    <h2>Total Cost</h2>
    <div class="stat" id="total-cost">$0.00</div>
    <div class="stat-label">AI coding spend</div>
  </div>
  <div class="card">
    <h2>AI Percentage</h2>
    <div class="stat" id="ai-pct">0%</div>
    <div class="stat-label">of code changes</div>
  </div>
  <div class="card">
    <h2>Unique Files</h2>
    <div class="stat" id="unique-files">0</div>
    <div class="stat-label">modified by AI</div>
  </div>
</div>
<div class="charts">
  <div class="chart-card">
    <h2>Records by Model</h2>
    <canvas id="modelChart"></canvas>
  </div>
  <div class="chart-card">
    <h2>Cost by Model</h2>
    <canvas id="costChart"></canvas>
  </div>
</div>
<footer>Generated by codeflow v{version} | Range: {range}d | {generated_at}</footer>
<script>
const DATA = {json_data};
document.getElementById('total-records').textContent = DATA.provenance.total_records.toLocaleString();
document.getElementById('total-cost').textContent = '$' + DATA.cost.total_cost_usd.toFixed(2);
document.getElementById('ai-pct').textContent = DATA.provenance.ai_percentage.toFixed(1) + '%';
document.getElementById('unique-files').textContent = DATA.provenance.unique_files.toLocaleString();
const colors = ['#38bdf8','#818cf8','#a78bfa','#f472b6','#fb923c','#34d399','#fbbf24'];
const modelLabels = Object.keys(DATA.provenance.records_by_model);
const modelCounts = modelLabels.map(k => DATA.provenance.records_by_model[k]);
if (modelLabels.length > 0) {{
  new Chart(document.getElementById('modelChart'), {{
    type: 'doughnut',
    data: {{ labels: modelLabels, datasets: [{{ data: modelCounts, backgroundColor: colors }}] }},
    options: {{ responsive: true, plugins: {{ legend: {{ position: 'bottom', labels: {{ color: '#94a3b8' }} }} }} }}
  }});
}}
const costLabels = Object.keys(DATA.cost.cost_by_model);
const costValues = costLabels.map(k => DATA.cost.cost_by_model[k]);
if (costLabels.length > 0) {{
  new Chart(document.getElementById('costChart'), {{
    type: 'bar',
    data: {{ labels: costLabels, datasets: [{{ label: 'Cost (USD)', data: costValues, backgroundColor: '#38bdf8' }}] }},
    options: {{ responsive: true, scales: {{ y: {{ ticks: {{ color: '#94a3b8' }}, grid: {{ color: '#334155' }} }}, x: {{ ticks: {{ color: '#94a3b8' }}, grid: {{ color: '#334155' }} }} }}, plugins: {{ legend: {{ labels: {{ color: '#94a3b8' }} }} }} }}
  }});
}}
</script>
</body>
</html>"#,
        version = data.metadata.cli_version,
        range = data.metadata.range_days,
        generated_at = data.metadata.generated_at,
        json_data = json_data,
    )
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::exporter::{CostSummary, ExportMetadata, ProvenanceSummary};
    use std::collections::HashMap;

    fn sample_data() -> ExportData {
        ExportData {
            provenance: ProvenanceSummary {
                total_records: 42,
                unique_files: 15,
                unique_models: vec!["claude-sonnet-4-20250514".into()],
                unique_developers: vec!["dev-1".into()],
                ai_percentage: 85.7,
                records_by_model: {
                    let mut m = HashMap::new();
                    m.insert("claude-sonnet-4-20250514".into(), 42);
                    m
                },
            },
            cost: CostSummary {
                total_cost_usd: 12.34,
                total_input_tokens: 100000,
                total_output_tokens: 50000,
                cost_by_model: {
                    let mut m = HashMap::new();
                    m.insert("claude-sonnet-4-20250514".into(), 12.34);
                    m
                },
                record_count: 10,
            },
            metadata: ExportMetadata {
                range_days: 90,
                generated_at: "2026-06-08T12:00:00Z".into(),
                cli_version: "0.1.0".into(),
            },
        }
    }

    #[test]
    fn test_html_contains_chart_js() {
        let html = render_html(&sample_data());
        assert!(html.contains("chart.js"));
        assert!(html.contains("<canvas"));
    }

    #[test]
    fn test_html_contains_data() {
        let html = render_html(&sample_data());
        assert!(html.contains("\"total_records\":42"));
        assert!(html.contains("claude-sonnet-4-20250514"));
    }

    #[test]
    fn test_html_valid_structure() {
        let html = render_html(&sample_data());
        assert!(html.starts_with("<!DOCTYPE html>"));
        assert!(html.contains("</html>"));
        assert!(html.contains("CODEFLOW"));
    }

    #[test]
    fn test_html_metadata_in_footer() {
        let html = render_html(&sample_data());
        assert!(html.contains("Range: 90d"));
        assert!(html.contains("v0.1.0"));
    }
}
