"""Unit tests for tournament models, pair generation, diversity, and activation gate."""

from ..models import (
    OpportunityHypothesis, DebateResult, TournamentResult,
    generate_round_robin_pairs, classify_cluster, enforce_diversity,
    should_activate_tournament, MAX_HYPOTHESES,
)


def _make_hypothesis(id: str, cluster: str = "", elo: float = 1500.0, thesis: str = "") -> OpportunityHypothesis:
    return OpportunityHypothesis(
        id=id, title=f"H-{id}", thesis=thesis or f"Thesis for {id}",
        business_model_type="SaaS", customer_segment="B2B",
        evidence_refs=["Section 1 #1"], estimated_revenue_range="$1K-5K/mo",
        source_phase="pattern_matcher", elo_rating=elo, cluster=cluster,
    )


def test_hypothesis_creation():
    h = _make_hypothesis("H01")
    assert h.id == "H01"
    assert h.elo_rating == 1500.0
    assert h.matches_played == 0
    assert h.wins == 0
    assert h.debate_highlights == []


def test_hypothesis_to_dict_roundtrip():
    h = _make_hypothesis("H01")
    h.debate_highlights = ["Won on evidence strength"]
    d = h.to_dict()
    h2 = OpportunityHypothesis.from_dict(d)
    assert h2.id == h.id
    assert h2.title == h.title
    assert h2.elo_rating == h.elo_rating
    assert h2.debate_highlights == h.debate_highlights


def test_debate_result_creation():
    dr = DebateResult(
        pair_id="H01_vs_H02", hypothesis_a_id="H01", hypothesis_b_id="H02",
        scores_a={"evidence_strength": 8}, scores_b={"evidence_strength": 6},
        total_a=35, total_b=30, winner="A", key_argument="Stronger evidence",
    )
    assert dr.winner == "A"
    assert dr.is_retry is False


def test_debate_result_roundtrip():
    dr = DebateResult(
        pair_id="p1", hypothesis_a_id="A", hypothesis_b_id="B",
        scores_a={}, scores_b={}, total_a=25, total_b=25,
        winner="DRAW", key_argument="Too close", is_retry=True,
    )
    d = dr.to_dict()
    dr2 = DebateResult.from_dict(d)
    assert dr2.is_retry is True
    assert dr2.winner == "DRAW"


def test_tournament_result_creation():
    hyps = [_make_hypothesis("H01"), _make_hypothesis("H02")]
    debates = [DebateResult(
        pair_id="p1", hypothesis_a_id="H01", hypothesis_b_id="H02",
        scores_a={}, scores_b={}, total_a=30, total_b=28,
        winner="A", key_argument="Better fit",
    )]
    tr = TournamentResult(
        hypotheses=hyps, debates=debates,
        diversity_report={"clusters": 2}, debate_count=1, retry_count=0,
    )
    d = tr.to_dict()
    tr2 = TournamentResult.from_dict(d)
    assert len(tr2.hypotheses) == 2
    assert tr2.debate_count == 1


