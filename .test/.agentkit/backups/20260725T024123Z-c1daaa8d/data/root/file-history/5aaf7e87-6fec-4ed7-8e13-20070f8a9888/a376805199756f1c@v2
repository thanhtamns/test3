def test_classify_cluster_saas():
    assert classify_cluster("Build a subscription software platform") == "SaaS"


def test_classify_cluster_commerce():
    assert classify_cluster("Sell physical product via ecommerce and FBA") == "Commerce"


def test_classify_cluster_unknown():
    assert classify_cluster("Something completely unrelated xyz") == "Unknown"


def test_classify_cluster_service():
    assert classify_cluster("Start a consulting agency for freelance work") == "Service"


def test_diversity_already_diverse():
    hyps = [
        _make_hypothesis("A", cluster="SaaS", elo=1600),
        _make_hypothesis("B", cluster="Commerce", elo=1580),
        _make_hypothesis("C", cluster="Service", elo=1560),
        _make_hypothesis("D", cluster="Content", elo=1540),
        _make_hypothesis("E", cluster="Arbitrage", elo=1520),
        _make_hypothesis("F", cluster="Infrastructure", elo=1500),
    ]
    result = enforce_diversity(hyps)
    assert [h.id for h in result[:5]] == ["A", "B", "C", "D", "E"]


def test_diversity_promotes_underrepresented():
    hyps = [
        _make_hypothesis("A", cluster="SaaS", elo=1600),
        _make_hypothesis("B", cluster="SaaS", elo=1580),
        _make_hypothesis("C", cluster="SaaS", elo=1560),
        _make_hypothesis("D", cluster="SaaS", elo=1540),
        _make_hypothesis("E", cluster="SaaS", elo=1520),
        _make_hypothesis("F", cluster="Commerce", elo=1500),
        _make_hypothesis("G", cluster="Service", elo=1480),
    ]
    result = enforce_diversity(hyps)
    top5_clusters = {h.cluster for h in result[:5]}
    assert len(top5_clusters) >= 3


def test_activation_gate_passes():
    text = "This analysis found opportunity in SaaS platform with subscription revenue model and market pricing"
    assert should_activate_tournament(text, pattern_count=4) is True


def test_activation_gate_fails_keywords():
    text = "Nothing relevant here at all"
    assert should_activate_tournament(text, pattern_count=5) is False


def test_activation_gate_fails_pattern_count():
    text = "opportunity business model revenue pricing market"
    assert should_activate_tournament(text, pattern_count=2) is False


def test_activation_gate_dual_condition():
    text = "opportunity business model revenue"
    assert should_activate_tournament(text, pattern_count=3) is True
    assert should_activate_tournament(text, pattern_count=2) is False
