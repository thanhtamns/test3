"""
WebResearchBridge — creates real research_fn for MicroQueryRunner.
Uses DuckDuckGo for zero-API-key web search.
Falls back to requests-based scraping if DDG fails.
"""

import json
import time
import warnings
from typing import Optional

warnings.filterwarnings("ignore", message=".*renamed.*ddgs.*")

_LAST_CALL_TIME = 0.0
_MIN_DELAY_S = 1.5


def _rate_limit():
    global _LAST_CALL_TIME
    now = time.time()
    elapsed = now - _LAST_CALL_TIME
    if elapsed < _MIN_DELAY_S:
        time.sleep(_MIN_DELAY_S - elapsed)
    _LAST_CALL_TIME = time.time()


def ddg_research(prompt: str) -> str:
    """Research function using DuckDuckGo. Returns raw text for MicroQueryRunner to parse."""
    question = _extract_question(prompt)
    if not question:
        return ""

    _rate_limit()

    try:
        import warnings
        with warnings.catch_warnings():
            warnings.simplefilter("ignore")
            try:
                from ddgs import DDGS
            except ImportError:
                from duckduckgo_search import DDGS
            with DDGS() as ddgs:
                results = list(ddgs.text(question, max_results=5))
    except Exception:
        results = []

    if not results:
        return _fallback_search(question)

    snippets = []
    for r in results[:5]:
        title = r.get("title", "")
        body = r.get("body", "")
        href = r.get("href", "")
        snippets.append(f"{title}: {body} (source: {href})")

    combined = "\n".join(snippets)

    fact = _extract_fact_from_snippets(combined, question)
    return fact


def _extract_question(prompt: str) -> str:
    """Extract the actual question from the micro-query prompt template."""
    lines = prompt.strip().split("\n")
    for line in lines:
        if line.startswith("Question:"):
            return line.replace("Question:", "").strip()
    for line in lines:
        if "?" in line and not line.startswith("Format:") and not line.startswith("Rules:"):
            return line.strip()
    return prompt[:200]


def _extract_fact_from_snippets(text: str, question: str) -> str:
    """Convert search snippets into structured fact JSON for MicroQueryRunner."""
    import re

    numbers = re.findall(r'[\d,.]+%|[$€£]\s*[\d,.]+[KMBkmb]?|\d{1,3}(?:,\d{3})*(?:\.\d+)?', text)
    first_url = ""
    url_match = re.search(r'source:\s*(https?://[^\s\)]+)', text)
    if url_match:
        first_url = url_match.group(1)

    best_snippet = text[:300] if text else ""

    value = numbers[0] if numbers else None
    confidence = 0.6 if numbers else 0.4

    fact_json = {
        "fact": best_snippet[:200],
        "value": value,
        "confidence": confidence,
        "source": first_url or "duckduckgo_search",
        "date": None,
    }

    return json.dumps(fact_json, ensure_ascii=False)


def _fallback_search(question: str) -> str:
    """Fallback: use requests to hit DuckDuckGo HTML directly."""
    import requests
    try:
        resp = requests.get(
            "https://html.duckduckgo.com/html/",
            params={"q": question},
            headers={"User-Agent": "Mozilla/5.0"},
            timeout=10,
        )
        if resp.status_code == 200:
            text = resp.text[:2000]
            import re
            snippets = re.findall(r'class="result__snippet">(.*?)</a>', text)
            if snippets:
                combined = " ".join(s[:100] for s in snippets[:3])
                return json.dumps({
                    "fact": combined[:200],
                    "value": None,
                    "confidence": 0.35,
                    "source": "duckduckgo_html_fallback",
                    "date": None,
                }, ensure_ascii=False)
    except Exception:
        pass
    return ""


def create_research_fn(delay_s: float = 1.5) -> callable:
    """Factory: creates a rate-limited research function."""
    global _MIN_DELAY_S
    _MIN_DELAY_S = delay_s
    return ddg_research
