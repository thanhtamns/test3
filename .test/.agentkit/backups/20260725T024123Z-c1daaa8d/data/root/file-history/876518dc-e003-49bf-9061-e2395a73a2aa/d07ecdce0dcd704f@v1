func (f *fakeStorage) SetBillingStatus(_ context.Context, tenantID, plan, status string) error {
	return nil
}

func (f *fakeStorage) tenantOfEvent(i int) string {
	f.mu.Lock()
	defer f.mu.Unlock()
	if i < 0 || i >= len(f.events) {
		return ""
	}
	return f.events[i].TenantID
}
