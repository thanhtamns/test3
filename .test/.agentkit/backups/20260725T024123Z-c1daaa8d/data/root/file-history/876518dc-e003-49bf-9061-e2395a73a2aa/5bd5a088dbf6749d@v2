package api

import (
	"encoding/json"
	"io"
	"net/http"
	"os"

	"github.com/stripe/stripe-go/v82"
	"github.com/stripe/stripe-go/v82/checkout/session"
	"github.com/stripe/stripe-go/v82/webhook"
)

func init() {
	if key := os.Getenv("STRIPE_SECRET_KEY"); key != "" {
		stripe.Key = key
	}
}

func (h *handler) handleBillingStatus(w http.ResponseWriter, r *http.Request) {
	tenantID := tenantFromCtx(r)

	status, err := h.store.GetBillingStatus(r.Context(), tenantID)
	if err != nil {
		h.logger.Error("billing status query failed", "error", err)
	}

	w.Header().Set("Content-Type", "application/json")
	json.NewEncoder(w).Encode(status)
}

func (h *handler) handleCreateCheckout(w http.ResponseWriter, r *http.Request) {
	tenantID := tenantFromCtx(r)

	priceID := os.Getenv("STRIPE_PRO_PRICE_ID")
	if priceID == "" {
		http.Error(w, "billing not configured", http.StatusServiceUnavailable)
		return
	}

	successURL := os.Getenv("DASHBOARD_URL")
	if successURL == "" {
		successURL = "http://localhost:3000"
	}

	params := &stripe.CheckoutSessionParams{
		Mode: stripe.String(string(stripe.CheckoutSessionModeSubscription)),
		LineItems: []*stripe.CheckoutSessionLineItemParams{
			{
				Price:    stripe.String(priceID),
				Quantity: stripe.Int64(1),
			},
		},
		SuccessURL: stripe.String(successURL + "/billing?status=success"),
		CancelURL:  stripe.String(successURL + "/billing?status=cancelled"),
		ClientReferenceID: stripe.String(tenantID),
		Metadata: map[string]string{
			"tenant_id": tenantID,
		},
	}

	s, err := session.New(params)
	if err != nil {
		h.logger.Error("stripe checkout creation failed", "error", err)
		http.Error(w, "checkout failed", http.StatusInternalServerError)
		return
	}

	w.Header().Set("Content-Type", "application/json")
	json.NewEncoder(w).Encode(map[string]string{
		"checkout_url": s.URL,
	})
}

func (h *handler) handleStripeWebhook(w http.ResponseWriter, r *http.Request) {
	body, err := io.ReadAll(io.LimitReader(r.Body, 65536))
	if err != nil {
		http.Error(w, "read error", http.StatusBadRequest)
		return
	}

	endpointSecret := os.Getenv("STRIPE_WEBHOOK_SECRET")
	if endpointSecret == "" {
		h.logger.Warn("stripe webhook secret not configured")
		http.Error(w, "webhook not configured", http.StatusServiceUnavailable)
		return
	}

	event, err := webhook.ConstructEvent(body, r.Header.Get("Stripe-Signature"), endpointSecret)
	if err != nil {
		h.logger.Error("stripe webhook signature verification failed", "error", err)
		http.Error(w, "invalid signature", http.StatusBadRequest)
		return
	}

	switch event.Type {
	case "checkout.session.completed":
		var cs stripe.CheckoutSession
		if err := json.Unmarshal(event.Data.Raw, &cs); err != nil {
			h.logger.Error("unmarshal checkout session", "error", err)
			break
		}
		tenantID := cs.Metadata["tenant_id"]
		if tenantID == "" {
			tenantID = cs.ClientReferenceID
		}
		if tenantID != "" {
			h.logger.Info("subscription activated", "tenant", tenantID)
			if err := h.store.SetBillingStatus(r.Context(), tenantID, "pro", "active"); err != nil {
				h.logger.Error("set billing status failed", "error", err)
			}
		}

	case "customer.subscription.deleted":
		var sub stripe.Subscription
		if err := json.Unmarshal(event.Data.Raw, &sub); err != nil {
			break
		}
		tenantID := sub.Metadata["tenant_id"]
		if tenantID != "" {
			h.logger.Info("subscription cancelled", "tenant", tenantID)
			if err := h.store.SetBillingStatus(r.Context(), tenantID, "free", "cancelled"); err != nil {
				h.logger.Error("set billing status failed", "error", err)
			}
		}
	}

	w.WriteHeader(http.StatusOK)
}
