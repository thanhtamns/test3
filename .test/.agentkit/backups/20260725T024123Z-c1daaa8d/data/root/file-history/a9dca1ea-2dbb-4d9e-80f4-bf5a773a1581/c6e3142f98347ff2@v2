"""
safety_harness.py — Anti-reward-hacking protection for meta-edits.

AEVO insight: without a harness, 2/3 of evolution runs produce garbage.
This module enforces:
1. Hard invariants (floors, ceilings) that NO edit can violate
2. Per-edit magnitude limit (max 20% of range per cycle)
3. Total drift limit from original value
4. Weekly edit budget (max 3 edits per week)
5. Auto-rollback trigger on Brier regression

Usage:
    harness = SafetyHarness()
    result = harness.validate_edit(knob_id, old_value, new_value)
    if not result.allowed:
        raise SafetyViolationError(result.violations)
"""

from __future__ import annotations

import json
import logging
from dataclasses import dataclass, field
from datetime import datetime, timezone, timedelta
from pathlib import Path
from typing import Optional

logger = logging.getLogger(__name__)

_REPO_ROOT = Path(__file__).resolve().parents[4]
_DEFAULT_INVARIANTS_PATH = _REPO_ROOT / "data" / "config" / "mechanism-invariants.json"
_DEFAULT_KNOBS_HISTORY_PATH = _REPO_ROOT / "data" / "config" / "mechanism-knobs-history.jsonl"


@dataclass
class SafetyViolation:
    violation_type: str
    invariant_id: str = ""
    message: str = ""

    def to_dict(self) -> dict:
        return {
            "type": self.violation_type,
            "invariant_id": self.invariant_id,
            "message": self.message,
        }


@dataclass
class SafetyResult:
    allowed: bool
    violations: list[SafetyViolation] = field(default_factory=list)

    def to_dict(self) -> dict:
        return {
            "allowed": self.allowed,
            "violations": [v.to_dict() for v in self.violations],
        }


class SafetyHarness:
    """Validates meta-edits against hard invariants and soft bounds."""

    def __init__(
        self,
        invariants_path: Optional[Path] = None,
        history_path: Optional[Path] = None,
        max_edits_per_week: int = 3,
        max_pct_change: float = 0.20,
    ):
        self.invariants_path = Path(invariants_path or _DEFAULT_INVARIANTS_PATH)
        self.history_path = Path(history_path or _DEFAULT_KNOBS_HISTORY_PATH)
        self.max_edits_per_week = max_edits_per_week
        self.max_pct_change = max_pct_change
        self._invariants = self._load_invariants()

    def validate_edit(
        self,
        knob_id: str,
        old_value: float,
        new_value: float,
        knob_range: Optional[tuple] = None,
        source: str = "meta_edit_controller",
    ) -> SafetyResult:
        """
        Check edit against all safety constraints.

        Manual overrides (source="manual_override") skip soft bounds
        but still enforce hard invariants.
        """
        violations: list[SafetyViolation] = []

        violations.extend(self._check_hard_invariants(knob_id, new_value))

        if source != "manual_override":
            violations.extend(self._check_magnitude(knob_id, old_value, new_value, knob_range))
            violations.extend(self._check_drift(knob_id, new_value))
            violations.extend(self._check_weekly_budget(source))

        if violations:
            logger.warning("Safety blocked edit %s=%s: %s",
                           knob_id, new_value,
                           [v.violation_type for v in violations])
            return SafetyResult(allowed=False, violations=violations)

        return SafetyResult(allowed=True)

    def _check_hard_invariants(
        self, knob_id: str, new_value: float
    ) -> list[SafetyViolation]:
        """Check floor/ceiling invariants."""
        violations = []
        for inv in self._invariants:
            if inv.get("protected_knob") != knob_id:
                continue

            inv_type = inv.get("type", "")

            if inv_type == "floor":
                min_val = inv.get("min_value")
                if min_val is not None and new_value < min_val:
                    violations.append(SafetyViolation(
                        violation_type="hard_invariant_floor",
                        invariant_id=inv["id"],
                        message=f"{knob_id}={new_value} below floor {min_val}: {inv['description']}",
                    ))

            elif inv_type == "ceiling":
                max_val = inv.get("max_value")
                if max_val is not None and new_value > max_val:
                    violations.append(SafetyViolation(
                        violation_type="hard_invariant_ceiling",
                        invariant_id=inv["id"],
                        message=f"{knob_id}={new_value} above ceiling {max_val}: {inv['description']}",
                    ))

            elif inv_type == "drift_limit":
                original = inv.get("original_value")
                max_drift = inv.get("max_total_drift_pct", 30) / 100
                if original is not None and original != 0:
                    drift = abs(new_value - original) / abs(original)
                    if drift > max_drift:
                        violations.append(SafetyViolation(
                            violation_type="hard_invariant_drift",
                            invariant_id=inv["id"],
                            message=f"{knob_id} drift {drift:.0%} exceeds {max_drift:.0%}: {inv['description']}",
                        ))

        return violations

    def _check_magnitude(
        self, knob_id: str, old_value: float, new_value: float,
        knob_range: Optional[tuple] = None,
    ) -> list[SafetyViolation]:
        """Check per-edit magnitude limit (% of range)."""
        if knob_range and knob_range[0] is not None and knob_range[1] is not None:
            range_width = knob_range[1] - knob_range[0]
            if range_width > 0:
                pct = abs(new_value - old_value) / range_width
                if pct > self.max_pct_change:
                    return [SafetyViolation(
                        violation_type="magnitude_limit",
                        message=f"{knob_id} change {pct:.0%} of range exceeds {self.max_pct_change:.0%} limit",
                    )]
        return []

    def _check_drift(self, knob_id: str, new_value: float) -> list[SafetyViolation]:
        """Check total drift from original (via invariants with drift_limit)."""
        # Already handled in hard invariants for knobs that have drift_limit
        return []

    def _check_weekly_budget(self, source: str) -> list[SafetyViolation]:
        """Check if weekly edit budget is exhausted."""
        if source not in ("meta_edit_controller",):
            return []

        edits_this_week = self._count_edits_this_week()
        if edits_this_week >= self.max_edits_per_week:
            return [SafetyViolation(
                violation_type="budget_exhausted",
                message=f"{edits_this_week} meta-edits this week (max {self.max_edits_per_week})",
            )]
        return []

    def _count_edits_this_week(self) -> int:
        """Count meta_edit_controller edits in current calendar week."""
        if not self.history_path.exists():
            return 0

        now = datetime.now(timezone.utc)
        week_start = now - timedelta(days=now.weekday())
        week_start = week_start.replace(hour=0, minute=0, second=0, microsecond=0)

        count = 0
        try:
            for line in self.history_path.read_text(encoding="utf-8").strip().split("\n"):
                if not line.strip():
                    continue
                record = json.loads(line)
                if record.get("source") != "meta_edit_controller":
                    continue
                ts = record.get("timestamp", "")
                if ts > week_start.isoformat():
                    count += 1
        except (json.JSONDecodeError, OSError):
            pass

        return count

    def _load_invariants(self) -> list[dict]:
        """Load hard invariants from JSON."""
        if not self.invariants_path.exists():
            logger.warning("Invariants file not found: %s", self.invariants_path)
            return []
        try:
            data = json.loads(self.invariants_path.read_text(encoding="utf-8"))
            return data.get("invariants", [])
        except (json.JSONDecodeError, OSError) as e:
            logger.error("Failed to load invariants: %s", e)
            return []
