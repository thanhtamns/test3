def test_errors_sorted_by_severity(sample_trace, errors_path):
    """Returned errors should be sorted highest severity first."""
    attributor = ErrorAttributor(traces_dir=sample_trace, errors_path=errors_path)
    errors = attributor.attribute("TEST-001", actual_outcome="KILL", predicted_verdict="MOUNTAIN_CANDIDATE")

    if len(errors) > 1:
        for i in range(len(errors) - 1):
            assert errors[i].severity >= errors[i + 1].severity


def test_mechanism_error_to_dict():
    """MechanismError serializes correctly."""
    err = MechanismError(
        case_id="TEST",
        step="3.5_wave1",
        step_name="Wave 1",
        error_type="direction_mismatch",
        severity=0.75,
        knobs_implicated=["wave1_base_agent_count"],
        detail="test detail",
        predicted_verdict="GO",
        actual_outcome="KILL",
    )
    d = err.to_dict()
    assert d["case_id"] == "TEST"
    assert d["severity"] == 0.75
    assert "timestamp" in d
