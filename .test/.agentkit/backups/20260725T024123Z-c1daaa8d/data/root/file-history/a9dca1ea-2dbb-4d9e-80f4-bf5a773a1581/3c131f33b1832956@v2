def test_correct_verdict_returns_no_errors(sample_trace, errors_path):
    """If verdict was correct, no errors should be attributed."""
    attributor = ErrorAttributor(traces_dir=sample_trace, errors_path=errors_path)
    errors = attributor.attribute("TEST-001", actual_outcome="GO", predicted_verdict="MOUNTAIN_CANDIDATE")
    assert errors == []


def test_direction_mismatch_detected(sample_trace, errors_path):
    """Steps pushing GO when outcome is KILL should be flagged."""
    attributor = ErrorAttributor(traces_dir=sample_trace, errors_path=errors_path)
    errors = attributor.attribute("TEST-001", actual_outcome="KILL", predicted_verdict="MOUNTAIN_CANDIDATE")

    direction_errors = [e for e in errors if e.error_type == "direction_mismatch"]
    assert len(direction_errors) >= 3  # wave1, wave2, mountain_test all pushed GO

    for err in direction_errors:
        assert err.case_id == "TEST-001"
        assert err.severity >= 0.3
        assert len(err.knobs_implicated) > 0


def test_direction_mismatch_ignores_low_confidence(traces_dir, errors_path):
    """Steps with confidence <0.3 should not be flagged."""
    trace = TraceLogger(case_id="TEST-LOW", traces_dir=traces_dir)
    trace.log_step("3.5_wave1", "Wave 1",
                   knobs_used=["wave1_base_agent_count"],
                   signal={"direction": "GO", "confidence": 0.2})
    trace.log_step("7_verdict_synthesis", "Synthesis",
                   knobs_used=["confidence_gate_minimum"],
                   signal={"direction": "GO", "confidence": 0.25})
    trace.log_verdict_composition("GO", final_confidence=0.25)
    trace.save()

    attributor = ErrorAttributor(traces_dir=traces_dir, errors_path=errors_path)
    errors = attributor.attribute("TEST-LOW", actual_outcome="KILL", predicted_verdict="GO")
    direction_errors = [e for e in errors if e.error_type == "direction_mismatch"]
    assert len(direction_errors) == 0


def test_override_error_detected(mixed_signal_trace, errors_path):
    """Correct minority signal overridden by synthesis should be flagged."""
    attributor = ErrorAttributor(traces_dir=mixed_signal_trace, errors_path=errors_path)
    errors = attributor.attribute("TEST-002", actual_outcome="KILL", predicted_verdict="MOUNTAIN_CANDIDATE")

    override_errors = [e for e in errors if e.error_type == "override_error"]
    assert len(override_errors) == 1
    assert override_errors[0].step == "3.5_wave2"
    assert "confidence_gate_minimum" in override_errors[0].knobs_implicated


def test_missing_signal_detected(traces_dir, errors_path):
    """Critical steps that didn't fire should be flagged."""
    trace = TraceLogger(case_id="TEST-MISSING", traces_dir=traces_dir)
    trace.log_step("3.5_wave1", "Wave 1",
                   knobs_used=["wave1_base_agent_count"],
                   signal={"direction": "GO", "confidence": 0.7})
    # Missing: wave2, mountain_test, verdict_synthesis
    trace.log_verdict_composition("GO", final_confidence=0.7)
    trace.save()

    attributor = ErrorAttributor(traces_dir=traces_dir, errors_path=errors_path)
    errors = attributor.attribute("TEST-MISSING", actual_outcome="KILL", predicted_verdict="GO")

    missing_errors = [e for e in errors if e.error_type == "missing_signal"]
    missing_steps = {e.step for e in missing_errors}
    assert "3.5_wave2" in missing_steps
    assert "6_mountain_test" in missing_steps
    assert "7_verdict_synthesis" in missing_steps


def test_confidence_inflation_detected(traces_dir, errors_path):
    """High-confidence wrong verdict should flag inflating steps."""
    trace = TraceLogger(case_id="TEST-INFLATE", traces_dir=traces_dir)
    trace.log_step("3.5_wave1", "Wave 1",
                   knobs_used=["wave1_base_agent_count"],
                   signal={"direction": "GO", "confidence": 0.9})
    trace.log_step("6_mountain_test", "Mountain Test",
                   knobs_used=["mountain_threshold_monthly"],
                   signal={"direction": "GO", "confidence": 0.85})
    trace.log_step("7_verdict_synthesis", "Synthesis",
                   knobs_used=["confidence_gate_minimum"],
                   signal={"direction": "GO", "confidence": 0.88})
    trace.log_verdict_composition("MOUNTAIN_CANDIDATE",
                                  step_weights={"3.5_wave1": 0.4, "6_mountain_test": 0.4,
                                                "7_verdict_synthesis": 0.2},
                                  final_confidence=0.88)
    trace.save()

    attributor = ErrorAttributor(traces_dir=traces_dir, errors_path=errors_path)
    errors = attributor.attribute("TEST-INFLATE", actual_outcome="KILL", predicted_verdict="MOUNTAIN_CANDIDATE")

    inflate_errors = [e for e in errors if e.error_type == "confidence_inflation"]
    assert len(inflate_errors) >= 2
    assert all("confidence_gate_minimum" in e.knobs_implicated for e in inflate_errors)


def test_persist_writes_jsonl(sample_trace, errors_path):
    """Persisted errors should be written as JSONL."""
    attributor = ErrorAttributor(traces_dir=sample_trace, errors_path=errors_path)
    errors = attributor.attribute("TEST-001", actual_outcome="KILL", predicted_verdict="MOUNTAIN_CANDIDATE")

    attributor.persist(errors)

    assert errors_path.exists()
    lines = errors_path.read_text(encoding="utf-8").strip().split("\n")
    assert len(lines) == len(errors)

    first = json.loads(lines[0])
    assert first["case_id"] == "TEST-001"
    assert "error_type" in first


def test_persist_empty_does_nothing(errors_path):
    """Persisting empty list should not create file."""
    attributor = ErrorAttributor(errors_path=errors_path)
    attributor.persist([])
    assert not errors_path.exists()


def test_load_errors_filters_by_knob(sample_trace, errors_path):
    """load_errors with knob_id filter returns matching only."""
    attributor = ErrorAttributor(traces_dir=sample_trace, errors_path=errors_path)
    errors = attributor.attribute("TEST-001", actual_outcome="KILL", predicted_verdict="MOUNTAIN_CANDIDATE")
    attributor.persist(errors)

    wave1_errors = attributor.load_errors(knob_id="wave1_base_agent_count")
    assert all("wave1_base_agent_count" in e["knobs_implicated"] for e in wave1_errors)


