"""
WebResearchBridge — creates real research_fn for MicroQueryRunner.
Uses DuckDuckGo for zero-API-key web search.
Falls back to requests-based scraping if DDG fails.
"""

import json
import time
import warnings
from typing import Optional

warnings.filterwarnings("ignore", message=".*renamed.*ddgs.*")

_LAST_CALL_TIME = 0.0
_MIN_DELAY_S = 1.5


def _rate_limit():
    global _LAST_CALL_TIME
    now = time.time()
    elapsed = now - _LAST_CALL_TIME
    if elapsed < _MIN_DELAY_S:
        time.sleep(_MIN_DELAY_S - elapsed)
    _LAST_CALL_TIME = time.time()


def ddg_research(prompt: str) -> str:
    """Research function using DuckDuckGo + full page fetch for top URLs."""
    question = _extract_question(prompt)
    if not question:
        return ""

    _rate_limit()

    try:
        import warnings as _w
        with _w.catch_warnings():
            _w.simplefilter("ignore")
            try:
                from ddgs import DDGS
            except ImportError:
                from duckduckgo_search import DDGS
            with DDGS() as ddgs:
                results = list(ddgs.text(question, max_results=5))
    except Exception:
        results = []

    if not results:
        return _fallback_search(question)

    snippets = []
    urls_to_fetch = []
    for r in results[:5]:
        title = r.get("title", "")
        body = r.get("body", "")
        href = r.get("href", "")
        snippets.append(f"{title}: {body} (source: {href})")
        if href and len(urls_to_fetch) < 3:
            urls_to_fetch.append(href)

    page_texts = _fetch_pages(urls_to_fetch)
    if page_texts:
        combined = "\n".join(snippets) + "\n\n--- FULL PAGE CONTENT ---\n" + "\n\n".join(page_texts)
    else:
        combined = "\n".join(snippets)

    fact = _extract_fact_from_snippets(combined, question)
    return fact


def _fetch_pages(urls: list[str], max_chars_per_page: int = 3000) -> list[str]:
    """Fetch full page text from URLs, stripping HTML."""
    import requests
    import re

    texts = []
    for url in urls:
        try:
            resp = requests.get(
                url,
                headers={"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"},
                timeout=8,
                allow_redirects=True,
            )
            if resp.status_code != 200:
                continue
            html = resp.text
            for tag in ["script", "style", "nav", "footer", "header", "aside"]:
                html = re.sub(f"<{tag}[^>]*>.*?</{tag}>", "", html, flags=re.DOTALL | re.IGNORECASE)
            text = re.sub(r"<[^>]+>", " ", html)
            text = re.sub(r"\s+", " ", text).strip()
            if len(text) > 200:
                texts.append(f"[{url}] {text[:max_chars_per_page]}")
        except Exception:
            continue
    return texts


def _extract_question(prompt: str) -> str:
    """Extract the actual question from the micro-query prompt template."""
    lines = prompt.strip().split("\n")
    for line in lines:
        if line.startswith("Question:"):
            return line.replace("Question:", "").strip()
    for line in lines:
        if "?" in line and not line.startswith("Format:") and not line.startswith("Rules:"):
            return line.strip()
    return prompt[:200]


def _extract_fact_from_snippets(text: str, question: str) -> str:
    """Convert search snippets into structured fact JSON for MicroQueryRunner.
    Picks the MOST RELEVANT snippet to the question, not just the first one.
    Applies relevance penalty when snippet doesn't answer the question.
    """
    import re

    parts = text.split("\n\n--- FULL PAGE CONTENT ---\n")
    snippet_section = parts[0]
    page_section = parts[1] if len(parts) > 1 else ""

    snippets = snippet_section.split("\n")
    if page_section:
        for block in page_section.split("\n\n"):
            block = block.strip()
            if len(block) > 100:
                snippets.append(block[:600])
    best_snippet, best_relevance = _pick_best_snippet(snippets, question)

    numbers = re.findall(r'[\d,.]+%|[$€£]\s*[\d,.]+[KMBkmb]?|\d{1,3}(?:,\d{3})*(?:\.\d+)?', best_snippet)
    first_url = ""
    url_match = re.search(r'source:\s*(https?://[^\s\)]+)', best_snippet)
    if not url_match:
        url_match = re.search(r'source:\s*(https?://[^\s\)]+)', text)
    if url_match:
        first_url = url_match.group(1)

    value = numbers[0] if numbers else None
    confidence = _score_confidence(best_snippet, first_url, numbers)
    # Relevance penalty only for poor matches (<0.6), not for good ones
    if best_relevance < 0.6:
        confidence = round(confidence * (0.5 + best_relevance), 2)
    else:
        confidence = round(confidence, 2)

    fact_json = {
        "fact": best_snippet[:500],
        "value": value,
        "confidence": confidence,
        "source": first_url or "duckduckgo_search",
        "date": None,
    }

    return json.dumps(fact_json, ensure_ascii=False)


def _pick_best_snippet(snippets: list[str], question: str) -> tuple[str, float]:
    """Score each snippet by keyword overlap with question. Return best + relevance score."""
    q_terms = _extract_keywords(question)
    if not q_terms or not snippets:
        combined = "\n".join(snippets)[:300]
        return combined, 0.5

    best_text = snippets[0] if snippets else ""
    best_score = 0.0

    for snippet in snippets:
        if not snippet.strip():
            continue
        s_lower = snippet.lower()
        hits = sum(1 for t in q_terms if t in s_lower)
        score = hits / len(q_terms)
        if score > best_score:
            best_score = score
            best_text = snippet

    relevance = min(1.0, 0.5 + best_score * 0.5) if best_score > 0 else 0.4
    return best_text[:600], relevance


def _extract_keywords(text: str) -> list[str]:
    """Extract meaningful keywords from a question, ignoring stop words."""
    stop = {
        "what", "how", "is", "the", "a", "an", "in", "of", "for", "to", "and",
        "or", "are", "was", "were", "be", "been", "do", "does", "did", "will",
        "can", "could", "should", "would", "may", "might", "much", "many",
        "typical", "common",
    }
    import re
    words = re.findall(r'[a-zA-Z]{3,}', text.lower())
    return [w for w in words if w not in stop]


_AUTHORITY_DOMAINS = {
    ".gov": 0.15, ".edu": 0.12, "who.int": 0.12, "worldbank.org": 0.12,
    "statista.com": 0.10, "crunchbase.com": 0.08, "pitchbook.com": 0.08,
    "dealstreetasia.com": 0.08, "techcrunch.com": 0.06, "reuters.com": 0.08,
    "bloomberg.com": 0.08, "wikipedia.org": 0.05, "linkedin.com": 0.04,
}


def _score_confidence(text: str, url: str, numbers: list) -> float:
    score = 0.30
    if numbers:
        score += 0.10
    if len(numbers) >= 3:
        score += 0.08
    url_lower = url.lower()
    for domain, boost in _AUTHORITY_DOMAINS.items():
        if domain in url_lower:
            score += boost
            break
    text_lower = text.lower()
    if any(w in text_lower for w in ["according to", "reported", "data shows", "survey", "study"]):
        score += 0.05
    import re
    year_match = re.search(r'\b(202[3-9]|203\d)\b', text)
    if year_match:
        score += 0.08
    elif re.search(r'\b(202[0-2])\b', text):
        score += 0.03
    elif re.search(r'\b(201\d)\b', text):
        pass
    named_entities = re.findall(r'[A-Z][a-z]+(?:\s[A-Z][a-z]+)+', text)
    if named_entities and numbers:
        score += 0.07
    return min(0.82, round(score, 2))


def _fallback_search(question: str) -> str:
    """Fallback: use requests to hit DuckDuckGo HTML directly."""
    import requests
    try:
        resp = requests.get(
            "https://html.duckduckgo.com/html/",
            params={"q": question},
            headers={"User-Agent": "Mozilla/5.0"},
            timeout=10,
        )
        if resp.status_code == 200:
            text = resp.text[:2000]
            import re
            snippets = re.findall(r'class="result__snippet">(.*?)</a>', text)
            if snippets:
                combined = " ".join(s[:100] for s in snippets[:3])
                return json.dumps({
                    "fact": combined[:200],
                    "value": None,
                    "confidence": 0.35,
                    "source": "duckduckgo_html_fallback",
                    "date": None,
                }, ensure_ascii=False)
    except Exception:
        pass
    return ""


def create_research_fn(delay_s: float = 1.5) -> callable:
    """Factory: creates a rate-limited research function."""
    global _MIN_DELAY_S
    _MIN_DELAY_S = delay_s
    return ddg_research
