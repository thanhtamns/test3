"""
DimensionRegistry — 15+ analysis dimensions with weighted query templates.
Pure data + lookup. Zero LLM calls.
"""

from dataclasses import dataclass, field
from pathlib import Path
from typing import Optional


@dataclass
class Dimension:
    name: str
    weight: float
    templates: list[str] = field(default_factory=list)

    def to_dict(self) -> dict:
        return {"name": self.name, "weight": self.weight, "templates": self.templates}


