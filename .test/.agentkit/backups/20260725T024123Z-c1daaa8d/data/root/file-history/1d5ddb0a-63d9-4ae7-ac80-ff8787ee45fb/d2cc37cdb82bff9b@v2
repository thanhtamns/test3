import json, sys
from collections import Counter, defaultdict
sys.stdout.reconfigure(encoding='utf-8')

with open('unified_training_set.json', 'r', encoding='utf-8') as f:
    cases = json.load(f)

patterns = []

# Pattern 1: Success rate by money_flow_type
type_outcomes = defaultdict(lambda: defaultdict(int))
for c in cases:
    mft = c.get('money_flow_type', 'unknown')
    outcome = c.get('outcome', 'unknown')
    type_outcomes[mft][outcome] += 1
    type_outcomes[mft]['total'] += 1

for mft, counts in type_outcomes.items():
    total = counts['total']
    if total >= 3:
        sr = counts.get('success', 0) / total
        fr = counts.get('failure', 0) / total
        patterns.append({
            'id': f'PAT-MFT-{mft.upper().replace("_","-")}',
            'type': 'money_flow_type_base_rate',
            'description': f'{mft}: {sr:.0%} success, {fr:.0%} failure (n={total})',
            'money_flow_type': mft,
            'success_rate': round(sr, 3),
            'failure_rate': round(fr, 3),
            'sample_size': total,
            'confidence': min(0.95, 0.5 + total * 0.01)
        })

