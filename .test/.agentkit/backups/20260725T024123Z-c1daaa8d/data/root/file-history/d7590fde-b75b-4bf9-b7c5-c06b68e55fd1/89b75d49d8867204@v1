def _get_capital_usd(profile: dict) -> int:
    """Extract capital in USD from profile, handling various formats."""
    capital = profile.get("capital_usd")

    if capital is None:
        return 0

    if isinstance(capital, (int, float)):
        return int(capital)

    if isinstance(capital, dict):
        # Handle nested format: {"available_now": 1000, "can_raise": 5000}
        available = capital.get("available_now") or capital.get("available") or 0
        return int(available)

    if isinstance(capital, str):
        # Handle string format: "1000", "$1,000", "1K"
        clean = capital.replace("$", "").replace(",", "").strip().upper()
        if clean.endswith("K"):
            return int(float(clean[:-1]) * 1000)
        return int(float(clean))

    return 0


def _get_leverage_access(profile: dict) -> dict:
    """Compute leverage access score via LeverageMechanism. Falls back to score 0."""
    try:
        mi_path = str(Path(__file__).resolve().parents[3] / "money-intelligence")
        if mi_path not in sys.path:
            sys.path.insert(0, mi_path)
        from money_mechanisms.leverage import LeverageMechanism
        return LeverageMechanism.assess_founder_leverage_access(profile)
    except ImportError:
        return {
            "leverage_access_score": 0,
            "dimensions": {},
            "track_recommendation": "CASHFLOW_SEED",
        }


def classify(profile: dict) -> dict:
    """Classify founder profile into capital tier with dual-axis routing.

    Axis 1: capital_usd → TIER_0/1/2/3
    Axis 2: leverage_access_score → TIER_0 subtracks (MICRO_DEPLOY/ASSET_BUILDER/LEVERAGE_SPRINT)

    TIER_0 output includes deployment_budget, asset_slots, per_slot_budget.
    TIER_1/2/3 output is unchanged.
    """
    capital_usd = _get_capital_usd(profile)

    selected_tier = None
    for tier_name, tier_config in CAPITAL_TIERS.items():
        low, high = tier_config["range"]
        if high is None:
            if capital_usd >= low:
                selected_tier = tier_name
                break
        elif low <= capital_usd < high:
            selected_tier = tier_name
            break

    if not selected_tier:
        selected_tier = "TIER_0"

    tier_config = CAPITAL_TIERS[selected_tier]

    if tier_config.get("subtracks"):
        leverage = _get_leverage_access(profile)
        score = leverage.get("leverage_access_score", 0)

        matched_subtrack = None
        for subtrack_name, subtrack_config in TIER_0_SUBTRACKS.items():
            low, high = subtrack_config["leverage_range"]
            if low <= score <= high:
                matched_subtrack = subtrack_config
                break

        if not matched_subtrack:
            matched_subtrack = TIER_0_SUBTRACKS["MICRO_DEPLOY"]

        asset_slots = matched_subtrack["constraints"].get("min_assets", 3)
        per_slot_budget = capital_usd // asset_slots if capital_usd > 0 else 0

        return {
            "tier": selected_tier,
            "track": matched_subtrack["track"],
            "capital_usd": capital_usd,
            "leverage_access_score": score,
            "leverage_dimensions": leverage.get("dimensions", {}),
            "target_range": list(matched_subtrack["target_range"]),
            "timeline_days": list(matched_subtrack["timeline_days"]),
            "primary_hypothesis": matched_subtrack["primary_hypothesis"],
            "constraints": matched_subtrack["constraints"],
            "decision_question_codes": matched_subtrack["decision_question_codes"],
            "bridge_needed": False,
            "deployment_budget": capital_usd,
            "asset_slots": asset_slots,
            "per_slot_budget": per_slot_budget,
        }

    bridge_needed = selected_tier in ("TIER_0", "TIER_1")

    return {
        "tier": selected_tier,
        "track": tier_config["track"],
        "capital_usd": capital_usd,
        "leverage_access_score": 0,
        "leverage_dimensions": {},
        "target_range": list(tier_config["target_range"]),
        "timeline_days": list(tier_config["timeline_days"]),
        "primary_hypothesis": tier_config["primary_hypothesis"],
        "constraints": tier_config["constraints"],
        "decision_question_codes": tier_config["decision_question_codes"],
        "bridge_needed": bridge_needed,
    }


def main() -> None:
    ap = argparse.ArgumentParser(
        description="Classify founder into capital tier for stage0 routing"
    )
    group = ap.add_mutually_exclusive_group(required=True)
    group.add_argument("--profile-json", help="Profile JSON string")
    group.add_argument("--profile-file", help="Path to profile JSON file")
    args = ap.parse_args()

    if args.profile_json:
        try:
            profile = json.loads(args.profile_json)
        except json.JSONDecodeError as e:
            print(json.dumps({"error": f"invalid JSON: {e}"}))
            sys.exit(1)
    else:
        path = Path(args.profile_file)
        if not path.exists():
            print(json.dumps({"error": f"file not found: {path}"}))
            sys.exit(1)
        profile = json.loads(path.read_text(encoding="utf-8"))

    result = classify(profile)
    print(json.dumps(result, ensure_ascii=False, indent=2))


if __name__ == "__main__":
    main()
