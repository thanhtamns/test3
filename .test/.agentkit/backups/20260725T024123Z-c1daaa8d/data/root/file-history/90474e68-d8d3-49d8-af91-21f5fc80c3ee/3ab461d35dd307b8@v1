package clickhouse

import (
	"context"
	"fmt"
	"log/slog"
	"time"

	ch "github.com/ClickHouse/clickhouse-go/v2"
)

type Client struct {
	conn ch.Conn
}

type EventRow struct {
	EventID          string
	TenantID         string
	Timestamp        time.Time
	SessionID        string
	ProjectDir       string
	Command          string
	EventType        string
	InputBytes       uint64
	OutputBytes      uint64
	InputTokens      uint64
	OutputTokens     uint64
	TokensSaved      uint64
	FilterName       string
	CompressionLevel string
	LatencyMs        float64
	ContentHash      string
	CacheHit         bool
	CLIVersion       string
	MachineID        string
}

type OverviewStats struct {
	TotalInputTokens  uint64  `json:"total_input_tokens"`
	TotalOutputTokens uint64  `json:"total_output_tokens"`
	TotalSaved        uint64  `json:"total_saved"`
	SavingsPct        float64 `json:"savings_pct"`
	EventCount        uint64  `json:"event_count"`
	TopCommands       []CommandStat `json:"top_commands"`
}

type CommandStat struct {
	Command string `json:"command"`
	Saved   uint64 `json:"saved"`
	Count   uint64 `json:"count"`
}

func New(dsn string) (*Client, error) {
	opts, err := ch.ParseDSN(dsn)
	if err != nil {
		return nil, fmt.Errorf("parse dsn: %w", err)
	}

	conn, err := ch.Open(opts)
	if err != nil {
		return nil, fmt.Errorf("open connection: %w", err)
	}

	if err := conn.Ping(context.Background()); err != nil {
		return nil, fmt.Errorf("ping: %w", err)
	}

	return &Client{conn: conn}, nil
}

func (c *Client) Close() error {
	return c.conn.Close()
}

func (c *Client) InsertEvents(ctx context.Context, rows []EventRow) error {
	if len(rows) == 0 {
		return nil
	}

	batch, err := c.conn.PrepareBatch(ctx, `INSERT INTO codeflow.events (
		event_id, tenant_id, timestamp, session_id, project_dir, command,
		event_type, input_bytes, output_bytes, input_tokens, output_tokens,
		tokens_saved, filter_name, compression_level, latency_ms,
		content_hash, cache_hit, cli_version, machine_id
	)`)
	if err != nil {
		return fmt.Errorf("prepare batch: %w", err)
	}

	for _, r := range rows {
		cacheHitVal := uint8(0)
		if r.CacheHit {
			cacheHitVal = 1
		}
		if err := batch.Append(
			r.EventID, r.TenantID, r.Timestamp, r.SessionID, r.ProjectDir, r.Command,
			r.EventType, r.InputBytes, r.OutputBytes, r.InputTokens, r.OutputTokens,
			r.TokensSaved, r.FilterName, r.CompressionLevel, r.LatencyMs,
			r.ContentHash, cacheHitVal, r.CLIVersion, r.MachineID,
		); err != nil {
			return fmt.Errorf("append row: %w", err)
		}
	}

	return batch.Send()
}

func (c *Client) GetOverview(ctx context.Context, tenantID string) (*OverviewStats, error) {
	var stats OverviewStats

	row := c.conn.QueryRow(ctx, `
		SELECT
			sum(input_tokens) as total_input,
			sum(output_tokens) as total_output,
			sum(tokens_saved) as total_saved,
			count() as event_count
		FROM codeflow.events
		WHERE tenant_id = $1
	`, tenantID)

	if err := row.Scan(&stats.TotalInputTokens, &stats.TotalOutputTokens, &stats.TotalSaved, &stats.EventCount); err != nil {
		return nil, fmt.Errorf("overview query: %w", err)
	}

	if stats.TotalInputTokens > 0 {
		stats.SavingsPct = float64(stats.TotalSaved) / float64(stats.TotalInputTokens) * 100
	}

	rows, err := c.conn.Query(ctx, `
		SELECT command, sum(tokens_saved) as saved, count() as cnt
		FROM codeflow.events
		WHERE tenant_id = $1
		GROUP BY command
		ORDER BY saved DESC
		LIMIT 10
	`, tenantID)
	if err != nil {
		return nil, fmt.Errorf("top commands query: %w", err)
	}
	defer rows.Close()

	for rows.Next() {
		var cmd CommandStat
		if err := rows.Scan(&cmd.Command, &cmd.Saved, &cmd.Count); err != nil {
			slog.Warn("scan top commands row", "error", err)
			continue
		}
		stats.TopCommands = append(stats.TopCommands, cmd)
	}

	return &stats, nil
}

type ProjectSummary struct {
	ProjectDir  string  `json:"project_dir"`
	TotalSaved  uint64  `json:"total_saved"`
	TotalInput  uint64  `json:"total_input"`
	EventCount  uint64  `json:"event_count"`
	SavingsPct  float64 `json:"savings_pct"`
	LastEventAt string  `json:"last_event_at"`
}

func (c *Client) GetProjects(ctx context.Context, tenantID string) ([]ProjectSummary, error) {
	rows, err := c.conn.Query(ctx, `
		SELECT
			project_dir,
			sum(tokens_saved) AS total_saved,
			sum(input_tokens) AS total_input,
			count() AS event_count,
			max(timestamp) AS last_event
		FROM codeflow.events
		WHERE tenant_id = $1
		GROUP BY project_dir
		ORDER BY total_saved DESC
	`, tenantID)
	if err != nil {
		return nil, fmt.Errorf("projects query: %w", err)
	}
	defer rows.Close()

	var projects []ProjectSummary
	for rows.Next() {
		var p ProjectSummary
		var lastEvent time.Time
		if err := rows.Scan(&p.ProjectDir, &p.TotalSaved, &p.TotalInput, &p.EventCount, &lastEvent); err != nil {
			slog.Warn("scan projects row", "error", err)
			continue
		}
		if p.TotalInput > 0 {
			p.SavingsPct = float64(p.TotalSaved) / float64(p.TotalInput) * 100
		}
		p.LastEventAt = lastEvent.Format(time.RFC3339)
		projects = append(projects, p)
	}
	return projects, nil
}

type ProjectDailyStat struct {
	Day        string `json:"day"`
	TotalSaved uint64 `json:"total_saved"`
	TotalInput uint64 `json:"total_input"`
	EventCount uint64 `json:"event_count"`
}

type ProjectStats struct {
	ProjectDir string             `json:"project_dir"`
	Summary    ProjectSummary     `json:"summary"`
	Daily      []ProjectDailyStat `json:"daily"`
	TopFilters []CommandStat      `json:"top_filters"`
}

func (c *Client) GetProjectStats(ctx context.Context, tenantID, projectDir string) (*ProjectStats, error) {
	ps := &ProjectStats{ProjectDir: projectDir}

	row := c.conn.QueryRow(ctx, `
		SELECT
			sum(tokens_saved), sum(input_tokens), count(), max(timestamp)
		FROM codeflow.events
		WHERE tenant_id = $1 AND project_dir = $2
	`, tenantID, projectDir)

	var lastEvent time.Time
	if err := row.Scan(&ps.Summary.TotalSaved, &ps.Summary.TotalInput, &ps.Summary.EventCount, &lastEvent); err != nil {
		return nil, fmt.Errorf("project summary query: %w", err)
	}
	ps.Summary.ProjectDir = projectDir
	ps.Summary.LastEventAt = lastEvent.Format(time.RFC3339)
	if ps.Summary.TotalInput > 0 {
		ps.Summary.SavingsPct = float64(ps.Summary.TotalSaved) / float64(ps.Summary.TotalInput) * 100
	}

	dailyRows, err := c.conn.Query(ctx, `
		SELECT
			toDate(timestamp) AS day,
			sum(tokens_saved) AS total_saved,
			sum(input_tokens) AS total_input,
			count() AS event_count
		FROM codeflow.events
		WHERE tenant_id = $1 AND project_dir = $2
		GROUP BY day
		ORDER BY day
	`, tenantID, projectDir)
	if err != nil {
		return nil, fmt.Errorf("project daily query: %w", err)
	}
	defer dailyRows.Close()

	for dailyRows.Next() {
		var d ProjectDailyStat
		var day time.Time
		if err := dailyRows.Scan(&day, &d.TotalSaved, &d.TotalInput, &d.EventCount); err != nil {
			slog.Warn("scan project daily row", "error", err)
			continue
		}
		d.Day = day.Format("2006-01-02")
		ps.Daily = append(ps.Daily, d)
	}

	filterRows, err := c.conn.Query(ctx, `
		SELECT command, sum(tokens_saved) AS saved, count() AS cnt
		FROM codeflow.events
		WHERE tenant_id = $1 AND project_dir = $2
		GROUP BY command
		ORDER BY saved DESC
		LIMIT 10
	`, tenantID, projectDir)
	if err != nil {
		return nil, fmt.Errorf("project filters query: %w", err)
	}
	defer filterRows.Close()

	for filterRows.Next() {
		var f CommandStat
		if err := filterRows.Scan(&f.Command, &f.Saved, &f.Count); err != nil {
			slog.Warn("scan project filters row", "error", err)
			continue
		}
		ps.TopFilters = append(ps.TopFilters, f)
	}

	return ps, nil
}

type DailySavings struct {
	Day         string `json:"day"`
	TotalSaved  uint64 `json:"total_saved"`
	TotalInput  uint64 `json:"total_input"`
	EventCount  uint64 `json:"event_count"`
	Compression uint64 `json:"compression_saved"`
	Dedup       uint64 `json:"dedup_saved"`
}

func (c *Client) GetSavingsTrend(ctx context.Context, tenantID string, days int) ([]DailySavings, error) {
	if days <= 0 || days > 365 {
		days = 30
	}

	query := fmt.Sprintf(`
		SELECT
			toDate(timestamp) AS day,
			sum(tokens_saved) AS total_saved,
			sum(input_tokens) AS total_input,
			count() AS event_count,
			sumIf(tokens_saved, event_type = 'compression') AS compression_saved,
			sumIf(tokens_saved, event_type = 'dedup') AS dedup_saved
		FROM codeflow.events
		WHERE tenant_id = $1
			AND timestamp >= now() - INTERVAL %d DAY
		GROUP BY day
		ORDER BY day
	`, days)
	rows, err := c.conn.Query(ctx, query, tenantID)
	if err != nil {
		return nil, fmt.Errorf("savings trend query: %w", err)
	}
	defer rows.Close()

	var trend []DailySavings
	for rows.Next() {
		var d DailySavings
		var day time.Time
		if err := rows.Scan(&day, &d.TotalSaved, &d.TotalInput, &d.EventCount, &d.Compression, &d.Dedup); err != nil {
			slog.Warn("scan savings trend row", "error", err)
			continue
		}
		d.Day = day.Format("2006-01-02")
		trend = append(trend, d)
	}
	return trend, nil
}
