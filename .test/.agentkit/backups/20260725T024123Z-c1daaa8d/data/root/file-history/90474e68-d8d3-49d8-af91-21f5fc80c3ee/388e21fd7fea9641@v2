package main

import (
	"context"
	"log/slog"
	"os"
	"strconv"
	"time"

	"github.com/codeflow-dev/codeflow/cloud/internal/clickhouse"
	"github.com/codeflow-dev/codeflow/cloud/internal/waste"
)

func main() {
	logger := slog.New(slog.NewJSONHandler(os.Stdout, &slog.HandlerOptions{Level: slog.LevelInfo}))
	slog.SetDefault(logger)

	chDSN := envOr("CLICKHOUSE_DSN", "clickhouse://localhost:9000/codeflow")
	tenantID := envOr("TENANT_ID", "demo-tenant")
	lookbackMinutes := 60 * 24 * 30 // 30 days default
	if v := os.Getenv("LOOKBACK_MINUTES"); v != "" {
		if parsed, err := strconv.Atoi(v); err == nil && parsed > 0 {
			lookbackMinutes = parsed
		}
	}

	ch, err := clickhouse.New(chDSN)
	if err != nil {
		slog.Error("failed to connect to clickhouse", "error", err)
		os.Exit(1)
	}
	defer ch.Close()

	slog.Info("waste detector starting", "tenant", tenantID, "lookback_minutes", lookbackMinutes)

	ctx := context.Background()
	since := time.Now().Add(-time.Duration(lookbackMinutes) * time.Minute)

	sessionIDs, err := ch.GetRecentSessionIDs(ctx, tenantID, since)
	if err != nil {
		slog.Error("failed to get recent sessions", "error", err)
		os.Exit(1)
	}

	if len(sessionIDs) == 0 {
		slog.Info("no recent sessions to analyze")
		return
	}

	slog.Info("analyzing sessions", "count", len(sessionIDs))

	sessionEvents, err := ch.GetSessionEvents(ctx, tenantID, sessionIDs)
	if err != nil {
		slog.Error("failed to get session events", "error", err)
		os.Exit(1)
	}

	var allFindings []clickhouse.WasteFinding
	for sessionID, events := range sessionEvents {
		if len(events) < 3 {
			continue
		}

		wasteEvents := make([]waste.Event, 0, len(events))
		projectDir := ""
		for _, e := range events {
			if projectDir == "" {
				projectDir = e.ProjectDir
			}
			wasteEvents = append(wasteEvents, waste.Event{
				EventID:     e.EventID,
				SessionID:   e.SessionID,
				TenantID:    e.TenantID,
				ProjectDir:  e.ProjectDir,
				Command:     e.Command,
				EventType:   e.EventType,
				ContentHash: e.ContentHash,
				InputTokens: e.InputTokens,
				Timestamp:   e.Timestamp,
			})
		}

		session := waste.SessionEvents{
			SessionID:  sessionID,
			TenantID:   tenantID,
			ProjectDir: projectDir,
			Events:     wasteEvents,
		}

		findings := waste.Analyze(session)
		for _, f := range findings {
			allFindings = append(allFindings, clickhouse.WasteFinding{
				TenantID:     f.TenantID,
				SessionID:    f.SessionID,
				ProjectDir:   f.ProjectDir,
				PatternType:  f.PatternType,
				Command:      f.Command,
				Occurrences:  uint32(f.Occurrences),
				TokensWasted: f.TokensWasted,
				Suggestion:   f.Suggestion,
			})
		}
	}

	if len(allFindings) == 0 {
		slog.Info("no waste patterns found")
		return
	}

	if err := ch.InsertWasteFindings(ctx, allFindings); err != nil {
		slog.Error("failed to insert waste findings", "error", err)
		os.Exit(1)
	}

	slog.Info("waste analysis complete",
		"sessions_analyzed", len(sessionEvents),
		"findings", len(allFindings),
	)
}

func envOr(key, fallback string) string {
	if v := os.Getenv(key); v != "" {
		return v
	}
	return fallback
}
