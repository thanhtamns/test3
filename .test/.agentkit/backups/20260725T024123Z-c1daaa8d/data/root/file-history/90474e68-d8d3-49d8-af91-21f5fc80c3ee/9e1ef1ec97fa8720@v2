use std::path::Path;

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum ModelTier {
    Haiku,
    Sonnet,
    Opus,
}

impl ModelTier {
    pub fn name(&self) -> &'static str {
        match self {
            ModelTier::Haiku => "haiku",
            ModelTier::Sonnet => "sonnet",
            ModelTier::Opus => "opus",
        }
    }

    pub fn cost_per_million_tokens(&self) -> f64 {
        match self {
            ModelTier::Haiku => 0.25,
            ModelTier::Sonnet => 3.0,
            ModelTier::Opus => 15.0,
        }
    }
}

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum Complexity {
    Low,
    Medium,
    High,
}

pub struct RoutingInput {
    pub command: String,
    pub context_tokens: u64,
    pub file_extensions: Vec<String>,
    pub session_event_count: u64,
}

pub struct RoutingDecision {
    pub tier: ModelTier,
    pub complexity: Complexity,
    pub score: f64,
    pub reason: String,
    pub estimated_savings_pct: f64,
}

pub fn classify(input: &RoutingInput) -> RoutingDecision {
    let mut score: f64 = 0.5;
    let mut reasons = Vec::new();

    // Command complexity
    let cmd_score = command_complexity(&input.command);
    score += cmd_score;
    if cmd_score.abs() > 0.05 {
        reasons.push(format!(
            "command '{}' complexity {:.2}",
            first_word(&input.command),
            cmd_score
        ));
    }

    // Context size
    let ctx_score = context_complexity(input.context_tokens);
    score += ctx_score;
    if ctx_score.abs() > 0.05 {
        reasons.push(format!("context {}K tokens {:.2}", input.context_tokens / 1000, ctx_score));
    }

    // File type complexity
    let ext_score = file_extension_complexity(&input.file_extensions);
    score += ext_score;
    if ext_score.abs() > 0.05 {
        reasons.push(format!("file types {:.2}", ext_score));
    }

    // Session stage
    let stage_score = session_stage_complexity(input.session_event_count);
    score += stage_score;
    if stage_score.abs() > 0.05 {
        reasons.push(format!("session stage {:.2}", stage_score));
    }

    score = score.clamp(0.0, 1.0);

    let (complexity, tier) = if score < 0.3 {
        (Complexity::Low, ModelTier::Haiku)
    } else if score < 0.7 {
        (Complexity::Medium, ModelTier::Sonnet)
    } else {
        (Complexity::High, ModelTier::Opus)
    };

    let default_cost = ModelTier::Opus.cost_per_million_tokens();
    let routed_cost = tier.cost_per_million_tokens();
    let savings_pct = if default_cost > 0.0 {
        (1.0 - routed_cost / default_cost) * 100.0
    } else {
        0.0
    };

    RoutingDecision {
        tier,
        complexity,
        score,
        reason: reasons.join(", "),
        estimated_savings_pct: savings_pct,
    }
}

fn first_word(cmd: &str) -> &str {
    cmd.split_whitespace().next().unwrap_or(cmd)
}

fn command_complexity(command: &str) -> f64 {
    let cmd = command.to_lowercase();
    let first = first_word(&cmd);

    let low_commands = [
        "git status", "git log", "git branch", "git diff --stat",
        "ls", "pwd", "cat", "head", "tail", "wc", "echo", "which", "whoami",
        "npm --version", "node --version", "cargo --version",
    ];

    let high_commands = [
        "refactor", "architect", "design", "implement", "migrate",
        "review", "analyze", "debug", "optimize", "rewrite",
    ];

    for lc in &low_commands {
        if cmd.starts_with(lc) {
            return -0.3;
        }
    }

    for hc in &high_commands {
        if cmd.contains(hc) {
            return 0.3;
        }
    }

    match first {
        "git" => -0.15,
        "ls" | "find" | "grep" | "cat" | "head" | "tail" => -0.2,
        "npm" | "pnpm" | "yarn" | "pip" | "cargo" => -0.1,
        "docker" | "kubectl" => 0.05,
        "python" | "node" | "go" | "rustc" => 0.1,
        _ => 0.0,
    }
}

fn context_complexity(tokens: u64) -> f64 {
    match tokens {
        0..=1000 => -0.15,
        1001..=5000 => -0.05,
        5001..=20000 => 0.05,
        20001..=50000 => 0.15,
        _ => 0.25,
    }
}

fn file_extension_complexity(extensions: &[String]) -> f64 {
    if extensions.is_empty() {
        return 0.0;
    }

    let mut total = 0.0;
    for ext in extensions {
        total += match ext.as_str() {
            "md" | "txt" | "json" | "yaml" | "yml" | "toml" => -0.1,
            "html" | "css" | "scss" => -0.05,
            "js" | "ts" | "jsx" | "tsx" => 0.05,
            "py" | "rb" | "go" | "java" | "kt" => 0.1,
            "rs" | "cpp" | "c" | "h" => 0.15,
            "sql" | "graphql" | "proto" => 0.1,
            _ => 0.0,
        };
    }

    (total / extensions.len() as f64).clamp(-0.2, 0.2)
}

fn session_stage_complexity(event_count: u64) -> f64 {
    match event_count {
        0..=5 => -0.1,
        6..=20 => 0.0,
        21..=50 => 0.05,
        _ => 0.1,
    }
}

pub fn extensions_from_paths(paths: &[&str]) -> Vec<String> {
    let mut exts: Vec<String> = paths
        .iter()
        .filter_map(|p| Path::new(p).extension())
        .filter_map(|e| e.to_str())
        .map(|e| e.to_lowercase())
        .collect();
    exts.sort();
    exts.dedup();
    exts
}

#[cfg(test)]
mod tests {
    use super::*;

    fn input(cmd: &str, tokens: u64, exts: &[&str], events: u64) -> RoutingInput {
        RoutingInput {
            command: cmd.to_string(),
            context_tokens: tokens,
            file_extensions: exts.iter().map(|e| e.to_string()).collect(),
            session_event_count: events,
        }
    }

    #[test]
    fn test_simple_command_routes_to_haiku() {
        let decision = classify(&input("git status", 500, &[], 2));
        assert_eq!(decision.tier, ModelTier::Haiku);
        assert_eq!(decision.complexity, Complexity::Low);
        assert!(decision.estimated_savings_pct > 95.0);
    }

    #[test]
    fn test_complex_command_routes_to_opus() {
        let decision = classify(&input("implement auth middleware", 60000, &["rs", "toml"], 40));
        assert_eq!(decision.tier, ModelTier::Opus);
        assert_eq!(decision.complexity, Complexity::High);
    }

    #[test]
    fn test_medium_command_routes_to_sonnet() {
        let decision = classify(&input("cargo test", 10000, &["rs"], 15));
        assert_eq!(decision.tier, ModelTier::Sonnet);
        assert_eq!(decision.complexity, Complexity::Medium);
    }

    #[test]
    fn test_ls_routes_to_haiku() {
        let decision = classify(&input("ls -la", 200, &[], 1));
        assert_eq!(decision.tier, ModelTier::Haiku);
    }

    #[test]
    fn test_refactor_routes_high() {
        let decision = classify(&input("refactor the auth module", 30000, &["ts", "tsx"], 30));
        assert!(decision.score >= 0.7);
        assert_eq!(decision.tier, ModelTier::Opus);
    }

    #[test]
    fn test_large_context_increases_complexity() {
        let small = classify(&input("npm test", 500, &["js"], 10));
        let large = classify(&input("npm test", 80000, &["js"], 10));
        assert!(large.score > small.score);
    }

    #[test]
    fn test_score_clamped_to_0_1() {
        let low = classify(&input("git status", 100, &["md"], 1));
        assert!(low.score >= 0.0);
        assert!(low.score <= 1.0);

        let high = classify(&input("implement refactor optimize rewrite", 100000, &["rs", "cpp"], 100));
        assert!(high.score >= 0.0);
        assert!(high.score <= 1.0);
    }

    #[test]
    fn test_savings_pct_haiku() {
        let decision = classify(&input("ls", 100, &[], 1));
        assert_eq!(decision.tier, ModelTier::Haiku);
        let expected = (1.0 - 0.25 / 15.0) * 100.0;
        assert!((decision.estimated_savings_pct - expected).abs() < 0.1);
    }

    #[test]
    fn test_extensions_from_paths() {
        let paths = &["src/main.rs", "Cargo.toml", "src/lib.rs", "README.md"];
        let exts = extensions_from_paths(paths);
        assert_eq!(exts, vec!["md", "rs", "toml"]);
    }

    #[test]
    fn test_model_tier_names() {
        assert_eq!(ModelTier::Haiku.name(), "haiku");
        assert_eq!(ModelTier::Sonnet.name(), "sonnet");
        assert_eq!(ModelTier::Opus.name(), "opus");
    }
}
