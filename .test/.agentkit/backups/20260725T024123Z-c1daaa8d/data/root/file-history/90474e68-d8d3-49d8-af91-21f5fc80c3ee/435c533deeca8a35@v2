package waste

import (
	"testing"
	"time"
)

func session(events ...Event) SessionEvents {
	s := SessionEvents{
		SessionID:  "test-session",
		TenantID:   "test-tenant",
		ProjectDir: "/test/project",
		Events:     events,
	}
	return s
}

func event(cmd, eventType, hash string, tokens uint64) Event {
	return Event{
		EventID:     "e-" + cmd,
		SessionID:   "test-session",
		TenantID:    "test-tenant",
		ProjectDir:  "/test/project",
		Command:     cmd,
		EventType:   eventType,
		ContentHash: hash,
		InputTokens: tokens,
		Timestamp:   time.Now(),
	}
}

func TestRedundantCommands_Detected(t *testing.T) {
	s := session(
		event("git status", "compression", "hash-a", 500),
		event("git status", "compression", "hash-a", 500),
		event("git status", "compression", "hash-a", 500),
	)

	findings := Analyze(s)
	found := findByPattern(findings, "redundant_command")
	if found == nil {
		t.Fatal("expected redundant_command finding")
	}
	if found.Occurrences != 3 {
		t.Fatalf("expected 3 occurrences, got %d", found.Occurrences)
	}
	if found.TokensWasted != 1000 {
		t.Fatalf("expected 1000 wasted (2 redundant × 500), got %d", found.TokensWasted)
	}
}

func TestRedundantCommands_DifferentHash_NotRedundant(t *testing.T) {
	s := session(
		event("git status", "compression", "hash-a", 500),
		event("git status", "compression", "hash-b", 500),
	)

	findings := Analyze(s)
	found := findByPattern(findings, "redundant_command")
	if found != nil {
		t.Fatal("different hashes should not be redundant")
	}
}

func TestRedundantCommands_EmptyHash_Skipped(t *testing.T) {
	s := session(
		event("git status", "compression", "", 500),
