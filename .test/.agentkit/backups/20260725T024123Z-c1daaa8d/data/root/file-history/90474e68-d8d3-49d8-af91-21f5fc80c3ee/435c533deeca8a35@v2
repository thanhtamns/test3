func TestBuildLoop_Detected(t *testing.T) {
	s := session(
		event("cargo test", "compression", "h1", 1000),
		event("cargo test", "compression", "h2", 1000),
		event("cargo test", "compression", "h3", 1000),
	)

	findings := Analyze(s)
	found := findByPattern(findings, "build_loop")
	if found == nil {
		t.Fatal("expected build_loop finding")
	}
	if found.Occurrences != 3 {
		t.Fatalf("expected 3 occurrences, got %d", found.Occurrences)
	}
	if found.TokensWasted != 1500 {
		t.Fatalf("expected 1500 wasted (3000/2), got %d", found.TokensWasted)
	}
}

