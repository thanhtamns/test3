func TestAnalyze_MultiplePatterns(t *testing.T) {
	s := session(
		event("git status", "compression", "hash-a", 500),
		event("git status", "compression", "hash-a", 500),
		event("cat main.rs", "dedup", "h1", 800),
		event("cat main.rs", "dedup", "h1", 800),
		event("cat main.rs", "dedup", "h1", 800),
		event("cargo test", "compression", "h2", 1000),
		event("cargo test", "compression", "h3", 1000),
		event("cargo test", "compression", "h4", 1000),
	)

	findings := Analyze(s)
	// 4 findings: redundant_command(git status) + redundant_command(cat main.rs) + re_read_waste(cat main.rs) + build_loop(cargo test)
	if len(findings) != 4 {
		t.Fatalf("expected 4 findings, got %d", len(findings))
	}
}

func TestAnalyze_EmptySession(t *testing.T) {
	s := session()
	findings := Analyze(s)
	if len(findings) != 0 {
		t.Fatalf("expected 0 findings for empty session, got %d", len(findings))
	}
}

func findByPattern(findings []Finding, pattern string) *Finding {
	for _, f := range findings {
		if f.PatternType == pattern {
			return &f
		}
	}
	return nil
}
