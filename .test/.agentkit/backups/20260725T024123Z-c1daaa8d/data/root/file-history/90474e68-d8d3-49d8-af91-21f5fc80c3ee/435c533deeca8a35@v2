func TestReReadWaste_Detected(t *testing.T) {
	s := session(
		event("cat main.rs", "dedup", "h1", 800),
		event("cat main.rs", "dedup", "h1", 800),
		event("cat main.rs", "dedup", "h1", 800),
		event("cat main.rs", "dedup", "h1", 800),
	)

	findings := Analyze(s)
	found := findByPattern(findings, "re_read_waste")
	if found == nil {
		t.Fatal("expected re_read_waste finding")
	}
	if found.Occurrences != 4 {
		t.Fatalf("expected 4 occurrences, got %d", found.Occurrences)
	}
	if found.TokensWasted != 2400 {
		t.Fatalf("expected 2400 wasted (3 redundant × 800), got %d", found.TokensWasted)
	}
}

