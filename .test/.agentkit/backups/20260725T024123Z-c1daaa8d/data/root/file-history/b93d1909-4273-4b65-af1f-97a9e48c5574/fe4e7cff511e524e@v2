'use strict';

function classifyGaps(failedChecks) {
  const result = { critical: [], major: [], minor: [] };

  for (const check of failedChecks) {
    const severity = check.severity || 'minor';
    const gap = {
      id: check.id,
      severity,
      dimension: check.dimension || 'unknown',
      description: check.description || `Failed check: ${check.id}`,
      fix: check.fix || null
    };

    if (severity === 'critical') result.critical.push(gap);
    else if (severity === 'major') result.major.push(gap);
    else result.minor.push(gap);
  }

  return result;
}

function getAllActionable(classified) {
  return [...classified.critical, ...classified.major];
}

module.exports = { classifyGaps, getAllActionable };
