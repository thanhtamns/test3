    def test_parse_float_helper(self, tmp_path):
        runner = ThinkRunner(
            research_fn=_make_research_fn(),
            vectors_db=tmp_path / "v.db",
            evolution_db=tmp_path / "e.db",
        )
        assert runner._parse_float(3.14) == 3.14
        assert runner._parse_float("2.5") == 2.5
        assert runner._parse_float(None) is None
        assert runner._parse_float("abc") is None

    def test_map_dim_known(self, tmp_path):
        runner = ThinkRunner(
            research_fn=_make_research_fn(),
            vectors_db=tmp_path / "v.db",
            evolution_db=tmp_path / "e.db",
        )
        assert runner._map_dim("base_rates") == "base_rates"
        assert runner._map_dim("moat_patterns") == "moat_patterns"
        assert runner._map_dim("execution_distance") == "execution_distance"
        assert runner._map_dim("power_position") == "power_position"

    def test_map_dim_unknown_defaults(self, tmp_path):
        runner = ThinkRunner(
            research_fn=_make_research_fn(),
            vectors_db=tmp_path / "v.db",
            evolution_db=tmp_path / "e.db",
        )
        assert runner._map_dim("unknown_dimension") == "unknown_dimension"

    def test_think_multiple_queries_sequential(self, tmp_path):
        runner = ThinkRunner(
            research_fn=_make_research_fn(),
            vectors_db=tmp_path / "v.db",
            evolution_db=tmp_path / "e.db",
        )
        r1 = runner.think("SaaS market entry")
        r2 = runner.think("career path fund manager")
        assert r1.query_type != r2.query_type or True
        assert r1.overall_score >= 0 and r2.overall_score >= 0

    def test_think_evolved_weights_loaded(self, tmp_path):
        evo_db = tmp_path / "evo.db"
        runner = ThinkRunner(
            research_fn=_make_research_fn(),
            vectors_db=tmp_path / "v.db",
            evolution_db=evo_db,
        )
        runner.think("SaaS market")
        weights = runner.evolver.get_evolved_weights()
        assert isinstance(weights, dict)


# ── Stage0Bridge ────────────────────────────────────────────────────────────


class TestStage0Bridge:
    def test_pre_decompose_enriches_case(self, tmp_path):
        bridge = Stage0Bridge(
            research_fn=_make_research_fn(),
            vectors_db=tmp_path / "v.db",
        )
        case = {"opportunity_description": "SaaS helpdesk for SMBs"}
        result = bridge.pre_decompose(case)
        assert "pre_decomposition_facts" in result
        assert "pre_decomposition_meta" in result
        assert result["pre_decomposition_meta"]["queries_fired"] > 0

    def test_pre_decompose_uses_description_field(self, tmp_path):
        bridge = Stage0Bridge(
            research_fn=_make_research_fn(),
            vectors_db=tmp_path / "v.db",
        )
        case = {"description": "Coffee export from Vietnam"}
        result = bridge.pre_decompose(case)
        assert "pre_decomposition_facts" in result

    def test_pre_decompose_uses_query_field(self, tmp_path):
        bridge = Stage0Bridge(
            research_fn=_make_research_fn(),
            vectors_db=tmp_path / "v.db",
        )
        case = {"query": "How to enter Japan market?"}
        result = bridge.pre_decompose(case)
        assert "pre_decomposition_facts" in result

    def test_pre_decompose_empty_returns_original(self, tmp_path):
        bridge = Stage0Bridge(
            research_fn=_make_research_fn(),
            vectors_db=tmp_path / "v.db",
        )
        case = {"id": 123}
        result = bridge.pre_decompose(case)
        assert result == case
        assert "pre_decomposition_facts" not in result

    def test_pre_decompose_error_returns_original(self, tmp_path):
        def boom(prompt):
            raise RuntimeError("explosion")
        bridge = Stage0Bridge(research_fn=boom, vectors_db=tmp_path / "v.db")
        case = {"opportunity_description": "test"}
        result = bridge.pre_decompose(case)
        assert result is case

    def test_pre_decompose_max_queries_capped(self, tmp_path):
        call_count = 0
        def counting_fn(prompt):
            nonlocal call_count
            call_count += 1
            return json.dumps({"fact": "f", "value": 1, "confidence": 0.5, "source": "s", "date": "2025-01"})
        bridge = Stage0Bridge(research_fn=counting_fn, vectors_db=tmp_path / "v.db")
        case = {"opportunity_description": "Big complex multi-market SaaS with competitors and moats"}
        bridge.pre_decompose(case)
        assert call_count <= MAX_QUERIES_STAGE0

    def test_pre_decompose_meta_structure(self, tmp_path):
        bridge = Stage0Bridge(
            research_fn=_make_research_fn(),
            vectors_db=tmp_path / "v.db",
        )
        case = {"opportunity_description": "Dropshipping from China"}
        result = bridge.pre_decompose(case)
        meta = result["pre_decomposition_meta"]
        assert "dimensions_decomposed" in meta
        assert "queries_fired" in meta
        assert "facts_pre_loaded" in meta
        assert "facts_stored" in meta
        assert "duration_ms" in meta
        assert isinstance(meta["duration_ms"], int)

    def test_pre_decompose_facts_structure(self, tmp_path):
        bridge = Stage0Bridge(
            research_fn=_make_research_fn(),
            vectors_db=tmp_path / "v.db",
        )
        case = {"opportunity_description": "SaaS for dentists"}
        result = bridge.pre_decompose(case)
        facts = result["pre_decomposition_facts"]
        if facts:
            f = facts[0]
            assert "query" in f
            assert "dimension" in f
            assert "fact" in f

    def test_pre_decompose_preserves_existing_case_fields(self, tmp_path):
        bridge = Stage0Bridge(
            research_fn=_make_research_fn(),
            vectors_db=tmp_path / "v.db",
        )
        case = {"opportunity_description": "SaaS market", "id": 42, "score": 0.7}
        result = bridge.pre_decompose(case)
        assert result["id"] == 42
        assert result["score"] == 0.7
