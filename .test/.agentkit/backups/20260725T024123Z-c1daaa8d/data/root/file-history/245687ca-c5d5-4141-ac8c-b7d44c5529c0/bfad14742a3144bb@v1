"""
Prediction Extractor - Phase 2 of Evolution Architecture
Parses advisory command output and extracts structured prediction cards.
"""

import re
import json
import hashlib
from datetime import datetime, timedelta
from pathlib import Path
from typing import List, Dict, Any, Optional, Tuple
from dataclasses import dataclass, asdict

# Import validator from Phase 1
