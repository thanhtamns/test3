syntax = "proto3";

package codeflow.events;

import "google/protobuf/timestamp.proto";

enum EventType {
  EVENT_TYPE_UNSPECIFIED = 0;
  EVENT_TYPE_PROVENANCE = 1;
  EVENT_TYPE_COST = 2;
  EVENT_TYPE_GOVERNANCE = 3;
  EVENT_TYPE_QUALITY = 4;
  EVENT_TYPE_COMPLIANCE = 5;
  EVENT_TYPE_SESSION = 6;
  EVENT_TYPE_AUDIT = 7;
}

enum ContributorType {
  CONTRIBUTOR_TYPE_UNKNOWN = 0;
  CONTRIBUTOR_TYPE_HUMAN = 1;
  CONTRIBUTOR_TYPE_AI = 2;
  CONTRIBUTOR_TYPE_MIXED = 3;
}

enum GovernanceVerdict {
  GOVERNANCE_VERDICT_UNSPECIFIED = 0;
  GOVERNANCE_VERDICT_ALLOW = 1;
  GOVERNANCE_VERDICT_WARN = 2;
  GOVERNANCE_VERDICT_BLOCK = 3;
}

message ProvenanceEvent {
  string record_id = 1;
  string model_id = 2;
  string model_version = 3;
  string prompt_hash = 4;
  string code_hash = 5;
  string file_path = 6;
  uint32 start_line = 7;
  uint32 end_line = 8;
  ContributorType contributor_type = 9;
  string attestation_sig = 10;
  string developer_id = 11;
  string session_id = 12;
  google.protobuf.Timestamp timestamp = 13;
}

message CostEvent {
  string session_id = 1;
  string model_id = 2;
  uint64 input_tokens = 3;
  uint64 output_tokens = 4;
  uint64 cache_read_tokens = 5;
  uint64 cache_write_tokens = 6;
  double cost_usd = 7;
  string project_path = 8;
  string task_label = 9;
  google.protobuf.Timestamp timestamp = 10;
}

message GovernanceEvent {
  string policy_id = 1;
  string rule_name = 2;
  GovernanceVerdict verdict = 3;
  string reason = 4;
  string session_id = 5;
  string model_id = 6;
  double budget_used = 7;
  double budget_limit = 8;
  google.protobuf.Timestamp timestamp = 9;
}

message QualityEvent {
  string check_id = 1;
  string check_type = 2;
  bool passed = 3;
  string file_path = 4;
  string detail = 5;
  string session_id = 6;
  google.protobuf.Timestamp timestamp = 7;
}

message EventEnvelope {
  string event_id = 1;
  EventType event_type = 2;
  google.protobuf.Timestamp timestamp = 3;
  string source_agent = 4;
  string project_path = 5;

  oneof payload {
    ProvenanceEvent provenance = 10;
    CostEvent cost = 11;
    GovernanceEvent governance = 12;
    QualityEvent quality = 13;
  }
}
