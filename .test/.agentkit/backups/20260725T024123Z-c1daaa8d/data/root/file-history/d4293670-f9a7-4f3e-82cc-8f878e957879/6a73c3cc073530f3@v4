[package]
name = "codeflow"
version = "0.40.0"
edition = "2021"
rust-version = "1.91"
authors = ["Patrick Szymkowiak"]
description = "AI Code Supply Chain OS — provenance, cost attribution, quality gates, compliance export"
license = "Apache 2.0"
homepage = "https://codeflow.dev"
repository = "https://github.com/codeflow-ai/codeflow"
readme = "README.md"
keywords = ["cli", "ai", "provenance", "compliance", "code-supply-chain"]
categories = ["command-line-utilities", "development-tools"]

[[bin]]
name = "codeflow"
path = "src/main.rs"

[[bin]]
name = "rtk"
path = "src/main.rs"

[dependencies]
clap = { version = "4", features = ["derive"] }
anyhow = "1.0"
ignore = "0.4"
walkdir = "2"
regex = "1"
lazy_static = "1.4"
serde = { version = "1", features = ["derive"] }
serde_json = { version = "1", features = ["preserve_order"] }
colored = "2"
dirs = "5"
rusqlite = { version = "0.31", features = ["bundled"] }
toml = "0.8"
chrono = "0.4"
tempfile = "3"
sha2 = "0.10"
ureq = "2"
getrandom = "0.4"
flate2 = "1.0"
quick-xml = "0.37"
which = "8"
automod = "1"
prost = "0.13"
prost-types = "0.13"
ed25519-dalek = { version = "2", features = ["rand_core"] }
blake3 = "1"
rand = "0.8"
hex = "0.4"
base64 = "0.22"

[target.'cfg(unix)'.dependencies]
libc = "0.2"

[build-dependencies]
toml = "0.8"
prost-build = "0.13"

[dev-dependencies]

[profile.release]
opt-level = 3
lto = true
codegen-units = 1
panic = "abort"
strip = true

# cargo-deb configuration
[package.metadata.deb]
maintainer = "Patrick Szymkowiak"
copyright = "2024 Patrick Szymkowiak"
license-file = ["LICENSE", "0"]
extended-description = "codeflow filters and compresses command outputs before they reach your LLM context, saving 60-90% of tokens."
section = "utility"
priority = "optional"
assets = [
    ["target/release/codeflow", "usr/bin/", "755"],
]
# cargo-generate-rpm configuration
[package.metadata.generate-rpm]
assets = [
    { source = "target/release/codeflow", dest = "/usr/bin/codeflow", mode = "755" },
]

[lints.rust]
unsafe_code = "deny"
warnings = "deny"
