# --- Test HypothesisGenerator ---

def test_hypothesis_from_gaps():
    g = MoneyFlowGraph()
    g.add_node("SME", "PAYER", confidence=0.3)
    g.add_node("Provider", "PROVIDER")
    gen = HypothesisGenerator()
    hypotheses = gen.generate(g, "compliance", cycle=0)
    assert len(hypotheses) > 0
    assert all(h.status == HYPOTHESIS_UNTESTED for h in hypotheses)


def test_structural_hypothesis_no_broker():
    g = MoneyFlowGraph()
    g.add_node("Buyer", "PAYER")
    g.add_node("Seller", "PROVIDER")
    g.add_edge("Buyer", "Seller", "PAYS")
    gen = HypothesisGenerator()
    hypotheses = gen.generate(g, "compliance", cycle=0)
    statements = [h.statement for h in hypotheses]
    assert any("broker" in s.lower() for s in statements)


# --- Test SearchDirector ---

def test_search_director_plans():
    g = MoneyFlowGraph()
    g.add_hypothesis("test", "test query", priority=0.9)
    g.add_hypothesis("test2", "test query 2", priority=0.5)
    sd = SearchDirector(research_fn=mock_research)
    tasks = sd.plan_searches(g, cycle=0)
    assert len(tasks) == 2
    assert tasks[0].priority >= tasks[1].priority


def test_search_director_budget():
    sd = SearchDirector(research_fn=mock_research)
    assert sd.budget_remaining == 12
    g = MoneyFlowGraph()
    for i in range(15):
        g.add_hypothesis(f"h{i}", f"q{i}", priority=0.5)
    tasks = sd.plan_searches(g, cycle=0)
    assert len(tasks) <= 3  # MAX_TESTS_PER_CYCLE


def test_search_director_executes():
    sd = SearchDirector(research_fn=mock_research)
    g = MoneyFlowGraph()
    g.add_hypothesis("test", "GDPR providers list", priority=0.5)
    tasks = sd.plan_searches(g, cycle=0)
    results = sd.execute(tasks)
    assert len(results) == 1
    assert results[0].success
    assert results[0].content_length > 50


# --- Test GraphUpdater ---

def test_graph_updater_confirms():
    g = MoneyFlowGraph()
    h = g.add_hypothesis("DataGuard exists", "DataGuard GmbH revenue", priority=0.8)
    updater = GraphUpdater()
    changes = updater.update_from_result(g, h, MOCK_RESPONSES["verify"])
    assert h.status == HYPOTHESIS_CONFIRMED
    assert changes["nodes_added"] >= 0 or changes["entities_found"] >= 0


def test_graph_updater_empty_response():
    g = MoneyFlowGraph()
    h = g.add_hypothesis("test", "test", priority=0.5)
    updater = GraphUpdater()
    changes = updater.update_from_result(g, h, "")
    assert h.status == "INCONCLUSIVE"


# --- Test CompletionJudge ---

def test_judge_continues_when_insufficient():
    g = MoneyFlowGraph()
    g.add_node("A", "PAYER")
    g.add_hypothesis("test", "test")
    judge = CompletionJudge()
    v = judge.judge(g, cycle=1, budget_remaining=10)
    assert v.verdict == VERDICT_CONTINUE


def test_judge_completes_when_sufficient():
    g = MoneyFlowGraph()
    for i in range(5):
        g.add_node(f"Entity{i}", "PAYER", confidence=0.8)
    for i in range(4):
        g.add_edge(f"Entity{i}", f"Entity{i+1}", "PAYS", confidence=0.8)
    judge = CompletionJudge()
    v = judge.judge(g, cycle=2, budget_remaining=5)
    assert v.verdict == VERDICT_COMPLETE


def test_judge_incomplete_on_budget_exhaustion():
    g = MoneyFlowGraph()
    g.add_node("A", "PAYER")
    judge = CompletionJudge()
    v = judge.judge(g, cycle=1, budget_remaining=0)
    assert v.verdict == VERDICT_INCOMPLETE


# --- Test Full Controller ---

def test_controller_full_run():
    logs = []
    controller = IntelligenceController(
        research_fn=mock_research,
        webfetch_fn=mock_webfetch,
        progress_fn=lambda msg: logs.append(msg),
        max_cycles=3,
    )
    result = controller.run("GDPR compliance for SMEs")
    assert result.cycles_run >= 1
    assert result.total_searches >= 3
    assert len(result.graph.nodes) >= 3
    assert result.final_verdict in ("COMPLETE", "INCOMPLETE", "no_hypotheses", "quality_threshold_met", "no_more_questions", "max_cycles_reached_but_sufficient", "budget_exhausted_but_sufficient", "budget_exhausted", "max_cycles_exhausted", "more_hypotheses_to_test")
    assert len(logs) > 0

    summary = result.summary()
    assert "Intelligence Result" in summary
    assert "nodes" in summary.lower() or "Nodes" in summary


def test_controller_produces_positions():
    controller = IntelligenceController(
        research_fn=mock_research,
        max_cycles=3,
    )
    result = controller.run("GDPR compliance for SMEs")
    d = result.to_dict()
    assert "graph" in d
    assert "bottleneck_positions" in d
    assert "cycle_logs" in d
    assert len(d["cycle_logs"]) >= 1


